/* Flex补充 */
.flex-col { flex-direction: column; }
.flex-start { justify-content: flex-start; }
.flex-end { justify-content: flex-end; }
.flex-around { justify-content: space-around; }
.items-start { align-items: flex-start; }
.items-end { align-items: flex-end; }
.items-center { align-items: center; }
.items-stretch { align-items: stretch; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.justify-around { justify-content: space-around; }
.justify-end { justify-content: flex-end; }
.gap-8 { gap: 8rpx; }
.gap-12 { gap: 12rpx; }
.gap-16 { gap: 16rpx; }
.gap-20 { gap: 20rpx; }
.gap-24 { gap: 24rpx; }

/* 圆角体系 */
.radius-sm { border-radius: 4rpx; }
.radius-md { border-radius: 8rpx; }
.radius-base { border-radius: 12rpx; }
.radius-lg { border-radius: 16rpx; }
.radius-xl { border-radius: 24rpx; }
.radius-round { border-radius: 999rpx; }

/* 阴影体系 */
.shadow-sm { box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06); }
.shadow-md { box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08); }
.shadow-lg { box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12); }

/* 补充文本色 */
.text-tertiary { color: var(--text-color-light); }
.text-placeholder { color: #cccccc; }
.text-dark { color: #1a1a2e; }
.text-danger { color: var(--error-color); }
.text-secondary { color: var(--text-color-secondary); }
.text-white { color: var(--white); }

/* 补充背景色 */
.bg-page { background-color: var(--background-color); }
.bg-card { background-color: var(--white); }
.bg-primary-light { background-color: #e6f7ff; }
.bg-success-light { background-color: #f6ffed; }
.bg-warning-light { background-color: #fffbe6; }
.bg-error-light { background-color: #fff1f0; }

/* 页面容器 */
.page-container {
  padding: 20rpx;
  min-height: 100vh;
  background-color: var(--background-color);
  box-sizing: border-box;
}

/* 安全区域 */
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }

/* 宽度约束（配合ellipsis使用） */
.w-full { width: 100%; }
.w-auto { width: auto; }
.min-w-0 { min-width: 0; }

/* === ds-前缀组件样式类 === */

/* ds-卡片 */
.ds-card {
  background-color: var(--white);
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}
.ds-card-borderless {
  background-color: var(--white);
  border-radius: 16rpx;
  padding: 24rpx;
}
.ds-card-interactive:active {
  background-color: var(--background-color);
}

/* ds-按钮 */
.ds-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}
.ds-btn-primary { background-color: var(--primary-color); color: var(--white); }
.ds-btn-primary:active { background-color: #096dd9; }
.ds-btn-success { background-color: var(--success-color); color: var(--white); }
.ds-btn-warning { background-color: var(--warning-color); color: var(--white); }
.ds-btn-danger { background-color: var(--error-color); color: var(--white); }
.ds-btn-default { background-color: var(--white); color: var(--text-color); border: 2rpx solid var(--border-color); }
.ds-btn-text { background: transparent; color: var(--primary-color); }
.ds-btn-block { width: 100%; display: flex; }
.ds-btn-sm { padding: 8rpx 16rpx; font-size: 24rpx; }
.ds-btn-lg { padding: 24rpx 48rpx; font-size: 32rpx; }

/* ds-标签 */
.ds-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
}
.ds-tag-primary { background-color: #e6f7ff; color: var(--primary-color); }
.ds-tag-success { background-color: #f6ffed; color: var(--success-color); }
.ds-tag-warning { background-color: #fffbe6; color: var(--warning-color); }
.ds-tag-danger { background-color: #fff1f0; color: var(--error-color); }
.ds-tag-default { background-color: #f0f0f0; color: var(--text-color-light); }

/* ds-表单 */
.ds-form-item { margin-bottom: 24rpx; }
.ds-form-label { display: block; font-size: 28rpx; color: var(--text-color); margin-bottom: 12rpx; font-weight: 500; }
.ds-form-input { width: 100%; padding: 16rpx 20rpx; border: 2rpx solid var(--border-color); border-radius: 8rpx; font-size: 28rpx; color: var(--text-color); background-color: var(--white); box-sizing: border-box; }

/* ds-列表 */
.ds-list { background-color: var(--white); border-radius: 16rpx; overflow: hidden; }
.ds-list-item { padding: 24rpx; border-bottom: 2rpx solid var(--border-color); display: flex; align-items: center; }
.ds-list-item:last-child { border-bottom: none; }
.ds-list-title { font-size: 28rpx; color: var(--text-color); font-weight: 500; }
.ds-list-desc { font-size: 24rpx; color: var(--text-color-secondary); }
.ds-list-extra { font-size: 24rpx; color: var(--text-color-light); }
