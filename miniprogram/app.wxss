/* app.wxss - 全局样式 */
@import './styles/tdesign.wxss';

/* 全局变量 */
page {
  --primary-color: #1890ff;
  --success-color: #52c41a;
  --warning-color: #faad14;
  --error-color: #f5222d;
  --text-color: #333333;
  --text-color-secondary: #666666;
  --text-color-light: #999999;
  --border-color: #e8e8e8;
  --background-color: #f5f5f5;
  --white: #ffffff;
  --font-size-base: 28rpx;
  
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
  font-size: var(--font-size-base);
  color: var(--text-color);
  background-color: var(--background-color);
  box-sizing: border-box;
}

/* 通用容器 */
.container {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 卡片样式 */
.card {
  background-color: var(--white);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.card-title::before {
  content: '';
  width: 6rpx;
  height: 32rpx;
  background-color: var(--primary-color);
  margin-right: 16rpx;
  border-radius: 3rpx;
}

/* 按钮样式 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.3s;
  border: none;
  outline: none;
}

.btn-primary {
  background-color: var(--primary-color);
  color: var(--white);
}

.btn-primary:active {
  background-color: #096dd9;
}

.btn-success {
  background-color: var(--success-color);
  color: var(--white);
}

.btn-warning {
  background-color: var(--warning-color);
  color: var(--white);
}

.btn-error {
  background-color: var(--error-color);
  color: var(--white);
}

.btn-default {
  background-color: var(--white);
  color: var(--text-color);
  border: 2rpx solid var(--border-color);
}

.btn-block {
  width: 100%;
  display: flex;
}

.btn-small {
  padding: 8rpx 16rpx;
  font-size: 24rpx;
}

.btn-large {
  padding: 24rpx 48rpx;
  font-size: 32rpx;
}

/* 表单样式 */
.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-color);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 8rpx;
  font-size: 28rpx;
  color: var(--text-color);
  background-color: var(--white);
  box-sizing: border-box;
}

.form-input:focus {
  border-color: var(--primary-color);
  outline: none;
}

.form-textarea {
  min-height: 200rpx;
}

.form-picker {
  width: 100%;
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 8rpx;
  font-size: 28rpx;
  color: var(--text-color);
  background-color: var(--white);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 列表样式 */
.list {
  background-color: var(--white);
  border-radius: 16rpx;
  overflow: hidden;
}

.list-item {
  padding: 32rpx;
  border-bottom: 2rpx solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: background-color 0.3s;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item:active {
  background-color: #f5f5f5;
}

.list-item-content {
  flex: 1;
}

.list-item-title {
  font-size: 30rpx;
  color: var(--text-color);
  margin-bottom: 8rpx;
  font-weight: 500;
}

.list-item-desc {
  font-size: 26rpx;
  color: var(--text-color-secondary);
}

.list-item-extra {
  font-size: 26rpx;
  color: var(--text-color-light);
  margin-left: 16rpx;
}

/* 标签样式 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
  margin-right: 8rpx;
}

.tag-primary {
  background-color: #e6f7ff;
  color: var(--primary-color);
}

.tag-success {
  background-color: #f6ffed;
  color: var(--success-color);
}

.tag-warning {
  background-color: #fffbe6;
  color: var(--warning-color);
}

.tag-error {
  background-color: #fff1f0;
  color: var(--error-color);
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-color-light);
}

/* 加载状态 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: var(--text-color-light);
  margin-left: 16rpx;
}

/* 分割线 */
.divider {
  height: 2rpx;
  background-color: var(--border-color);
  margin: 32rpx 0;
}

/* 徽章 */
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background-color: var(--error-color);
  color: var(--white);
  font-size: 20rpx;
  font-weight: 600;
}

/* 头像 */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: var(--border-color);
}

.avatar-large {
  width: 120rpx;
  height: 120rpx;
}

.avatar-small {
  width: 48rpx;
  height: 48rpx;
}

/* 网格布局 */
.grid {
  display: flex;
  flex-wrap: wrap;
}

.grid-item {
  flex: 1;
  min-width: 25%;
  max-width: 25%;
  padding: 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.grid-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
}

.grid-text {
  font-size: 26rpx;
  color: var(--text-color);
  text-align: center;
}

/* 统计卡片 */
.stat-card {
  background: linear-gradient(135deg, var(--primary-color) 0%, #096dd9 100%);
  border-radius: 16rpx;
  padding: 32rpx;
  color: var(--white);
  margin-bottom: 24rpx;
}

.stat-title {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 16rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.stat-desc {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 工具类 */
.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.text-primary {
  color: var(--primary-color);
}

.text-success {
  color: var(--success-color);
}

.text-warning {
  color: var(--warning-color);
}

.text-error {
  color: var(--error-color);
}

.text-light {
  color: var(--text-color-light);
}

.text-bold {
  font-weight: 600;
}

.mt-8 {
  margin-top: 8rpx;
}

.mt-16 {
  margin-top: 16rpx;
}

.mt-24 {
  margin-top: 24rpx;
}

.mb-8 {
  margin-bottom: 8rpx;
}

.mb-16 {
  margin-bottom: 16rpx;
}

.mb-24 {
  margin-bottom: 24rpx;
}

.p-16 {
  padding: 16rpx;
}

.p-24 {
  padding: 24rpx;
}

.flex {
  display: flex;
}

.flex-column {
  flex-direction: column;
}

.flex-center {
  align-items: center;
  justify-content: center;
}

.flex-between {
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

/* === Design System 补充样式 === */

/* 字号体系 */
.fs-xxs { font-size: 22rpx; }
.fs-xs { font-size: 24rpx; }
.fs-sm { font-size: 26rpx; }
.fs-base { font-size: 28rpx; }
.fs-md { font-size: 30rpx; }
.fs-lg { font-size: 32rpx; }
.fs-xl { font-size: 36rpx; }
.fs-xxl { font-size: 40rpx; }
.fs-h1 { font-size: 40rpx; }
.fs-h2 { font-size: 36rpx; }
.fs-h3 { font-size: 32rpx; }
.fs-h4 { font-size: 30rpx; }

/* 文本溢出 */
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ellipsis-2 {
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.ellipsis-3 {
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

