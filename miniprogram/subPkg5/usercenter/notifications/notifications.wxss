/* pages/usercenter/notifications/notifications.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #1890ff;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #1890ff;
  border-radius: 2rpx;
}

.filter-bar {
  background: #fff;
  padding: 16rpx 24rpx;
}

.type-filter {
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.type-item {
  display: inline-block;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 24rpx;
  margin-right: 12rpx;
}

.type-item.active {
  background: #e6f7ff;
  color: #1890ff;
  border: 1rpx solid #1890ff;
}

.read-filter {
  display: flex;
  gap: 16rpx;
}

.read-item {
  font-size: 24rpx;
  color: #999;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.read-item.active {
  color: #1890ff;
  background: #e6f7ff;
}

.action-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
}

.action-text {
  font-size: 24rpx;
  color: #999;
}

.action-link {
  font-size: 24rpx;
  color: #1890ff;
}

.notification-list {
  padding: 0 24rpx;
}

.notification-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  position: relative;
  overflow: hidden;
}

.notification-card.unread {
  border-left: 6rpx solid #1890ff;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.card-type {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.type-icon {
  font-size: 28rpx;
}

.type-label {
  font-size: 24rpx;
  font-weight: 500;
}

.card-time {
  font-size: 22rpx;
  color: #999;
}

.card-body {
  margin-bottom: 12rpx;
}

.card-title {
  display: block;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.card-summary {
  display: block;
  font-size: 26rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-sender {
  font-size: 22rpx;
  color: #999;
}

.card-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action-star {
  font-size: 32rpx;
  color: #d9d9d9;
}

.action-star.starred {
  color: #faad14;
}

.action-read {
  font-size: 22rpx;
  color: #1890ff;
}

.unread-dot {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 16rpx;
  height: 16rpx;
  background: #ff4d4f;
  border-radius: 50%;
}

.published-list {
  padding: 0 24rpx;
}

.published-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.status-tag.published {
  background: #f6ffed;
  color: #52c41a;
}

.status-tag.recalled {
  background: #fff1f0;
  color: #ff4d4f;
}

.action-recall {
  font-size: 22rpx;
  color: #ff4d4f;
}

.publish-entry {
  padding: 16rpx 24rpx;
}

.publish-btn {
  background: #1890ff;
  color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.publish-btn::after {
  border: none;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.modal-content {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 85vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx;
}

.modal-body {
  padding: 24rpx 32rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-picker {
  padding: 16rpx 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.form-input {
  padding: 16rpx 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.form-textarea {
  width: 100%;
  padding: 16rpx 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  min-height: 200rpx;
  box-sizing: border-box;
}

.priority-options {
  display: flex;
  gap: 16rpx;
}

.priority-item {
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  border: 1rpx solid #e8e8e8;
}

.priority-item.active {
  background: #e6f7ff;
  color: #1890ff;
  border-color: #1890ff;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #f0f0f0;
}

.modal-cancel {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: #f5f5f5;
  color: #666;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.modal-cancel::after { border: none; }

.modal-confirm {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.modal-confirm::after { border: none; }

.loading-more {
  text-align: center;
  padding: 20rpx;
  font-size: 24rpx;
  color: #999;
}
