.trend-warning-page { padding: 20rpx; }
.page-header { margin-bottom: 20rpx; }
.page-title { font-size: 36rpx; font-weight: 700; }
.loading-wrap { text-align: center; padding: 100rpx 0; color: #999; }
.stats-bar { display: flex; gap: 24rpx; margin-bottom: 20rpx; padding: 16rpx; background: #f8f9fa; border-radius: 12rpx; }
.stat { font-size: 26rpx; color: #F44336; }
.stat.yellow { color: #FF9800; }
.stat.green { color: #4CAF50; }
.warning-list { margin-bottom: 20rpx; }
.warning-item { background: #fff; border-radius: 12rpx; padding: 20rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05); border-left: 6rpx solid #ccc; }
.warning-item.red { border-left-color: #F44336; }
.warning-item.yellow { border-left-color: #FF9800; }
.warning-item.green { border-left-color: #4CAF50; }
.warning-header { display: flex; justify-content: space-between; margin-bottom: 8rpx; }
.warning-type { font-size: 28rpx; font-weight: 600; }
.warning-level { font-size: 24rpx; padding: 4rpx 12rpx; border-radius: 6rpx; }
.warning-level.red { background: #ffebee; color: #F44336; }
.warning-level.yellow { background: #fff8e1; color: #FF9800; }
.warning-label { font-size: 26rpx; color: #666; display: block; margin-bottom: 4rpx; }
.warning-student { font-size: 24rpx; color: #999; display: block; }
.warning-actions { display: flex; gap: 16rpx; margin-top: 12rpx; }
.action-btn { padding: 8rpx 20rpx; background: #4CAF50; color: #fff; border-radius: 8rpx; font-size: 24rpx; }
.action-btn.ignore { background: #999; }
.empty-text { text-align: center; color: #999; padding: 60rpx 0; display: block; }
.detect-btn { text-align: center; padding: 20rpx; background: #2196F3; color: #fff; border-radius: 12rpx; font-size: 28rpx; }
