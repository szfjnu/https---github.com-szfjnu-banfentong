.deep-analysis-page { padding: 20rpx; }
.page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.page-title { font-size: 36rpx; font-weight: 700; }
.refresh-btn { color: #4CAF50; font-size: 28rpx; }
.loading-wrap { text-align: center; padding: 100rpx 0; color: #999; }
.analysis-section { background: #fff; border-radius: 12rpx; padding: 20rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05); }
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 12rpx; display: block; }
.trend-item { display: flex; gap: 12rpx; align-items: center; margin-bottom: 8rpx; }
.trend-dim { font-size: 26rpx; color: #666; }
.trend-dir { font-size: 26rpx; font-weight: 600; }
.trend-dir.up { color: #4CAF50; }
.trend-dir.down { color: #F44336; }
.trend-dir.stable { color: #FF9800; }
.trend-rate { font-size: 24rpx; color: #999; }
.corr-item { font-size: 26rpx; color: #333; margin-bottom: 8rpx; }
.empty-sm { font-size: 24rpx; color: #999; }
.cluster-desc { font-size: 28rpx; color: #333; }
