.personal-page { padding: 20rpx; }
.page-header { margin-bottom: 20rpx; }
.page-title { font-size: 36rpx; font-weight: 700; }
.loading-wrap { text-align: center; padding: 100rpx 0; color: #999; }
.radar-placeholder { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; text-align: center; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05); }
.placeholder-text { font-size: 28rpx; color: #999; display: block; margin-bottom: 16rpx; }
.radar-values { display: flex; flex-wrap: wrap; gap: 12rpx; }
.radar-item { display: flex; align-items: center; gap: 8rpx; padding: 6rpx 16rpx; background: #f8f9fa; border-radius: 8rpx; }
.radar-dim { font-size: 24rpx; color: #666; }
.radar-val { font-size: 26rpx; font-weight: 600; color: #333; }
.dimension-cards { margin-bottom: 24rpx; }
.dim-card { background: #fff; border-radius: 12rpx; padding: 20rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05); }
.dim-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.dim-name { font-size: 30rpx; font-weight: 600; }
.dim-trend { font-size: 32rpx; font-weight: 700; }
.dim-trend.up { color: #4CAF50; }
.dim-trend.down { color: #F44336; }
.dim-trend.stable { color: #FF9800; }
.dim-kpi { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 8rpx; }
.kpi-item { font-size: 24rpx; color: #666; padding: 4rpx 12rpx; background: #f5f5f5; border-radius: 6rpx; }
.dim-count { font-size: 22rpx; color: #999; }
.action-row { display: flex; gap: 16rpx; }
.action-btn { flex: 1; text-align: center; padding: 20rpx; background: #4CAF50; color: #fff; border-radius: 12rpx; font-size: 28rpx; }
.action-btn.outline { background: #fff; color: #4CAF50; border: 2rpx solid #4CAF50; }
