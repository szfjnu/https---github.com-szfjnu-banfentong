.dev-advice-page { padding: 20rpx; }
.page-header { margin-bottom: 20rpx; }
.page-title { font-size: 36rpx; font-weight: 700; }
.loading-wrap { text-align: center; padding: 100rpx 0; color: #999; }
.advice-card { background: #fff; border-radius: 16rpx; padding: 24rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05); margin-bottom: 24rpx; }
.advice-meta { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.ai-tag { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 6rpx; }
.ai-tag.ai { background: #e3f2fd; color: #1976d2; }
.ai-tag.fallback { background: #f5f5f5; color: #999; }
.advice-content { font-size: 28rpx; line-height: 1.8; color: #333; white-space: pre-wrap; }
.empty-text { text-align: center; color: #999; padding: 60rpx 0; }
.generate-btn { text-align: center; padding: 20rpx; background: #4CAF50; color: #fff; border-radius: 12rpx; font-size: 28rpx; }
