.module-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.module-header {
  margin-bottom: 16rpx;
}

.module-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.dimension-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.dim-tab {
  padding: 10rpx 24rpx;
  border: 1rpx solid #ddd;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #666;
}

.dim-tab.active {
  background: #667eea;
  color: #fff;
  border-color: #667eea;
}

.kpi-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.kpi-card {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
}

.kpi-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #667eea;
}

.kpi-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.kpi-trend {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.kpi-trend.up {
  color: #52c41a;
}

.kpi-trend.down {
  color: #ff4d4f;
}

.trend-chart {
  margin-bottom: 16rpx;
}

.chart-canvas {
  width: 100%;
  height: 400rpx;
}

.grade-rank {
  margin-top: 16rpx;
}

.rank-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.rank-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.rank-pos {
  width: 40rpx;
  font-size: 26rpx;
  color: #667eea;
  font-weight: bold;
}

.rank-name {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.rank-score {
  font-size: 26rpx;
  color: #666;
}

.role-actions {
  margin-top: 16rpx;
}

.action-link {
  font-size: 26rpx;
  color: #667eea;
}

.loading-wrap {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty-tip {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #999;
}