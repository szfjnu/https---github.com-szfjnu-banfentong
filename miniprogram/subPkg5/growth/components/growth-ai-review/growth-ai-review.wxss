.module-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.module-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.module-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.published-tag {
  font-size: 22rpx;
  color: #52c41a;
  background: #f6ffed;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
}

.period-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.period-tab {
  padding: 10rpx 24rpx;
  border: 1rpx solid #ddd;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #666;
}

.period-tab.active {
  background: #667eea;
  color: #fff;
  border-color: #667eea;
}

.summary-card {
  padding: 20rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  border-left: 6rpx solid #667eea;
}

.summary-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
}

.summary-edit {
  margin-bottom: 16rpx;
}

.summary-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  box-sizing: border-box;
}

.edit-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 12rpx;
}

.edit-btn {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
}

.edit-btn.cancel {
  background: #f5f7fa;
  color: #666;
}

.edit-btn.save {
  background: #667eea;
  color: #fff;
}

.dimension-scores {
  margin-bottom: 16rpx;
}

.sub-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.dimension-item {
  margin-bottom: 12rpx;
}

.dimension-name-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 4rpx;
}

.dimension-name {
  font-size: 26rpx;
  color: #666;
}

.dimension-score-val {
  font-size: 26rpx;
  color: #667eea;
  font-weight: bold;
}

.progress-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.3s;
}

.highlights-suggestions {
  margin-bottom: 16rpx;
}

.highlight-section,
.suggestion-section {
  margin-bottom: 12rpx;
}

.highlight-item,
.suggestion-item {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.highlight-dot {
  color: #52c41a;
  font-size: 20rpx;
  line-height: 1.8;
}

.highlight-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.8;
}

.suggestion-dot {
  color: #faad14;
  font-size: 20rpx;
  line-height: 1.8;
}

.suggestion-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.8;
}

.action-bar {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.action-btn {
  flex: 1;
  padding: 16rpx;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
}

.action-btn.regenerate {
  background: #667eea;
  color: #fff;
}

.action-btn.regenerate.disabled {
  opacity: 0.5;
}

.action-btn.edit {
  background: #fff;
  border: 1rpx solid #667eea;
  color: #667eea;
}

.action-btn.publish {
  background: #fff;
  border: 1rpx solid #52c41a;
  color: #52c41a;
}

.loading-wrap {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 28rpx;
}