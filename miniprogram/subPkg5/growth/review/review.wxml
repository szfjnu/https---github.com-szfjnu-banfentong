<view class="review-page">
  <view class="page-header">
    <text class="page-title">智能评语</text>
    <view class="batch-btn" wx:if="{{canManage && !batchLoading}}" bindtap="onBatchGenerate"><text>批量生成</text></view>
  </view>
  <view wx:if="{{loading}}" class="loading-wrap"><text>加载中...</text></view>
  <block wx:else>
    <view class="review-item" wx:for="{{reviews}}" wx:key="_id">
      <view class="review-meta">
        <text class="student-name">{{item.student_name}}</text>
        <text class="ai-tag {{item.generated_by_ai ? 'ai' : 'fallback'}}">{{item.generated_by_ai ? 'AI' : '模板'}}</text>
        <text class="confirm-tag" wx:if="{{item.is_confirmed}}">已确认</text>
      </view>
      <text class="review-content">{{item.content}}</text>
      <view class="review-actions" wx:if="{{canManage && !item.is_confirmed}}">
        <text class="action-btn" data-id="{{item._id}}" bindtap="onConfirmReview">确认</text>
      </view>
    </view>
    <text wx:if="{{reviews.length === 0}}" class="empty-text">暂无评语</text>
  </block>
</view>
