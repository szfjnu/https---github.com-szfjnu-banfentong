.review-page { padding: 20rpx; }
.page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.page-title { font-size: 36rpx; font-weight: 700; }
.batch-btn { padding: 10rpx 24rpx; background: #4CAF50; color: #fff; border-radius: 8rpx; font-size: 26rpx; }
.loading-wrap { text-align: center; padding: 100rpx 0; color: #999; }
.review-item { background: #fff; border-radius: 12rpx; padding: 20rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05); }
.review-meta { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.student-name { font-size: 28rpx; font-weight: 600; }
.ai-tag { font-size: 22rpx; padding: 4rpx 8rpx; border-radius: 6rpx; }
.ai-tag.ai { background: #e3f2fd; color: #1976d2; }
.ai-tag.fallback { background: #f5f5f5; color: #999; }
.confirm-tag { font-size: 22rpx; padding: 4rpx 8rpx; border-radius: 6rpx; background: #e8f5e9; color: #4CAF50; }
.review-content { font-size: 26rpx; line-height: 1.8; color: #333; white-space: pre-wrap; }
.review-actions { margin-top: 12rpx; }
.action-btn { padding: 8rpx 20rpx; background: #4CAF50; color: #fff; border-radius: 8rpx; font-size: 24rpx; }
.empty-text { text-align: center; color: #999; padding: 60rpx 0; display: block; }
