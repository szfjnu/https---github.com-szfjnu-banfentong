<view class="dashboard-page">
  <view class="page-header">
    <text class="page-title">班级成长中心</text>
    <view class="header-actions">
      <text class="action-link" bindtap="onGoPersonal">我的成长</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-wrap">
    <text>加载中...</text>
  </view>

  <block wx:else>
    <!-- KPI卡片 -->
    <view class="kpi-section">
      <view class="kpi-card">
        <text class="kpi-label">班级均分</text>
        <text class="kpi-value">{{kpi.grade.avg_score || 'N/A'}}</text>
      </view>
      <view class="kpi-card">
        <text class="kpi-label">预警人数</text>
        <text class="kpi-value warning">{{warningSummary.total}}</text>
      </view>
      <view class="kpi-card">
        <text class="kpi-label">优良率</text>
        <text class="kpi-value">{{kpi.grade.pass_rate || 'N/A'}}%</text>
      </view>
      <view class="kpi-card">
        <text class="kpi-label">总积分</text>
        <text class="kpi-value">{{kpi.score.total_score || 0}}</text>
      </view>
    </view>

    <!-- 预警摘要 -->
    <view class="warning-summary" bindtap="onGoTrendWarning">
      <text class="section-title">预警概况</text>
      <view class="warning-badges">
        <view class="badge red" wx:if="{{warningSummary.red > 0}}">{{warningSummary.red}}红色</view>
        <view class="badge yellow" wx:if="{{warningSummary.yellow > 0}}">{{warningSummary.yellow}}黄色</view>
        <view class="badge green" wx:if="{{warningSummary.green > 0}}">{{warningSummary.green}}绿色</view>
        <text wx:if="{{warningSummary.total === 0}}" class="no-warning">暂无预警</text>
      </view>
    </view>

    <!-- 维度切换 -->
    <view class="dimension-tabs">
      <view class="dim-tab {{currentDimension === item.key ? 'active' : ''}}"
        wx:for="{{dimensions}}" wx:key="key"
        data-key="{{item.key}}" bindtap="onDimensionChange">
        <text>{{item.name}}</text>
      </view>
    </view>

    <!-- 维度趋势 -->
    <view class="trend-section">
      <text class="section-title">趋势概览</text>
      <view wx:if="{{dimensionTrend}}" class="trend-info">
        <text class="trend-direction {{dimensionTrend.trend.direction}}">{{dimensionTrend.trend.direction === 'up' ? '上升' : (dimensionTrend.trend.direction === 'down' ? '下降' : '稳定')}}</text>
        <text class="trend-rate">速率: {{dimensionTrend.trend.rate}}</text>
      </view>
    </view>

    <!-- 快捷入口 -->
    <view class="quick-actions">
      <view class="action-card" bindtap="onGoTrendWarning">
        <text class="action-icon">📊</text>
        <text class="action-name">趋势与预警</text>
      </view>
      <view class="action-card" bindtap="onGoAIAdvice" wx:if="{{canGenerateAdvice}}">
        <text class="action-icon">🤖</text>
        <text class="action-name">AI管理建议</text>
      </view>
      <view class="action-card" bindtap="onGoReview" wx:if="{{canGenerateAdvice}}">
        <text class="action-icon">📝</text>
        <text class="action-name">智能评语</text>
      </view>
      <view class="action-card" bindtap="onGoPersonal">
        <text class="action-icon">👤</text>
        <text class="action-name">个人成长</text>
      </view>
    </view>
  </block>
</view>
