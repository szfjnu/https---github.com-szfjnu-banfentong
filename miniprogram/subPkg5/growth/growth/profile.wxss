.growth-page {
  padding: 20rpx 30rpx;
  min-height: 100vh;
  background: #f5f7fa;
}

.loading-wrap {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

.no-class-tip {
  text-align: center;
  padding: 120rpx 40rpx;
}

.no-class-text {
  font-size: 28rpx;
  color: #999;
}

.class-picker {
  padding: 20rpx 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.class-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.class-name {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.class-role {
  font-size: 24rpx;
  color: #667eea;
  background: #f0f3ff;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.class-info-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  border-radius: 12rpx;
}

.current-class {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.current-role {
  font-size: 24rpx;
  color: #667eea;
  background: #f0f3ff;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.bottom-bar {
  margin-top: 20rpx;
  display: flex;
  gap: 20rpx;
}

.bottom-btn {
  flex: 1;
  padding: 20rpx;
  background: #fff;
  border: 1rpx solid #667eea;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: #667eea;
}