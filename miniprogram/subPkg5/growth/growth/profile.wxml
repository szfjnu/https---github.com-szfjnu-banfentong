<wxs module="checkHelper" src="./checkHelper.wxs" />
<view class="growth-page">
  <view class="loading-wrap" wx:if="{{classLoading}}">
    <text>加载班级信息...</text>
  </view>

  <view class="no-class-tip" wx:elif="{{noClass}}">
    <text class="no-class-text">未加入班级，请联系班主任添加</text>
  </view>

  <view class="class-picker" wx:elif="{{showClassPicker}}">
    <view class="section-title">请选择班级</view>
    <view class="class-item" wx:for="{{classList}}" wx:key="class_id" bindtap="onClassSelect" data-index="{{index}}">
      <text class="class-name">{{item.class_name}}</text>
      <text class="class-role">{{item.role}}</text>
    </view>
  </view>

  <view class="student-picker" wx:elif="{{showStudentPicker}}">
    <view class="section-title">选择学生查看成长档案</view>
    <text class="student-count">{{className}} 共{{studentCount}}名学生</text>
    <view class="student-item" wx:for="{{classListStudents}}" wx:key="student_id" bindtap="onStudentPick" data-sid="{{item.student_id}}">
      <text class="student-name">{{item.student_name}}</text>
    </view>
  </view>

  <view class="loading-wrap" wx:elif="{{loading}}">
    <text>加载成长档案...</text>
  </view>

  <block wx:if="{{!classLoading && !noClass && !showClassPicker && !showStudentPicker && !loading}}">
    <view class="tab-bar">
      <view class="tab-item {{selectedTab === 'overview' ? 'active' : ''}}" bindtap="onTabChange" data-tab="overview">总览</view>
      <view class="tab-item {{selectedTab === 'report' ? 'active' : ''}}" bindtap="onTabChange" data-tab="report">成长报告</view>
      <view class="tab-item {{selectedTab === 'comment' ? 'active' : ''}}" bindtap="onTabChange" data-tab="comment" wx:if="{{canWrite}}">评语</view>
      <view class="tab-item {{selectedTab === 'warning' ? 'active' : ''}}" bindtap="onTabChange" data-tab="warning" wx:if="{{canWrite}}">预警</view>
      <view class="tab-item {{selectedTab === 'rec' ? 'active' : ''}}" bindtap="onTabChange" data-tab="rec">推荐</view>
    </view>

    <!-- 总览Tab -->
    <block wx:if="{{selectedTab === 'overview'}}">
      <view class="section" wx:if="{{chartOption}}">
        <view class="section-title">成绩趋势</view>
        <ec-canvas id="gradeChart" ec="{{ec}}" class="chart-canvas" />
      </view>

      <view class="section" wx:if="{{scoreSummary}}">
        <view class="section-title">积分概况</view>
        <view class="stat-row">
          <view class="stat-item">
            <text class="stat-value">{{scoreSummary.total}}</text>
            <text class="stat-label">总积分</text>
          </view>
          <view class="stat-item">
            <text class="stat-value">{{scoreSummary.count}}</text>
            <text class="stat-label">记录数</text>
          </view>
        </view>
      </view>

      <view class="section score-trend-section" wx:if="{{scoreTrendOption}}">
        <view class="section-title">积分趋势</view>
        <ec-canvas id="scoreTrendChart" ec="{{scoreTrendEc}}" class="score-trend-chart" />
      </view>

      <view class="section" wx:if="{{!scoreTrendOption && scoreSummary && scoreSummary.count > 0}}">
        <view class="section-title">积分趋势</view>
        <view class="empty-tip"><text>暂无积分趋势数据</text></view>
      </view>

      <view class="section" wx:if="{{attendanceSummary}}">
        <view class="section-title">出勤概况</view>
        <view class="stat-row">
          <view class="stat-item">
            <text class="stat-value">{{attendanceSummary.total}}</text>
            <text class="stat-label">总记录</text>
          </view>
          <view class="stat-item">
            <text class="stat-value">{{attendanceSummary.absent}}</text>
            <text class="stat-label">缺勤</text>
          </view>
          <view class="stat-item">
            <text class="stat-value">{{attendanceSummary.late}}</text>
            <text class="stat-label">迟到</text>
          </view>
        </view>
      </view>

      <view class="section" wx:if="{{volunteerInfo}}">
        <view class="section-title">志愿服务</view>
        <view class="stat-row">
          <view class="stat-item">
            <text class="stat-value">{{volunteerInfo.hours}}h</text>
            <text class="stat-label">服务时长</text>
          </view>
          <view class="stat-item">
            <text class="stat-value">{{volunteerInfo.count}}</text>
            <text class="stat-label">参与次数</text>
          </view>
        </view>
      </view>

      <view class="section" wx:if="{{disciplineList.length > 0}}">
        <view class="section-title">处分记录</view>
        <view class="list-item" wx:for="{{disciplineList}}" wx:key="index">
          <text class="list-level">{{item.level}}</text>
          <text class="list-reason">{{item.reason}}</text>
        </view>
      </view>

      <view class="section" wx:if="{{certList.length > 0}}">
        <view class="section-title">证书</view>
        <view class="list-item" wx:for="{{certList}}" wx:key="index">
          <text class="list-name">{{item.name}}</text>
        </view>
      </view>

      <view class="section ai-section" wx:if="{{aiSummary}}">
        <view class="section-title">AI成长摘要</view>
        <text class="ai-text">{{aiSummary}}</text>
      </view>

      <view class="action-bar" wx:if="{{canWrite}}">
        <view class="action-btn" bindtap="loadClassSummary">班级汇总</view>
      </view>
    </block>

    <!-- 报告Tab -->
    <block wx:if="{{selectedTab === 'report'}}">
      <view class="section">
        <view class="section-title">成长分析报告</view>
        <view class="student-check-list" wx:if="{{classListStudents.length > 0}}">
          <view class="check-actions">
            <view class="check-action-btn" bindtap="onCheckAllStudents">全选</view>
            <view class="check-action-btn" bindtap="onClearCheckAll">取消全选</view>
            <text class="checked-count">已选{{checkedStudentIds.length}}人</text>
          </view>
          <view class="student-check-item" wx:for="{{classListStudents}}" wx:key="student_id" bindtap="onStudentCheckToggle" data-sid="{{item.student_id}}">
            <view class="check-box {{checkHelper.isChecked(checkedStudentIds, item.student_id) ? 'checked' : ''}}"></view>
            <text class="check-name">{{item.student_name || item.name}}</text>
          </view>
        </view>
        <view class="generate-btn {{generatingReport ? 'disabled' : ''}} {{checkedStudentIds.length === 0 ? 'disabled' : ''}}" bindtap="generateReport" wx:if="{{canWrite}}">
          <text>{{generatingReport ? 'AI分析中...' : '生成成长报告'}}</text>
        </view>
        <view class="batch-results" wx:if="{{batchReportResults.length > 0}}">
          <view class="batch-result-item {{item.success ? '' : 'batch-result-fail'}}" wx:for="{{batchReportResults}}" wx:key="student_id">
            <view class="batch-result-header">
              <text class="batch-result-name">{{item.student_name}}</text>
              <text class="batch-result-status {{item.success ? 'success' : 'fail'}}">{{item.success ? '生成成功' : item.error}}</text>
            </view>
            <text class="batch-result-content" wx:if="{{item.success && item.content}}">{{item.content}}</text>
          </view>
        </view>
        <block wx:if="{{reportSections.length > 0 && batchReportResults.length === 0}}">
          <block wx:for="{{reportSections}}" wx:key="index">
            <view class="report-text-block" wx:if="{{item.type === 'text'}}">
              <text>{{item.content}}</text>
            </view>
            <view class="report-chart-block" wx:elif="{{item.type === 'chart'}}">
              <text class="chart-placeholder">[图表: {{item.chartType}}]</text>
            </view>
          </block>
        </block>
        <view class="empty-tip" wx:elif="{{!generatingReport && batchReportResults.length === 0}}">
          <text>{{canWrite ? '请勾选学生后点击生成报告' : '暂无成长报告'}}</text>
        </view>
      </view>
    </block>

    <!-- 评语Tab -->
    <block wx:if="{{selectedTab === 'comment' && canWrite}}">
      <view class="section">
        <view class="section-title">智能评语生成</view>
        <view class="student-check-list" wx:if="{{classListStudents.length > 0}}">
          <view class="check-actions">
            <view class="check-action-btn" bindtap="onCheckAllStudents">全选</view>
            <view class="check-action-btn" bindtap="onClearCheckAll">取消全选</view>
            <text class="checked-count">已选{{checkedStudentIds.length}}人</text>
          </view>
          <view class="student-check-item" wx:for="{{classListStudents}}" wx:key="student_id" bindtap="onStudentCheckToggle" data-sid="{{item.student_id}}">
            <view class="check-box {{checkHelper.isChecked(checkedStudentIds, item.student_id) ? 'checked' : ''}}"></view>
            <text class="check-name">{{item.student_name || item.name}}</text>
          </view>
        </view>
        <view class="style-selector">
          <view class="style-btn {{commentStyle === 'encouraging' ? 'active' : ''}}" bindtap="onCommentStyleChange" data-style="encouraging">鼓励型</view>
          <view class="style-btn {{commentStyle === 'objective' ? 'active' : ''}}" bindtap="onCommentStyleChange" data-style="objective">客观型</view>
          <view class="style-btn {{commentStyle === 'strict' ? 'active' : ''}}" bindtap="onCommentStyleChange" data-style="strict">严谨型</view>
        </view>
        <view class="generate-btn {{generatingComment ? 'disabled' : ''}} {{checkedStudentIds.length === 0 ? 'disabled' : ''}}" bindtap="generateComment">
          <text>{{generatingComment ? 'AI生成中...' : '生成评语'}}</text>
        </view>
        <view class="batch-results" wx:if="{{batchCommentResults.length > 0}}">
          <view class="batch-result-item {{item.success ? '' : 'batch-result-fail'}}" wx:for="{{batchCommentResults}}" wx:key="student_id">
            <view class="batch-result-header">
              <text class="batch-result-name">{{item.student_name}}</text>
              <text class="batch-result-status {{item.success ? 'success' : 'fail'}}">{{item.success ? '生成成功' : item.error}}</text>
            </view>
            <text class="batch-result-content" wx:if="{{item.success && item.comment}}">{{item.comment}}</text>
          </view>
        </view>
        <view class="comment-edit-area" wx:if="{{commentContent && batchCommentResults.length === 0}}">
          <textarea class="comment-textarea" value="{{commentContent}}" bindinput="onCommentEdit" auto-height maxlength="500" />
          <view class="comment-actions">
            <view class="save-btn" bindtap="saveComment">保存修改</view>
            <text class="modified-tag" wx:if="{{isCommentModified}}">教师修改版</text>
          </view>
          <view class="ai-original" wx:if="{{isCommentModified && aiCommentContent}}">
            <text class="ai-label">AI原版：</text>
            <text class="ai-text">{{aiCommentContent}}</text>
          </view>
        </view>
      </view>
    </block>

    <!-- 预警Tab -->
    <block wx:if="{{selectedTab === 'warning' && canWrite}}">
      <view class="section">
        <view class="section-title">智能预警中心</view>
        <view class="warning-actions">
          <view class="generate-btn" bindtap="onDetectWarnings">
            <text>检测预警</text>
          </view>
          <view class="config-btn" bindtap="onWarningConfig" wx:if="{{canConfigWarning || canWrite}}">
            <text>配置规则</text>
          </view>
        </view>
        <view class="warning-list" wx:if="{{warnings.length > 0}}">
          <view class="warning-item {{item.level === 'high' ? 'high' : 'medium'}}" wx:for="{{warnings}}" wx:key="_id">
            <view class="warning-header">
              <text class="warning-name">{{item.student_name}}</text>
              <text class="warning-status {{item.status}}">{{item.status === 'pending' ? '待处理' : item.status === 'confirmed' ? '已确认' : '已处理'}}</text>
            </view>
            <text class="warning-msg">{{item.message}}</text>
            <view class="warning-ops" wx:if="{{item.status === 'pending'}}">
              <view class="op-btn confirm" bindtap="onWarningConfirm" data-wid="{{item._id}}">确认</view>
              <view class="op-btn resolve" bindtap="onWarningResolve" data-wid="{{item._id}}">处理</view>
            </view>
            <view class="warning-ops" wx:elif="{{item.status === 'confirmed'}}">
              <view class="op-btn resolve" bindtap="onWarningResolve" data-wid="{{item._id}}">处理</view>
            </view>
          </view>
        </view>
        <view class="empty-tip" wx:else>
          <text>暂无预警记录</text>
        </view>
      </view>
    </block>

    <!-- 推荐Tab -->
    <block wx:if="{{selectedTab === 'rec'}}">
      <view class="section">
        <view class="section-title">个性化推荐</view>
        <view class="generate-btn {{generatingRec ? 'disabled' : ''}}" bindtap="loadRecommendations">
          <text>{{generatingRec ? 'AI分析中...' : '获取推荐'}}</text>
        </view>
        <block wx:if="{{recommendations}}">
          <view class="rec-group" wx:if="{{recommendations.activity_recs && recommendations.activity_recs.length > 0}}">
            <text class="rec-title">活动推荐</text>
            <view class="rec-item" wx:for="{{recommendations.activity_recs}}" wx:key="name">
              <text class="rec-name">{{item.name}}</text>
              <text class="rec-reason">{{item.reason}}</text>
              <view class="rec-bottom">
                <text class="rec-score" wx:if="{{item.match_score}}">匹配度: {{item.match_score}}%</text>
                <text class="feedback-btn" bindtap="onRecFeedback" data-name="{{item.name}}" data-type="not_interested">不感兴趣</text>
              </view>
            </view>
          </view>
          <view class="rec-group" wx:if="{{recommendations.resource_recs && recommendations.resource_recs.length > 0}}">
            <text class="rec-title">学习资源</text>
            <view class="rec-item" wx:for="{{recommendations.resource_recs}}" wx:key="name">
              <text class="rec-name">{{item.name}}</text>
              <text class="rec-reason">{{item.reason}}</text>
              <view class="rec-bottom">
                <text class="feedback-btn" bindtap="onRecFeedback" data-name="{{item.name}}" data-type="not_interested">不感兴趣</text>
              </view>
            </view>
          </view>
          <view class="rec-group" wx:if="{{recommendations.volunteer_recs && recommendations.volunteer_recs.length > 0}}">
            <text class="rec-title">志愿匹配</text>
            <view class="rec-item" wx:for="{{recommendations.volunteer_recs}}" wx:key="name">
              <text class="rec-name">{{item.name}}</text>
              <text class="rec-reason">{{item.reason}}</text>
              <view class="rec-bottom">
                <text class="rec-score" wx:if="{{item.match_score}}">匹配度: {{item.match_score}}%</text>
                <text class="feedback-btn" bindtap="onRecFeedback" data-name="{{item.name}}" data-type="not_interested">不感兴趣</text>
              </view>
            </view>
          </view>
        </block>
        <view class="empty-tip" wx:elif="{{!generatingRec}}">
          <text>暂无推荐资源</text>
        </view>
      </view>
    </block>
  </block>
</view>
