<view class="growth-page">
  <view class="loading-wrap" wx:if="{{classLoading}}">
    <text>加载班级信息...</text>
  </view>

  <view class="no-class-tip" wx:elif="{{noClass}}">
    <text class="no-class-text">未加入班级，请联系班主任添加</text>
  </view>

  <view class="class-picker" wx:elif="{{showClassPicker}}">
    <view class="section-title">请选择班级</view>
    <view class="class-item" wx:for="{{classList}}" wx:key="class_id" bindtap="onClassSelect" data-index="{{index}}">
      <text class="class-name">{{item.class_name}}</text>
      <text class="class-role">{{item.role}}</text>
    </view>
  </view>

  <block wx:elif="{{currentClassId}}">
    <view class="class-info-bar">
      <text class="current-class">{{currentClassName}}</text>
      <text class="current-role" wx:if="{{role}}">{{role}}</text>
    </view>

    <growth-overview id="overview" classId="{{currentClassId}}" role="{{role}}" canWrite="{{canWrite}}" bind:warningclick="onWarningClick" />

    <growth-dimensions id="dimensions" classId="{{currentClassId}}" role="{{role}}" canWrite="{{canWrite}}" bind:dimensionclick="onDimensionClick" />

    <growth-ai-review id="aiReview" classId="{{currentClassId}}" role="{{role}}" canWrite="{{canWrite}}" />

    <growth-student-list id="studentList" classId="{{currentClassId}}" role="{{role}}" canWrite="{{canWrite}}" bind:studentclick="onStudentClick" bind:batchreport="onBatchGenerateReport" />

    <growth-warnings id="warnings" classId="{{currentClassId}}" role="{{role}}" canWrite="{{canWrite}}" />

    <view class="bottom-bar" wx:if="{{canWrite}}">
      <view class="bottom-btn" bindtap="loadClassSummary">班级汇总</view>
    </view>
  </block>
</view>