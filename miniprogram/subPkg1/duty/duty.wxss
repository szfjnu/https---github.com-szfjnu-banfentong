/* pages/duty/duty.wxss */
.container {
  padding: 20rpx;
  background: var(--background-color);
  min-height: 100vh;
}

.date-picker {
  background: var(--white);
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.date-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.date-label {
  font-size: 28rpx;
  color: var(--text-color-secondary);
}

.date-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary-color);
  padding: 8rpx 20rpx;
  background: #e6f7ff;
  border-radius: 8rpx;
}

/* 统计卡片 */
.stats-card {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-color));
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(24,144,255,0.3);
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--white);
}

.stat-value.success { color: #95de64; }
.stat-value.warning { color: #ffd666; }
.stat-value.danger { color: var(--error-color); }

.stat-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 6rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255,255,255,0.2);
}

/* 功能入口 */
.func-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.func-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 10rpx;
  background: var(--white);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.func-item:active { opacity: 0.8; }

.func-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 12rpx;
}

.func-text {
  font-size: 24rpx;
  color: var(--text-color);
}

/* 分区卡片 */
.section-card {
  background: var(--white);
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-color);
}

.section-action {
  font-size: 26rpx;
  color: var(--primary-color);
  padding: 6rpx 16rpx;
  background: #e6f7ff;
  border-radius: 8rpx;
}

/* 轮转信息 */
.rotation-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.group-badge {
  padding: 10rpx 24rpx;
  background: #e6f7ff;
  color: var(--primary-color);
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.rotation-mode {
  font-size: 24rpx;
  color: var(--text-color-light);
}

.no-rotation, .no-text {
  font-size: 26rpx;
  color: var(--text-color-light);
}

/* 任务列表 */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: var(--background-color);
  border-radius: 12rpx;
}

.task-left {
  margin-right: 16rpx;
}

.task-status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.task-status-dot.done { background: var(--success-color); }
.task-status-dot.fail { background: var(--error-color); }
.task-status-dot.pending { background: var(--warning-color); }

.task-center {
  flex: 1;
  min-width: 0;
}

.task-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-color);
}

.task-meta {
  display: flex;
  gap: 16rpx;
  margin-top: 6rpx;
}

.task-student, .task-group {
  font-size: 22rpx;
  color: var(--text-color-light);
}

.task-right {
  text-align: right;
}

.task-score {
  font-size: 28rpx;
  font-weight: 600;
}

.task-score.plus { color: var(--success-color); }
.task-score.minus { color: var(--error-color); }

.task-status-text {
  font-size: 22rpx;
  display: block;
  margin-top: 4rpx;
}

.task-status-text.done { color: var(--success-color); }
.task-status-text.fail { color: var(--error-color); }
.task-status-text.pending { color: var(--warning-color); }

/* 空状态 */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  color: var(--text-color-light);
  font-size: 26rpx;
}

.empty-btn {
  margin-top: 20rpx;
  padding: 12rpx 40rpx;
  background: var(--primary-color);
  color: var(--white);
  border-radius: 30rpx;
  font-size: 26rpx;
}

/* 提示卡片 */
.tip-card {
  background: #fff7e6;
  border: 1rpx solid #ffe58f;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tip-icon { font-size: 32rpx; }

.tip-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #ad6800;
}

.tip-btn {
  padding: 8rpx 24rpx;
  background: var(--warning-color);
  color: var(--white);
  border-radius: 20rpx;
  font-size: 24rpx;
}

/* 任务操作按钮 */
.task-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-left: 16rpx;
}

.task-btn {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  text-align: center;
}

.edit-btn {
  background: #e6f7ff;
  color: var(--primary-color);
}

.delete-btn {
  background: #fff1f0;
  color: var(--error-color);
}

/* 编辑弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 85%;
  background: var(--white);
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
}

.modal-close {
  font-size: 36rpx;
  color: var(--text-color-light);
  padding: 8rpx;
}

.modal-body {
  padding: 30rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item .form-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-color-secondary);
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 10rpx;
  font-size: 28rpx;
  color: var(--text-color);
  box-sizing: border-box;
}

.form-picker {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 10rpx;
  font-size: 28rpx;
  color: var(--text-color);
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid var(--border-color);
}

.modal-btn {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 26rpx 0;
  font-size: 30rpx;
}

.modal-btn.cancel {
  color: var(--text-color-secondary);
  border-right: 1rpx solid var(--border-color);
}

.modal-btn.confirm {
  color: var(--primary-color);
  font-weight: 600;
}

.modal-btn.confirm.disabled {
  color: var(--text-color-light);
}
