/* pages/duty/arrange/arrange.wxss */
.container {
  padding: 20rpx;
  background: var(--background-color);
  min-height: 100vh;
}

.date-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--white);
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
}

.date-label { font-size: 28rpx; color: var(--text-color-secondary); }

.date-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--primary-color);
  padding: 8rpx 20rpx;
  background: #e6f7ff;
  border-radius: 8rpx;
}

.section-card {
  background: var(--white);
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 20rpx;
}

/* 小组选择 */
.group-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.group-card {
  padding: 20rpx 30rpx;
  background: var(--background-color);
  border: 2rpx solid var(--border-color);
  border-radius: 12rpx;
  text-align: center;
  min-width: 140rpx;
}

.group-card.selected {
  border-color: var(--primary-color);
  background: #e6f7ff;
}

.group-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-color);
}

.group-count {
  font-size: 22rpx;
  color: var(--text-color-light);
  margin-top: 6rpx;
}

/* 快捷操作 */
.quick-actions {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding-bottom: 4rpx;
}

.action-btn {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  background: var(--white);
  border: 1rpx solid var(--border-color);
  border-radius: 30rpx;
  font-size: 24rpx;
  color: var(--text-color);
}

.action-btn:active { opacity: 0.7; }

/* 成员任务分派 */
.assign-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.assign-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: var(--background-color);
  border-radius: 12rpx;
}

.assign-member {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 160rpx;
}

.member-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--primary-color);
  color: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
}

.member-avatar.leader {
  background: linear-gradient(135deg, var(--warning-color), #d48806);
}

.member-name {
  font-size: 28rpx;
  color: var(--text-color);
}

.leader-tag {
  font-size: 20rpx;
  color: #d48806;
  background: #fffbe6;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

.assign-task {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.task-picker {
  padding: 10rpx 20rpx;
  background: #e6f7ff;
  color: var(--primary-color);
  border-radius: 8rpx;
  font-size: 26rpx;
  min-width: 180rpx;
  text-align: center;
}

.task-picker.assigned {
  background: #f6ffed;
  color: var(--success-color);
}

.exempt-btn {
  font-size: 24rpx;
  color: var(--text-color-light);
  padding: 8rpx 16rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 8rpx;
}

/* 表单 */
.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: var(--text-color-secondary);
  margin-bottom: 12rpx;
  display: block;
}

.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.switch-text {
  font-size: 28rpx;
  color: var(--text-color);
}

/* 星期选择 */
.weekday-grid {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.weekday-item {
  width: 80rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--border-color);
  border-radius: 8rpx;
  font-size: 26rpx;
  color: var(--text-color-secondary);
}

.weekday-item.active {
  border-color: var(--primary-color);
  background: #e6f7ff;
  color: var(--primary-color);
}

/* 小组标签 */
.group-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.group-chip {
  padding: 8rpx 20rpx;
  background: #e6f7ff;
  color: var(--primary-color);
  border-radius: 20rpx;
  font-size: 26rpx;
}

.hint-text {
  font-size: 24rpx;
  color: var(--text-color-light);
  margin-top: 12rpx;
}

/* 提交按钮 */
.submit-btn {
  margin: 30rpx 0;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--primary-color);
  color: var(--white);
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  box-shadow: 0 4rpx 16rpx rgba(24,144,255,0.3);
}

.submit-btn.disabled { opacity: 0.6; }

.empty-hint {
  text-align: center;
  padding: 30rpx 0;
  color: var(--text-color-light);
  font-size: 26rpx;
}

/* 提示卡片 */
.tip-card {
  background: #fff7e6;
  border: 1rpx solid #ffe58f;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tip-icon { font-size: 32rpx; }
.tip-text { font-size: 26rpx; color: #ad6800; }
