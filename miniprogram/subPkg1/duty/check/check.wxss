/* pages/duty/check/check.wxss */
.container {
  padding: 20rpx;
  background: var(--background-color);
  min-height: 100vh;
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.date-badge {
  padding: 12rpx 24rpx;
  background: var(--white);
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary-color);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.batch-btn {
  padding: 12rpx 24rpx;
  background: #f6ffed;
  color: var(--success-color);
  border-radius: 20rpx;
  font-size: 26rpx;
  border: 1rpx solid #b7eb8f;
}

/* 筛选标签 */
.filter-tabs {
  display: flex;
  gap: 0;
  margin-bottom: 20rpx;
  background: var(--white);
  border-radius: 12rpx;
  overflow: hidden;
}

.filter-tab {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: var(--text-color-secondary);
  border-bottom: 4rpx solid transparent;
}

.filter-tab.active {
  color: var(--primary-color);
  border-bottom-color: var(--primary-color);
  font-weight: 600;
}

/* 任务卡片 */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-card {
  background: var(--white);
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.task-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.task-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.task-icon {
  font-size: 40rpx;
}

.task-info {
  display: flex;
  flex-direction: column;
}

.task-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-color);
}

.task-meta {
  font-size: 24rpx;
  color: var(--text-color-light);
  margin-top: 4rpx;
}

.status-tag {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.status-tag.done {
  background: #f6ffed;
  color: var(--success-color);
}

.status-tag.fail {
  background: #fff1f0;
  color: var(--error-color);
}

.status-tag.pending {
  background: #fffbe6;
  color: var(--warning-color);
}

/* 检查结果 */
.task-result {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-color);
}

.result-row {
  display: flex;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.result-label {
  font-size: 24rpx;
  color: var(--text-color-light);
  flex-shrink: 0;
}

.result-value {
  font-size: 24rpx;
  color: var(--text-color);
}

.result-value.plus { color: var(--success-color); font-weight: 600; }
.result-value.minus { color: var(--error-color); font-weight: 600; }

/* 检查按钮 */
.task-action {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-color);
}

.check-btn {
  text-align: center;
  padding: 16rpx 0;
  background: var(--primary-color);
  color: var(--white);
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.check-btn:active { opacity: 0.8; }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon { font-size: 60rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 26rpx; color: var(--text-color-light); }
.loading-state { text-align: center; padding: 60rpx 0; color: var(--text-color-light); }

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.modal-content {
  width: 100%;
  background: var(--white);
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx;
  max-height: 85vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-color);
}

.modal-close { font-size: 36rpx; color: var(--text-color-light); padding: 10rpx; }

.modal-task-info {
  background: var(--background-color);
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.modal-task-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-color);
  display: block;
}

.modal-task-student {
  font-size: 26rpx;
  color: var(--text-color-secondary);
  display: block;
  margin-top: 4rpx;
}

/* 合格按钮 */
.qualified-btns {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.qualified-btn {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 20rpx 0;
  border: 2rpx solid var(--border-color);
  border-radius: 12rpx;
  font-size: 30rpx;
  color: var(--text-color-secondary);
}

.qualified-btn.active.yes {
  border-color: var(--success-color);
  background: #f6ffed;
  color: var(--success-color);
}

.qualified-btn.active.no {
  border-color: var(--error-color);
  background: #fff1f0;
  color: var(--error-color);
}

/* 表单 */
.form-group { margin-bottom: 20rpx; }
.form-group.half { flex: 1;
  min-width: 0; }

.form-label {
  font-size: 26rpx;
  color: var(--text-color-secondary);
  margin-bottom: 10rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 72rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 100rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker {
  height: 72rpx;
  line-height: 72rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--text-color);
}

.form-row { display: flex; gap: 20rpx; }

.score-stars {
  display: flex;
  gap: 16rpx;
}

.star {
  font-size: 48rpx;
  color: var(--border-color);
}

.star.active {
  color: var(--warning-color);
}

.submit-btn {
  margin-top: 30rpx;
  margin-bottom: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--primary-color);
  color: var(--white);
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
}
