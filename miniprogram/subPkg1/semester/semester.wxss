/* pages/semester/semester.wxss */
.container {
  padding: 24rpx;
  background: var(--background-color);
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 统计卡片 */
.stats-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background: var(--white);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.stat-card.active-card {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color) 100%);
}

.stat-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.active-card .stat-value {
  color: var(--white);
  font-size: 28rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-color-light);
}

.active-card .stat-label {
  color: rgba(255, 255, 255, 0.85);
}

/* 列表头部 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
}

.add-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: var(--primary-color);
  color: var(--white);
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.add-btn:active {
  opacity: 0.85;
}

.add-icon {
  font-size: 32rpx;
  line-height: 1;
}

/* 学期列表 */
.semester-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.semester-item {
  background: var(--white);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.semester-item.current {
  border: 2rpx solid var(--primary-color);
  background: linear-gradient(135deg, #f0f7ff 0%, var(--white) 100%);
}

.item-header {
  padding: 24rpx;
}

.item-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.semester-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
}

.badge-row {
  display: flex;
  gap: 12rpx;
}

.badge {
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.current-badge {
  background: var(--primary-color);
  color: var(--white);
}

.status-badge.ongoing {
  background: #e6f7ff;
  color: var(--primary-color);
}

.status-badge.ended {
  background: var(--background-color);
  color: var(--text-color-light);
}

.date-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.date-text {
  font-size: 26rpx;
  color: var(--text-color-secondary);
}

.days-text {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 500;
}

.info-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.info-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: var(--background-color);
  border-radius: 8rpx;
}

.tag-label {
  font-size: 22rpx;
  color: var(--text-color-light);
}

.tag-value {
  font-size: 24rpx;
  color: var(--text-color);
  font-weight: 500;
}

/* 操作按钮 */
.item-actions {
  display: flex;
  border-top: 1rpx solid var(--border-color);
}

.action-btn {
  flex: 1;
  padding: 20rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-color-secondary);
  border-right: 1rpx solid var(--border-color);
}

.action-btn:last-child {
  border-right: none;
}

.action-btn:active {
  background: var(--background-color);
}

.edit-btn {
  color: var(--primary-color);
}

.set-current-btn {
  color: var(--success-color);
}

.delete-btn {
  color: var(--error-color);
}

.delete-btn.disabled {
  color: var(--text-color-light);
  pointer-events: none;
}

.create-time {
  padding: 16rpx 24rpx;
  font-size: 22rpx;
  color: var(--text-color-light);
  background: var(--background-color);
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon-text {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: var(--text-color-secondary);
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-color-light);
}

/* 加载状态 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-color-light);
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.modal-container {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 92%;
  max-width: 680rpx;
  max-height: 85vh;
  background: var(--white);
  border-radius: 20rpx;
  overflow: hidden;
  z-index: 101;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--border-color);
  flex-shrink: 0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-color);
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--text-color-light);
  line-height: 1;
}

.modal-body {
  flex: 1;
  padding: 24rpx 32rpx;
  max-height: 60vh;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid var(--border-color);
  flex-shrink: 0;
}

.btn-cancel, .btn-confirm {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-cancel {
  background: var(--background-color);
  color: var(--text-color-secondary);
}

.btn-confirm {
  background: var(--primary-color);
  color: var(--white);
}

.btn-cancel:active, .btn-confirm:active {
  opacity: 0.85;
}

/* 表单样式 */
.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-color);
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}

.form-label.required::before {
  content: '*';
  color: var(--error-color);
  margin-right: 8rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: var(--background-color);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text-color);
  box-sizing: border-box;
}

.form-input::placeholder {
  color: var(--text-color-light);
}

.form-picker {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: var(--background-color);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text-color);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.form-picker.placeholder {
  color: var(--text-color-light);
}

.picker-arrow {
  color: var(--text-color-light);
  font-size: 32rpx;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  background: var(--background-color);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text-color);
  box-sizing: border-box;
}

.form-divider {
  font-size: 28rpx;
  color: var(--text-color-light);
  padding: 20rpx 0 16rpx;
  margin-bottom: 8rpx;
  border-bottom: 1rpx dashed var(--border-color);
}

.slider-wrap {
  background: var(--background-color);
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
}

.slider-hint {
  font-size: 24rpx;
  color: var(--text-color-light);
  margin-top: 8rpx;
  display: block;
}
