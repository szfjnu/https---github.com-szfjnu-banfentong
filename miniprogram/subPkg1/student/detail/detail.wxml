<!--pages/student/detail/detail.wxml-->
<view class="container" wx:if="{{!loading && student}}">
  <!-- 学生基本信息卡片 -->
  <view class="info-card">
    <view class="card-header">
      <view class="student-basic">
        <view class="avatar">
          <image src="/images/icons/default-avatar.png" mode="aspectFill"></image>
        </view>
        <view class="basic-info">
          <view class="name">{{student.name}}</view>
          <view class="meta">
            <text class="meta-item">{{student.student_id}}</text>
            <text class="meta-item">{{student.class_name}}</text>
          </view>
        </view>
      </view>
      <view class="score-badge" style="background-color: {{student.scoreColor}}">
        {{student.scoreLevel}}
      </view>
    </view>

    <view class="card-body">
      <view class="info-group">
        <view class="info-row">
          <text class="label">当前积分:</text>
          <text class="value score-value" style="color: {{student.scoreColor}}">{{student.current_score || 100}}</text>
        </view>
        <view class="info-row">
          <text class="label">性别:</text>
          <text class="value">{{student.gender}}</text>
        </view>
        <view class="info-row">
          <text class="label">入学日期:</text>
          <text class="value">{{student.formattedEnrollmentDate}}</text>
        </view>
        <view class="info-row">
          <text class="label">出生日期:</text>
          <text class="value">{{student.formattedBirthDate}}</text>
        </view>
        <view class="info-row">
          <text class="label">民族:</text>
          <text class="value">{{student.ethnicity}}</text>
        </view>
        <view class="info-row">
          <text class="label">政治面貌:</text>
          <text class="value">{{student.political_status}}</text>
        </view>
        <view class="info-row">
          <text class="label">是否住宿:</text>
          <text class="value">{{student.is_boarding ? '是' : '否'}}</text>
        </view>
        <view class="info-row">
          <text class="label">班干部职务:</text>
          <text class="value">{{student.position || '无'}}</text>
        </view>
      </view>

      <view wx:if="{{student.is_boarding && student.dorm_info && permissionLevel === 'full_access'}}" class="dorm-info">
        <view class="section-title">住宿信息</view>
        <view class="info-row">
          <text class="label">楼栋:</text>
          <text class="value">{{student.dorm_info.building}}</text>
        </view>
        <view class="info-row">
          <text class="label">房间号:</text>
          <text class="value">{{student.dorm_info.room}}</text>
        </view>
        <view class="info-row">
          <text class="label">床位:</text>
          <text class="value">{{student.dorm_info.bed}}</text>
        </view>
      </view>
      <view wx:elif="{{student.is_boarding && student.dorm_info && permissionLevel !== 'full_access'}}" class="dorm-info">
        <view class="section-title">住宿信息</view>
        <view class="info-row">
          <text class="label">楼栋:</text>
          <text class="value" style="color: #999;">***</text>
        </view>
        <view class="info-row">
          <text class="label">房间号:</text>
          <text class="value" style="color: #999;">***</text>
        </view>
        <view class="info-row">
          <text class="label">床位:</text>
          <text class="value" style="color: #999;">***</text>
        </view>
      </view>
    </view>

    <view class="card-footer" wx:if="{{canEdit}}">
      <button class="edit-btn" bindtap="onEditStudent">编辑信息</button>
      <button class="delete-btn" bindtap="onDeleteStudent">删除学生</button>
    </view>
  </view>

  <!-- 标签页 -->
  <view class="tabs-container">
    <view class="tabs">
      <view
        class="tab-item {{activeTab === item.key ? 'active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="key"
        bindtap="onTabChange"
        data-tab="{{item.key}}"
      >
        {{item.label}}
      </view>
    </view>

    <!-- 基本信息内容 -->
    <view class="tab-content" wx:if="{{activeTab === 'info'}}">
      <view class="contact-info">
        <view class="section-title">联系方式</view>
        <view class="info-row">
          <text class="label">手机号:</text>
          <text class="value" wx:if="{{permissionLevel === 'full_access'}}">{{student.phone_number || '未填写'}}</text>
          <text class="value" wx:else style="color: #999;">***</text>
        </view>
        <view class="info-row">
          <text class="label">家长手机:</text>
          <text class="value" wx:if="{{permissionLevel === 'full_access'}}">{{student.parent_phone_number || '未填写'}}</text>
          <text class="value" wx:else style="color: #999;">***</text>
        </view>
        <view class="info-row">
          <text class="label">家庭住址:</text>
          <text class="value" wx:if="{{permissionLevel === 'full_access'}}">{{student.home_address || '未填写'}}</text>
          <text class="value" wx:else style="color: #999;">***</text>
        </view>
      </view>
    </view>

    <!-- 积分记录内容 -->
    <view class="tab-content" wx:if="{{activeTab === 'score'}}">
      <view wx:if="{{loading}}" class="loading">
        <text>加载中...</text>
      </view>

      <view wx:elif="{{scoreRecords.length === 0}}" class="empty">
        <text class="empty-icon">📊</text>
        <text class="empty-text">暂无积分记录</text>
      </view>

      <view class="record-list" wx:else>
        <view
          class="record-item"
          wx:for="{{scoreRecords}}"
          wx:key="_id"
          bindtap="onViewScoreDetail"
          data-id="{{item._id}}"
        >
          <view class="record-header">
            <text class="record-date">{{item.date}}</text>
            <view class="score-change {{item.scoreChangeClass}}">
              {{item.scoreChangeText}}分
            </view>
          </view>
          <view class="record-body">
            <view class="record-title">{{item.rule_name || item.reason_detail}}</view>
            <text class="record-reason">{{item.reason_detail}}</text>
          </view>
          <view class="record-footer">
            <view class="record-meta">
              <text class="record-source">{{item.source_type}}</text>
              <text class="record-operator" wx:if="{{item.operator_name}}">记录人: {{item.operator_name}}</text>
            </view>
            <text class="record-status">{{item.approval_status}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 志愿服务内容 -->
    <view class="tab-content" wx:if="{{activeTab === 'volunteer'}}">
      <view wx:if="{{loading}}" class="loading">
        <text>加载中...</text>
      </view>

      <view wx:elif="{{volunteerRecords.length === 0}}" class="empty">
        <text class="empty-icon">🤝</text>
        <text class="empty-text">暂无志愿服务记录</text>
      </view>

      <view class="record-list" wx:else>
        <view
          class="record-item"
          wx:for="{{volunteerRecords}}"
          wx:key="_id"
          bindtap="onViewVolunteerDetail"
          data-id="{{item._id}}"
        >
          <view class="record-header">
            <text class="record-date">{{item.date}}</text>
            <view class="service-type" style="color: {{item.typeColor}}">{{item.service_type}}</view>
          </view>
          <view class="record-body">
            <text class="record-name">{{item.activity_name}}</text>
            <text class="record-desc">{{item.description}}</text>
          </view>
          <view class="record-footer">
            <text class="record-duration">时长: {{item.duration}}小时</text>
            <text class="record-score">积分: +{{item.earned_score}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 考勤统计内容 -->
    <view class="tab-content" wx:if="{{activeTab === 'attendance'}}">
      <view wx:if="{{loading}}" class="loading">
        <text>加载中...</text>
      </view>

      <block wx:else>
        <!-- 考勤统计概览 -->
        <view class="attendance-stats-card">
          <view class="section-title">📋 本学期考勤统计</view>
          <view class="stats-grid">
            <view class="stat-item">
              <text class="stat-value" style="color: #52c41a">{{attendanceStats.sick_leave}}</text>
              <text class="stat-label">病假(天)</text>
            </view>
            <view class="stat-item">
              <text class="stat-value" style="color: #1890ff">{{attendanceStats.personal_leave}}</text>
              <text class="stat-label">事假(天)</text>
            </view>
            <view class="stat-item">
              <text class="stat-value" style="color: #fa8c16">{{attendanceStats.late}}</text>
              <text class="stat-label">迟到(次)</text>
            </view>
            <view class="stat-item">
              <text class="stat-value" style="color: #faad14">{{attendanceStats.early_leave}}</text>
              <text class="stat-label">早退(次)</text>
            </view>
            <view class="stat-item">
              <text class="stat-value" style="color: #ff4d4f">{{attendanceStats.absent}}</text>
              <text class="stat-label">旷课(次)</text>
            </view>
            <view class="stat-item">
              <text class="stat-value" style="color: #722ed1">{{attendanceStats.total_leave}}</text>
              <text class="stat-label">请假合计(天)</text>
            </view>
          </view>
        </view>

        <!-- 近期考勤记录 -->
        <view class="attendance-records-card">
          <view class="section-title">📝 近期考勤记录</view>
          <view wx:if="{{attendanceRecords.length === 0}}" class="empty">
            <text class="empty-text">暂无考勤记录</text>
          </view>
          <view class="record-list" wx:else>
            <view class="record-item" wx:for="{{attendanceRecords}}" wx:key="_id">
              <view class="record-header">
                <text class="record-date">{{item.dateText}}</text>
                <view class="attendance-type" style="color: {{item.categoryColor}}">{{item.categoryText}}</view>
              </view>
              <view class="record-body" wx:if="{{item.reason}}">
                <text class="record-reason">{{item.reason}}</text>
              </view>
            </view>
          </view>
        </view>

      </block>
    </view>

    <!-- 住宿积分内容 -->
    <view class="tab-content" wx:if="{{activeTab === 'dorm'}}">
      <view wx:if="{{!isBoarding}}" class="empty">
        <text class="empty-icon">🏠</text>
        <text class="empty-text">该学生非住宿生</text>
      </view>
      <block wx:elif="{{loading}}">
        <view class="loading"><text>加载中...</text></view>
      </block>
      <block wx:else>
        <view class="dorm-score-card">
          <view class="section-title">🏠 住宿积分</view>
          <view wx:if="{{dormScoreInfo}}">
            <view class="dorm-score-overview">
              <view class="dorm-score-main">
                <text class="dorm-score-value">{{dormScoreInfo.current_score}}</text>
                <text class="dorm-score-unit">分</text>
              </view>
              <view class="dorm-score-detail">
                <text class="dorm-stat add">{{dormScoreInfo.total_addDisplay}}</text>
                <text class="dorm-stat minus">-{{dormScoreInfo.total_deduct}}</text>
              </view>
            </view>
            <view class="dorm-records" wx:if="{{dormRecords.length > 0}}">
              <view class="dorm-record-item" wx:for="{{dormRecords}}" wx:key="_id">
                <view class="dorm-record-left">
                  <text class="dorm-record-reason">{{item.reason || item.description || '日常记录'}}</text>
                  <text class="dorm-record-date">{{item.dateStr}}</text>
                </view>
                <text class="dorm-record-score {{item.scoreClass}}">{{item.scoreText}}</text>
              </view>
            </view>
          </view>
          <view wx:else>
            <text class="empty-text">暂无住宿积分记录</text>
          </view>
        </view>
      </block>
    </view>

    <!-- 处分记录内容 -->
    <view class="tab-content" wx:if="{{activeTab === 'discipline'}}">
      <view wx:if="{{loading}}" class="loading">
        <text>加载中...</text>
      </view>

      <view wx:elif="{{disciplineRecords.length === 0}}" class="empty">
        <text class="empty-icon">📋</text>
        <text class="empty-text">暂无处分记录</text>
      </view>

      <view class="record-list" wx:else>
        <view class="record-item" wx:for="{{disciplineRecords}}" wx:key="_id">
          <view class="record-header">
            <text class="record-date">{{item.dateText}}</text>
            <view class="discipline-level" style="color: {{item.levelColor}}">{{item.level_name}}</view>
          </view>
          <view class="record-body">
            <text class="record-reason">{{item.reason}}</text>
            <text class="record-doc">记录编号: {{item.record_id}}</text>
          </view>
          <view class="record-footer">
            <text class="record-deduction">扣分: {{item.points_deducted}}</text>
            <text class="record-status" style="color: {{item.statusText === '已撤销' ? '#52c41a' : '#ff4d4f'}}">{{item.statusText}}</text>
          </view>
          <view class="record-extra" wx:if="{{item.revoked_date}}">
            <text class="revoked-info">撤销日期: {{item.revokedDateText}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 加载状态 -->
<view class="loading-container" wx:if="{{loading}}">
  <view class="loading-icon"></view>
  <text class="loading-text">加载中...</text>
</view>

<!-- 空状态 -->
<view class="empty-container" wx:elif="{{!loading && !student}}">
  <text class="empty-icon">👤</text>
  <text class="empty-text">未找到学生信息</text>
</view>
