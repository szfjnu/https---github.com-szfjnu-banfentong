/* pages/attendance/leave/leave.wxss */

.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding-bottom: 40rpx;
}

/* 页面标题 */
.page-header {
  padding: 40rpx 30rpx 30rpx;
  text-align: center;
  color: var(--white);
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.page-subtitle {
  display: block;
  font-size: 28rpx;
  opacity: 0.9;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  margin: 0 30rpx 30rpx;
  background: var(--white);
  border-radius: 16rpx;
  padding: 10rpx;
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 15rpx 10rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--text-color-secondary);
  transition: all 0.3s;
}

.filter-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: var(--white);
}

/* 添加按钮 */
.add-section {
  margin: 0 30rpx 30rpx;
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 90rpx;
  background: var(--white);
  border-radius: 16rpx;
  border: 2rpx dashed #667eea;
}

.add-icon {
  font-size: 40rpx;
  color: #667eea;
  margin-right: 10rpx;
}

.add-text {
  font-size: 28rpx;
  color: #667eea;
}

/* 记录列表 */
.record-list {
  margin: 0 30rpx;
}

.record-item {
  background: var(--white);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.student-info {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.student-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
}

.leave-type-badge {
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.status-badge {
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.record-body {
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  margin-bottom: 15rpx;
}

.info-label {
  width: 150rpx;
  font-size: 26rpx;
  color: var(--text-color-light);
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-color);
  min-width: 0;
}

.proof-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.proof-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  object-fit: cover;
}

.record-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 15rpx;
  border-top: 1rpx solid var(--border-color);
}

.creator {
  font-size: 24rpx;
  color: var(--text-color-light);
}

.action-btns {
  display: flex;
  gap: 15rpx;
}

.action-btn {
  padding: 8rpx 20rpx;
  background: var(--background-color);
  border-radius: 16rpx;
  font-size: 24rpx;
  color: var(--text-color-secondary);
}

.action-btn.delete {
  background: #fff1f0;
  color: var(--error-color);
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  display: block;
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: var(--white);
  opacity: 0.8;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 60rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: var(--white);
  opacity: 0.8;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 40rpx 0;
}

.load-more-text {
  font-size: 26rpx;
  color: var(--white);
  opacity: 0.8;
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 40rpx 0;
}

.no-more-text {
  font-size: 26rpx;
  color: var(--white);
  opacity: 0.6;
}

/* 弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  background: var(--white);
  border-radius: 30rpx 30rpx 0 0;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--border-color);
  flex-shrink: 0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
}

.modal-close {
  font-size: 36rpx;
  color: var(--text-color-light);
  padding: 10rpx;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-color);
  margin-bottom: 15rpx;
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: var(--background-color);
  border-radius: 16rpx;
}

.form-picker .placeholder {
  color: var(--text-color-light);
}

.picker-icon {
  font-size: 20rpx;
  color: var(--text-color-light);
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background: var(--background-color);
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 150rpx;
  padding: 20rpx;
  background: var(--background-color);
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-tip {
  display: block;
  font-size: 24rpx;
  color: var(--text-color-light);
  margin-top: 10rpx;
}

/* 凭证上传 */
.proof-upload {
  margin-top: 10rpx;
}

.proof-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.proof-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.proof-preview {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  object-fit: cover;
}

.proof-delete {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background: var(--error-color);
  color: var(--white);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.proof-add {
  width: 160rpx;
  height: 160rpx;
  background: var(--background-color);
  border-radius: 16rpx;
  border: 2rpx dashed var(--border-color);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.proof-add-icon {
  font-size: 48rpx;
  color: var(--text-color-light);
}

.proof-add-text {
  font-size: 24rpx;
  color: var(--text-color-light);
  margin-top: 5rpx;
}

/* 提示 */
.form-notice {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #e6f7ff;
  border-radius: 16rpx;
  margin-top: 20rpx;
}

.notice-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.notice-text {
  font-size: 24rpx;
  color: var(--primary-color);
}

/* 弹窗底部 */
.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  border-top: 1rpx solid var(--border-color);
  flex-shrink: 0;
}

.cancel-btn {
  flex: 1;
  height: 80rpx;
  background: var(--background-color);
  border-radius: 16rpx;
  font-size: 30rpx;
  color: var(--text-color-secondary);
}

.confirm-btn {
  flex: 2;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  font-size: 30rpx;
  color: var(--white);
}
