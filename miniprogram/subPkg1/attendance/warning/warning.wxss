.warning-container { min-height: 100vh; background: var(--background-color); padding-bottom: 120rpx; }
.loading-box { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; color: var(--text-color-light); }
.loading-spinner { width: 60rpx; height: 60rpx; border: 4rpx solid var(--border-color); border-top-color: var(--primary-color); border-radius: 50%; animation: spin 0.8s linear infinite; margin-bottom: 20rpx; }
@keyframes spin { to { transform: rotate(360deg); } }
.stats-card { display: flex; gap: 20rpx; margin: 20rpx 24rpx; background: var(--white); padding: 30rpx; border-radius: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.stat-item { flex: 1; text-align: center; }
.stat-value { font-size: 44rpx; font-weight: 700; color: var(--primary-color); display: block; }
.stat-label { font-size: 24rpx; color: var(--text-color-secondary); }
.warning-tabs { display: flex; margin: 20rpx 24rpx; background: var(--background-color); border-radius: 12rpx; overflow: hidden; }
.tab { flex: 1; text-align: center; padding: 20rpx 0; font-size: 28rpx; color: var(--text-color-secondary); }
.tab.active { color: var(--primary-color); background: var(--white); font-weight: 600; }
.warning-list { margin: 20rpx 24rpx; }
.warning-item { display: flex; justify-content: space-between; align-items: center; background: var(--white); padding: 24rpx 28rpx; margin-bottom: 12rpx; border-radius: 16rpx; }
.warning-left { display: flex; flex-direction: column; gap: 8rpx; }
.student-name { font-size: 30rpx; font-weight: 600; color: var(--text-color); }
.warning-detail { font-size: 24rpx; color: var(--text-color-secondary); }
.warning-sub-detail { font-size: 22rpx; color: var(--text-color-light); margin-top: 4rpx; }
.warning-level { font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 8rpx; font-weight: 600; }
.leave-level { color: #ff4d4f; background: #fff2f0; }
.empty-tip { text-align: center; padding: 80rpx 0; font-size: 28rpx; color: var(--text-color-light); }
.bottom-actions { position: fixed; bottom: 0; left: 0; right: 0; display: flex; gap: 20rpx; padding: 20rpx 24rpx; background: var(--white); box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.06); }
.bottom-actions .action-btn { flex: 1; text-align: center; padding: 24rpx 0; border-radius: 16rpx; font-size: 30rpx; font-weight: 600; }
.detect-btn { background: var(--primary-color); color: var(--white); }
.rules-btn { background: var(--background-color); color: var(--text-color-secondary); border: 2rpx solid var(--border-color); }
