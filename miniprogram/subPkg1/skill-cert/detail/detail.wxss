.detail-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.detail-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.detail-title-area {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.detail-type {
  font-size: 26rpx;
  color: var(--text-color-light);
  background: var(--background-color);
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
}

.detail-status {
  font-size: 28rpx;
  font-weight: 600;
}

.detail-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-color);
  margin-bottom: 24rpx;
}

.detail-info-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-item {
  display: flex;
  align-items: center;
}

.info-label {
  width: 140rpx;
  font-size: 26rpx;
  color: var(--text-color-light);
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: var(--text-color);
}

.log-list {
  padding-left: 24rpx;
}

.log-item {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-left: 4rpx solid var(--border-color);
  padding-left: 24rpx;
  position: relative;
}

.log-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--primary-color);
  position: absolute;
  left: -10rpx;
  top: 20rpx;
}

.log-content {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.log-action {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-color);
}

.log-operator {
  font-size: 24rpx;
  color: var(--text-color-secondary);
}

.log-time {
  font-size: 22rpx;
  color: var(--text-color-light);
}

.log-reason {
  font-size: 24rpx;
  color: var(--warning-color);
}

.action-bar {
  display: flex;
  gap: 16rpx;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.btn-warning {
  background: var(--warning-color);
  color: var(--white);
}

.btn-danger {
  background: var(--error-color);
  color: var(--white);
}

.btn-outline {
  background: var(--white);
  color: var(--text-color);
  border: 2rpx solid var(--border-color);
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.modal-content {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--white);
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 101;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 24rpx;
}

.modal-desc {
  font-size: 28rpx;
  color: var(--text-color-secondary);
  display: block;
  margin-bottom: 24rpx;
}

.modal-input {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  background: var(--background-color);
  border-radius: 8rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
}

.loading-state {
  text-align: center;
  padding-top: 200rpx;
  font-size: 28rpx;
  color: var(--text-color-light);
}