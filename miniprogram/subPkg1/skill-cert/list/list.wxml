<view class="container">
  <!-- 筛选栏 -->
  <view class="filter-bar">
    <picker mode="selector" range="{{typeOptions}}" range-key="label" bindchange="onFilterType">
      <view class="filter-item">
        <text>{{typeOptions[0].label}}</text>
        <text class="filter-arrow">▼</text>
      </view>
    </picker>
    <picker mode="selector" range="{{statusOptions}}" range-key="label" bindchange="onFilterStatus">
      <view class="filter-item">
        <text>{{statusOptions[0].label}}</text>
        <text class="filter-arrow">▼</text>
      </view>
    </picker>
  </view>

  <!-- 记录列表 -->
  <view class="record-list" wx:if="{{!loading || displayRecords.length > 0}}">
    <view class="record-card card" wx:for="{{displayRecords}}" wx:key="record_id" bindtap="onItemClick" data-id="{{item.record_id}}">
      <view class="record-header">
        <text class="record-type-icon">{{item.typeIcon}}</text>
        <text class="record-type-label">{{item.typeLabel}}</text>
        <text class="record-status" style="color: {{item.statusColor}}">{{item.statusLabel}}</text>
      </view>
      <view class="record-name">{{item.name}}</view>
      <view class="record-info">
        <text class="record-student">{{item.student_name}}</text>
        <text class="record-date">{{item.eventDateDisplay}}</text>
      </view>
      <view class="record-footer" wx:if="{{item.score_value > 0}}">
        <text class="record-score" style="color: var(--success-color)">积分 {{item.scoreDisplay}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && displayRecords.length === 0}}">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无记录</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading && displayRecords.length === 0}}">
    <text>加载中...</text>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="bottom-actions">
      <view class="btn btn-primary" bindtap="onAdd" wx:if="{{canAdd}}">新增记录</view>
      <view class="btn btn-outline" bindtap="onApprove" wx:if="{{canApprove}}">审批管理</view>
      <view class="btn btn-outline" bindtap="onConfig" wx:if="{{canConfig}}">积分规则</view>
    </view>
  </view>
</view>