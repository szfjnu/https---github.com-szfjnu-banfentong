/* pages/score/mall/mall.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f5ff 0%, var(--background-color) 100%);
  padding-bottom: 40rpx;
}

/* 积分卡片 */
.score-card {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color) 100%);
  margin: 20rpx;
  padding: 30rpx 24rpx;
  border-radius: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.3);
  box-sizing: border-box;
  overflow: hidden;
}

.score-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex-shrink: 1;
  min-width: 0;
  overflow: hidden;
}

.score-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.score-value {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--white);
  word-break: break-all;
}

.score-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
}

.action-btn {
  background: rgba(255, 255, 255, 0.2);
  color: var(--white);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 40rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.action-btn::after {
  border: none;
}

.wish-btn {
  background: rgba(255, 255, 255, 0.3);
}

.btn-icon {
  font-size: 28rpx;
}

/* 标签切换 */
.tabs {
  display: flex;
  background: var(--white);
  margin: 0 20rpx;
  border-radius: 12rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: var(--text-color-secondary);
  border-radius: 8rpx;
  position: relative;
  transition: all 0.3s ease;
}

.tab-item.active {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color) 100%);
  color: var(--white);
  font-weight: 600;
}

.tab-badge {
  position: absolute;
  top: 8rpx;
  right: 20rpx;
  background: var(--error-color);
  color: var(--white);
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  min-width: 28rpx;
  text-align: center;
}

/* 物品容器 */
.items-container {
  padding: 20rpx;
}

/* 物品网格 */
.items-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

/* 物品卡片 */
.item-card {
  background: var(--white);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  position: relative;
}

.item-card.sold-out {
  opacity: 0.6;
}

/* 热门标签 */
.hot-tag {
  position: absolute;
  top: 0;
  left: 0;
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a5a 100%);
  color: var(--white);
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 0 0 12rpx 0;
  z-index: 2;
}

/* 投标模式标签 */
.bid-tag {
  position: absolute;
  top: 0;
  right: 0;
  background: linear-gradient(135deg, #722ed1 0%, #531dab 100%);
  color: var(--white);
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 0 12rpx 0 0;
  z-index: 2;
}

.item-image {
  width: 100%;
  height: 220rpx;
  background: var(--background-color);
  display: flex;
  align-items: center;
  justify-content: center;
}

.item-image image {
  width: 100%;
  height: 100%;
}

.default-icon {
  font-size: 80rpx;
}

.item-info {
  padding: 20rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-price {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-bottom: 12rpx;
}

.price-label {
  font-size: 24rpx;
  color: var(--text-color-light);
}

.price-value {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--error-color);
}

.price-unit {
  font-size: 24rpx;
  color: var(--text-color-light);
}

.item-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-quantity {
  font-size: 22rpx;
  color: var(--text-color-light);
}

.item-mode {
  font-size: 22rpx;
  color: var(--success-color);
  background: #f6ffed;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.item-mode.mode-bid {
  color: #722ed1;
  background: #f9f0ff;
}

/* 操作按钮 */
.item-actions {
  display: flex;
  gap: 12rpx;
  padding: 0 20rpx 20rpx;
}

.action-btn-small {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 8rpx;
  font-size: 24rpx;
  transition: all 0.3s ease;
}

.view-bid-btn {
  background: #f0f5ff;
  color: var(--primary-color);
}

.view-bid-btn:active {
  background: #d6e4ff;
}

.redeem-btn {
  background: linear-gradient(135deg, var(--success-color) 0%, var(--success-color) 100%);
  color: var(--white);
}

.redeem-btn:active {
  opacity: 0.8;
}

.redeem-btn.disabled {
  background: var(--border-color);
  color: var(--text-color-light);
}

/* 兑换状态 */
.item-status {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.status-badge {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-unavailable {
  background: rgba(153, 153, 153, 0.9);
  color: var(--white);
}

/* 心愿单容器 */
.wishes-container {
  padding: 20rpx;
}

.wish-header {
  margin-bottom: 20rpx;
}

.wish-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
  display: block;
  margin-bottom: 8rpx;
}

.wish-tip {
  font-size: 24rpx;
  color: var(--text-color-light);
}

.wish-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.wish-item {
  background: var(--white);
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.wish-info {
  flex: 1;
  margin-right: 20rpx;
}

.wish-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 8rpx;
}

.wish-desc {
  font-size: 24rpx;
  color: var(--text-color-secondary);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wish-meta {
  display: flex;
  gap: 20rpx;
  font-size: 22rpx;
  color: var(--text-color-light);
}

.wish-score {
  color: var(--error-color);
}

.wish-vote {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.vote-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #f6ffed;
  border-radius: 12rpx;
  border: 1rpx solid #b7eb8f;
}

.vote-btn.voted {
  background: #e6f7ff;
  border-color: #91d5ff;
}

.vote-icon {
  font-size: 28rpx;
}

.vote-count {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--success-color);
}

.vote-btn.voted .vote-count {
  color: var(--primary-color);
}

.wish-status {
  font-size: 20rpx;
  color: var(--success-color);
  background: #f6ffed;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.wish-footer {
  margin-top: 30rpx;
}

.submit-wish-btn {
  width: 100%;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color) 100%);
  color: var(--white);
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.submit-wish-btn::after {
  border: none;
}

/* 弹窗通用样式 */
.bid-modal, .wish-modal, .bid-input-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* BUG2修复：投标输入弹窗遮罩层级高于其他弹窗 */
.bid-input-modal {
  z-index: 1001;
}

.modal-content {
  width: 90%;
  max-width: 600rpx;
  max-height: 80vh;
  background: var(--white);
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
}

.modal-close {
  font-size: 32rpx;
  color: var(--text-color-light);
  padding: 8rpx;
}

.modal-body {
  flex: 1;
  padding: 32rpx;
  overflow-y: auto;
}

.modal-footer {
  padding: 24rpx 32rpx;
  border-top: 1rpx solid var(--border-color);
  display: flex;
  gap: 20rpx;
}

/* 投标详情 */
.bid-item-info {
  background: var(--background-color);
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.bid-item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color);
}

.bid-item-price {
  font-size: 26rpx;
  color: var(--error-color);
}

.bid-list {
  display: flex;
  flex-direction: column;
}

.bid-list-header {
  display: grid;
  grid-template-columns: 80rpx 1fr 120rpx 100rpx;
  gap: 12rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-color);
  font-size: 24rpx;
  color: var(--text-color-light);
}

.bid-row {
  display: grid;
  grid-template-columns: 80rpx 1fr 120rpx 100rpx;
  gap: 12rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--background-color);
  font-size: 26rpx;
  align-items: center;
}

.bid-row.is-mine {
  background: #e6f7ff;
  margin: 0 -16rpx;
  padding: 20rpx 16rpx;
  border-radius: 8rpx;
}

.score-highlight {
  color: var(--error-color);
  font-weight: bold;
}

.status-pending { color: var(--warning-color); }
.status-approved { color: var(--success-color); }
.status-winning { color: var(--primary-color); font-weight: bold; }
.status-lost { color: var(--text-color-light); }

.bid-empty, .bid-loading {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-color-light);
  font-size: 28rpx;
}

.bid-tips {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-color-light);
}

.modal-btn {
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
}

.modal-btn::after {
  border: none;
}

.cancel-btn {
  background: var(--background-color);
  color: var(--text-color-secondary);
}

.confirm-btn {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color) 100%);
  color: var(--white);
}

/* 表单样式 */
.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-color);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: var(--background-color);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  background: var(--background-color);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-tip {
  background: #fff7e6;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  border-left: 4rpx solid var(--warning-color);
}

.form-tip text {
  font-size: 24rpx;
  color: #8c6d3c;
  line-height: 1.6;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-color-light);
  margin-bottom: 30rpx;
}

.empty-btn {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color) 100%);
  color: var(--white);
  border: none;
  border-radius: 40rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
}

.empty-btn::after {
  border: none;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: var(--text-color-light);
}

/* 提示信息 */
.tips {
  margin: 40rpx 20rpx 0;
  padding: 24rpx;
  background: #fff7e6;
  border-radius: 12rpx;
  border-left: 4rpx solid var(--warning-color);
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.tip-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 24rpx;
  color: #8c6d3c;
  line-height: 1.6;
}

/* 响应式布局 - 小屏幕适配 */
@media screen and (max-width: 375px) {
  .score-card {
    flex-direction: column;
    gap: 16rpx;
    align-items: stretch;
  }

  .score-info {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .score-value {
    font-size: 40rpx;
  }

  .score-actions {
    flex-direction: row;
    width: 100%;
  }

  .action-btn {
    flex: 1;
    padding: 12rpx 16rpx;
    font-size: 22rpx;
  }

  .items-grid {
    grid-template-columns: 1fr;
  }

  .item-image {
    height: 200rpx;
  }
}

/* 响应式布局 - 超小屏幕适配 */
@media screen and (max-width: 320px) {
  .score-card {
    padding: 24rpx 16rpx;
  }

  .score-value {
    font-size: 36rpx;
  }

  .score-actions {
    flex-direction: row;
    width: 100%;
  }

  .action-btn {
    flex: 1;
    padding: 10rpx 12rpx;
    font-size: 20rpx;
  }

  .item-name {
    font-size: 26rpx;
  }

  .item-actions {
    flex-direction: column;
  }
}

/* BUG2修复：投标输入弹窗专用样式 */
.bid-info-section {
  background: var(--background-color);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.bid-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.bid-info-label {
  font-size: 26rpx;
  color: var(--text-color-light);
}

.bid-info-value {
  font-size: 28rpx;
  color: var(--text-color);
  font-weight: 500;
}

.bid-score-min {
  color: var(--error-color);
  font-weight: bold;
}

.bid-score-mine {
  color: var(--primary-color);
  font-weight: bold;
}

.bid-tip-text {
  font-size: 24rpx;
  color: var(--text-color-light);
  margin-bottom: 24rpx;
  padding: 12rpx 16rpx;
  background: #fff7e6;
  border-radius: 8rpx;
  border-left: 4rpx solid var(--warning-color);
}

.bid-input-section {
  margin-bottom: 16rpx;
}

.bid-input-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-color);
  font-weight: 500;
  margin-bottom: 12rpx;
}

.bid-score-input {
  width: 100%;
  height: 88rpx;
  background: var(--background-color);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  text-align: center;
  box-sizing: border-box;
  color: var(--text-color);
  border: 2rpx solid var(--border-color);
}

.bid-input-error {
  padding: 12rpx 16rpx;
  background: #fff2f0;
  border-radius: 8rpx;
  border-left: 4rpx solid var(--error-color);
}

.bid-input-error text {
  font-size: 24rpx;
  color: var(--error-color);
}
