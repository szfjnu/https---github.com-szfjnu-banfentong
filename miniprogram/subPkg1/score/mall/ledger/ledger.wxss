/* pages/score/mall/ledger/ledger.wxss */
.container {
  padding: 20rpx;
  background: var(--background-color);
  min-height: 100vh;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  background: var(--white);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.stat-value.warning { color: var(--warning-color); }
.stat-value.success { color: var(--success-color); }
.stat-value.primary { color: var(--primary-color); }
.stat-value.orange { color: #fa541c; }

.stat-label {
  font-size: 22rpx;
  color: var(--text-color-light);
}

/* 标签页 */
.tabs {
  display: flex;
  background: var(--white);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: var(--text-color-secondary);
  position: relative;
}

.tab-item.active {
  color: var(--primary-color);
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: var(--primary-color);
  border-radius: 2rpx;
}

.tab-badge {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: var(--error-color);
  color: var(--white);
  font-size: 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

/* 请求卡片 */
.request-card {
  background: var(--white);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-color);
  flex: 1;
  margin-right: 20rpx;
}

.mode-tag {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
}

.mode-tag.bid {
  background: #fff7e6;
  color: var(--warning-color);
}

.mode-tag.direct {
  background: #e6f7ff;
  color: var(--primary-color);
}

.status-tag {
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
}

.status-tag.pending {
  background: #fff7e6;
  color: var(--warning-color);
}

.status-tag.approved {
  background: #f6ffed;
  color: var(--success-color);
}

.status-tag.shipped {
  background: #e6f7ff;
  color: var(--primary-color);
}

.status-tag.received {
  background: #f9f0ff;
  color: #722ed1;
}

.card-body {
  margin-bottom: 15rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.info-label {
  font-size: 24rpx;
  color: var(--text-color-light);
}

.info-value {
  font-size: 26rpx;
  color: var(--text-color);
}

.info-value.cost {
  color: var(--error-color);
  font-weight: bold;
}

.card-actions {
  display: flex;
  gap: 20rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid var(--border-color);
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.action-btn.reject {
  background: #fff2f0;
  color: var(--error-color);
  border: 1rpx solid var(--error-color);
}

.action-btn.approve {
  background: linear-gradient(135deg, var(--success-color) 0%, var(--success-color) 100%);
  color: var(--white);
}

.action-btn.ship {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color) 100%);
  color: var(--white);
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: var(--text-color-light);
  font-size: 28rpx;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: var(--text-color-light);
  font-size: 28rpx;
}
