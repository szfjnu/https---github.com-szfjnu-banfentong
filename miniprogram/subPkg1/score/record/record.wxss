/* pages/score/record/record.wxss */
.container {
  min-height: 100vh;
  background-color: var(--background-color);
  padding-bottom: 40rpx;
}

/* 统计概览 */
.stats-overview {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  margin-bottom: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--white);
}

.stat-value.add {
  color: #95de64;
}

.stat-value.deduct {
  color: var(--error-color);
}

.stat-value.warn {
  color: #ffc53d;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.stat-item.anomaly {
  cursor: pointer;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: var(--white);
  margin-bottom: 10rpx;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: var(--background-color);
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-color);
}

.export-btn {
  margin-left: 20rpx;
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-color));
  border-radius: 40rpx;
  font-size: 26rpx;
  color: var(--white);
}

.export-excel-btn {
  background: linear-gradient(135deg, var(--success-color), var(--success-color));
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  padding: 20rpx;
  background-color: var(--white);
  border-bottom: 1rpx solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: 100;
}

.filter-item {
  flex: 1;
  margin: 0 10rpx;
}

.filter-item:first-child {
  margin-left: 0;
}

.filter-item:last-child {
  margin-right: 0;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background-color: var(--background-color);
  border-radius: 8rpx;
  font-size: 28rpx;
  color: var(--text-color);
}

.arrow {
  color: var(--text-color-light);
  font-size: 20rpx;
}

/* 记录列表 */
.record-list {
  padding: 20rpx;
}

.record-card {
  background-color: var(--white);
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.record-card:last-child {
  margin-bottom: 0;
}

/* 记录头部 */
.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.student-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.student-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
}

.record-date {
  font-size: 24rpx;
  color: var(--text-color-light);
}

.status-badge {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.status-pending {
  background-color: #fff7e6;
  color: var(--warning-color);
}

.status-approved {
  background-color: #f6ffed;
  color: var(--success-color);
}

.status-rejected {
  background-color: #fff1f0;
  color: var(--error-color);
}

/* 记录内容 */
.record-content {
  margin-bottom: 16rpx;
}

.item-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-color);
}

.source-type {
  font-size: 24rpx;
  padding: 6rpx 12rpx;
  background-color: var(--background-color);
  border-radius: 6rpx;
}

.reason-detail {
  font-size: 28rpx;
  color: var(--text-color-secondary);
  line-height: 1.6;
}

/* 记录底部 */
.record-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-color);
}

.score-change {
  font-size: 36rpx;
  font-weight: 600;
}

.score-add {
  color: var(--success-color);
}

.score-minus {
  color: var(--error-color);
}

.recorder-info {
  font-size: 24rpx;
  color: var(--text-color-light);
}

.footer-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.appeal-btn {
  padding: 8rpx 20rpx;
  background-color: #e6f7ff;
  color: var(--primary-color);
  border-radius: 20rpx;
  font-size: 24rpx;
}

/* 高级筛选切换 */
.advanced-toggle {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx;
  background-color: var(--white);
  font-size: 26rpx;
  color: var(--primary-color);
  gap: 8rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.toggle-icon {
  font-size: 20rpx;
}

/* 高级筛选区域 */
.advanced-filters {
  max-height: 0;
  overflow: hidden;
  background-color: var(--white);
  transition: max-height 0.3s ease;
}

.advanced-filters.show {
  max-height: 500rpx;
  padding: 20rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.filter-row {
  display: flex;
  margin-bottom: 20rpx;
}

.filter-row:last-child {
  margin-bottom: 0;
}

.filter-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-color-light);
  margin-bottom: 8rpx;
}

.reset-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 24rpx;
  background-color: var(--background-color);
  border-radius: 8rpx;
  font-size: 28rpx;
  color: var(--text-color-secondary);
  width: 100%;
}

/* 异常预警样式 */
.record-card.anomaly-warning {
  background-color: #fffbe6;
  border: 2rpx solid #ffe58f;
  position: relative;
}

.anomaly-badge {
  position: absolute;
  top: 0;
  right: 0;
  background-color: var(--warning-color);
  color: var(--white);
  padding: 8rpx 16rpx;
  border-radius: 0 12rpx 0 12rpx;
  font-size: 22rpx;
}

/* 原因详情样式 */
.reason-detail {
  display: flex;
  align-items: flex-start;
  font-size: 28rpx;
  color: var(--text-color-secondary);
  line-height: 1.6;
  margin-top: 12rpx;
}

.reason-icon {
  margin-right: 8rpx;
}

/* 类别标签 */
.category-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
  margin-top: 12rpx;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 600rpx;
  background: var(--white);
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
}

.modal-close {
  font-size: 32rpx;
  color: var(--text-color-light);
  padding: 8rpx;
}

.modal-body {
  padding: 32rpx;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid var(--border-color);
}

.cancel-btn, .confirm-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cancel-btn {
  background: var(--background-color);
  color: var(--text-color-secondary);
}

.confirm-btn {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-color));
  color: var(--white);
}

/* 日期选择器弹窗 */
.date-picker-modal .date-item {
  margin-bottom: 24rpx;
}

.date-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-color);
  margin-bottom: 12rpx;
}

.date-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--background-color);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-color);
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-color-light);
}

/* 加载状态 */
.loading, .no-more {
  text-align: center;
  padding: 40rpx 0;
  font-size: 28rpx;
  color: var(--text-color-light);
}

/* 响应式布局 - 小屏幕适配 */
@media screen and (max-width: 375px) {
  .record-card {
    padding: 20rpx;
  }

  .student-name {
    font-size: 30rpx;
  }

  .item-name {
    font-size: 28rpx;
  }

  .score-change {
    font-size: 34rpx;
  }
}

/* 响应式布局 - 超小屏幕适配 */
@media screen and (max-width: 320px) {
  .filter-bar {
    flex-wrap: wrap;
  }

  .filter-item {
    width: 100%;
    margin: 10rpx 0;
  }

  .record-card {
    padding: 16rpx;
  }

  .student-name {
    font-size: 28rpx;
  }

  .item-name {
    font-size: 26rpx;
  }

  .score-change {
    font-size: 32rpx;
  }
}
