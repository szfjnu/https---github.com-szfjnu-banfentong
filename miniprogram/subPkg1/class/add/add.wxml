<!--pages/class/add/add.wxml-->
<view class="container">
  <!-- 表单标题 -->
  <view class="form-header">
    <text class="form-title">{{isEdit ? '编辑班级' : '创建班级'}}</text>
    <text class="form-subtitle">{{isEdit ? '修改班级基本信息' : '创建新班级，成为班级管理员'}}</text>
  </view>

  <!-- 表单内容 -->
  <form bindsubmit="onSubmit">
    <!-- 班级设置 -->
    <view class="form-card">
      <view class="card-title">
        <text class="title-icon">📚</text>
        <text class="title-text">班级设置</text>
      </view>

      <view class="form-item required">
        <text class="form-label">所属年级</text>
        <picker mode="multiSelector" range="{{gradeOptions}}" range-key="label" value="{{gradeIndex}}" bindchange="onGradeChange" bindcolumnchange="onGradeColumnChange">
          <view class="picker-value">
            <text>{{selectedGradeText || '请选择年级'}}</text>
            <text class="arrow">▼</text>
          </view>
        </picker>
      </view>

      <view class="form-item required">
        <text class="form-label">班级名称</text>
        <input
          class="form-input"
          name="class_name"
          placeholder="如：高2025级1班"
          value="{{formData.class_name}}"
          bindinput="onInputChange"
          data-field="class_name"
        />
      </view>

      <view class="form-item">
        <text class="form-label">预设人数</text>
        <input
          class="form-input"
          type="number"
          name="student_count"
          placeholder="预估班级人数（选填）"
          value="{{formData.student_count}}"
          bindinput="onInputChange"
          data-field="student_count"
        />
      </view>
    </view>

    <!-- 身份设置 -->
    <view class="form-card">
      <view class="card-title">
        <text class="title-icon">👤</text>
        <text class="title-text">身份设置</text>
      </view>

      <view class="form-item required">
        <text class="form-label">姓名</text>
        <input
          class="form-input"
          name="creator_name"
          placeholder="请输入您的姓名"
          value="{{formData.creator_name}}"
          bindinput="onInputChange"
          data-field="creator_name"
        />
      </view>

      <view class="form-item required">
        <text class="form-label">手机号</text>
        <input
          class="form-input"
          type="number"
          name="creator_phone"
          placeholder="请输入手机号"
          value="{{formData.creator_phone}}"
          bindinput="onInputChange"
          data-field="creator_phone"
          maxlength="11"
        />
      </view>

      <view class="form-item">
        <text class="form-label">任教科目</text>
        <picker mode="selector" range="{{subjectOptions}}" value="{{subjectIndex}}" bindchange="onSubjectChange">
          <view class="picker-value">
            <text>{{subjectOptions[subjectIndex] || '请选择'}}</text>
            <text class="arrow">▼</text>
          </view>
        </picker>
      </view>
    </view>

    <!-- 删除按钮 - 仅编辑模式显示 -->
    <view class="delete-section" wx:if="{{isEdit}}">
      <view class="delete-warning">
        <text class="warning-icon">⚠️</text>
        <text class="warning-text">删除操作不可恢复，请谨慎操作</text>
      </view>
      <button class="btn-delete" bindtap="onDelete">删除该班级</button>
    </view>

    <!-- 操作按钮 -->
    <view class="form-actions">
      <button class="btn-cancel" bindtap="onCancel">取消</button>
      <button class="btn-submit" form-type="submit" loading="{{submitting}}">
        {{isEdit ? '保存修改' : '创建班级'}}
      </button>
    </view>

    <!-- 帮助链接 -->
    <view class="help-link" bindtap="onShowHelp">
      <text>遇到问题？点此查看帮助</text>
    </view>
  </form>

  <!-- 创建成功弹窗 -->
  <view class="success-modal" wx:if="{{showSuccessModal}}">
    <view class="modal-mask" bindtap="onCloseSuccessModal"></view>
    <view class="modal-content">
      <view class="modal-icon">🎉</view>
      <view class="modal-title">班级创建成功</view>
      <view class="modal-desc">您已成为该班级的管理员</view>
      <view class="class-info-card">
        <view class="info-row">
          <text class="info-label">班级名称</text>
          <text class="info-value">{{createdClass.class_name}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">所属年级</text>
          <text class="info-value">{{createdClass.grade}}</text>
        </view>
        <view class="info-row code-row">
          <text class="info-label">班级码</text>
          <view class="code-box">
            <text class="code-value">{{createdClass.class_code}}</text>
            <text class="code-tip">分享给家长/学生快速加入</text>
          </view>
        </view>
      </view>
      <view class="modal-actions">
        <button class="btn-back" bindtap="onCloseSuccessModal">返回列表</button>
        <button class="btn-enter" bindtap="onInitSemester">初始化学期</button>
        <button class="btn-enter" bindtap="onEnterClass">进入班级</button>
      </view>
    </view>
  </view>

  <!-- 升级提示弹窗 -->
  <view class="upgrade-modal" wx:if="{{showUpgradeModal}}">
    <view class="modal-mask" catchtap="onCloseUpgradeModal"></view>
    <view class="modal-content upgrade-content">
      <view class="modal-icon">🔒</view>
      <view class="modal-title">需要升级会员</view>
      <view class="modal-desc">{{membershipInfo.reason}}</view>
      <view class="upgrade-features">
        <view class="feature-item">
          <text class="feature-icon">✓</text>
          <text class="feature-text">创建和管理班级</text>
        </view>
        <view class="feature-item">
          <text class="feature-icon">✓</text>
          <text class="feature-text">授权班级管理员</text>
        </view>
        <view class="feature-item">
          <text class="feature-icon">✓</text>
          <text class="feature-text">数据导出功能</text>
        </view>
        <view class="feature-item">
          <text class="feature-icon">✓</text>
          <text class="feature-text">更多高级功能</text>
        </view>
      </view>
      <view class="modal-actions">
        <button class="btn-back" bindtap="onCloseUpgradeModal">返回</button>
        <button class="btn-upgrade" bindtap="goToMembership">升级会员</button>
      </view>
    </view>
  </view>
</view>
