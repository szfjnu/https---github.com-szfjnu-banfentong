/* pages/class/settings/settings.wxss */
.container {
  min-height: 100vh;
  background: var(--background-color);
  padding-bottom: 40rpx;
}

/* 班级信息卡片 */
.class-info-card {
  background: var(--white);
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: var(--text-color-light);
}

.info-value {
  font-size: 28rpx;
  color: var(--text-color);
  font-weight: 500;
}

.status-graduated {
  color: var(--success-color);
}

/* 设置区域 */
.settings-section,
.actions-section {
  background: var(--white);
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.section-title {
  padding: 30rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-color);
  border-bottom: 1rpx solid var(--border-color);
}

.settings-list,
.action-list {
  padding: 0 30rpx;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-left {
  display: flex;
  align-items: center;
}

.setting-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.setting-name {
  font-size: 28rpx;
  color: var(--text-color);
}

/* 操作项 */
.action-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.action-item:last-child {
  border-bottom: none;
}

.action-item.danger .action-name {
  color: var(--error-color);
}

.action-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.action-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-color);
  min-width: 0;
}

.action-arrow {
  font-size: 32rpx;
  color: var(--text-color-light);
}

/* 加载状态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-icon {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border-color);
  border-top: 4rpx solid var(--primary-color);
  border-radius: 50%;
  margin-bottom: 20rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-color-light);
}

/* 权限管理 */
.perm-section {
  background: var(--white);
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.perm-list {
  padding: 0 30rpx;
}

.perm-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.perm-item:last-child {
  border-bottom: none;
}

.perm-info {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.perm-name {
  font-size: 28rpx;
  color: var(--text-color);
  font-weight: 500;
  margin-right: 16rpx;
}

.perm-badge {
  font-size: 22rpx;
  color: var(--primary-color);
  background: var(--primary-color-light, rgba(24, 144, 255, 0.1));
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.perm-modules {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.perm-module-tag {
  font-size: 22rpx;
  color: var(--text-color-light);
  background: var(--background-color, #f5f5f5);
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}

.perm-actions {
  display: flex;
  gap: 24rpx;
}

.perm-edit-btn {
  font-size: 26rpx;
  color: var(--primary-color);
}

.perm-remove-btn {
  font-size: 26rpx;
  color: var(--error-color);
}

.perm-empty,
.perm-loading {
  padding: 40rpx 30rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-color-light);
}

/* 权限编辑弹窗 */
.perm-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.perm-modal {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 640rpx;
  background: var(--white);
  border-radius: 16rpx;
  z-index: 1001;
  overflow: hidden;
}

.perm-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.perm-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
}

.perm-modal-close {
  font-size: 36rpx;
  color: var(--text-color-light);
  padding: 0 10rpx;
}

.perm-modal-body {
  padding: 30rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.perm-toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border-color);
  margin-bottom: 24rpx;
}

.perm-toggle-label {
  font-size: 28rpx;
  color: var(--text-color);
  font-weight: 500;
}

.perm-module-section-title {
  font-size: 26rpx;
  color: var(--text-color-light);
  margin-bottom: 16rpx;
  display: block;
}

.perm-module-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.perm-module-item:last-child {
  border-bottom: none;
}

.perm-module-name {
  font-size: 28rpx;
  color: var(--text-color);
}

.perm-modal-footer {
  display: flex;
  border-top: 1rpx solid var(--border-color);
}

.perm-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
}

.perm-btn-cancel {
  color: var(--text-color-light);
  border-right: 1rpx solid var(--border-color);
}

.perm-btn-save {
  color: var(--primary-color);
  font-weight: 500;
}
