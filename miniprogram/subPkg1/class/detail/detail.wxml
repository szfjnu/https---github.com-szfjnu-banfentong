<!--pages/class/detail/detail.wxml-->
<view class="container">
  <!-- 班级信息卡片 -->
  <view class="class-card" wx:if="{{!loading && classInfo}}">
    <view class="card-header">
      <view class="class-icon">📚</view>
      <view class="class-basic min-w-0">
        <view class="class-name ellipsis">{{classInfo.class_name}}</view>
        <view class="class-meta">
          <text class="meta-item">{{classInfo.grade}}</text>
          <text class="meta-item" wx:if="{{classInfo.creator_name}}">创建人: {{classInfo.creator_name}}</text>
        </view>
      </view>
      <view class="settings-btn" bindtap="onGoToSettings">
        <text>⚙️</text>
      </view>
    </view>

    <!-- 班级码 -->
    <view class="class-code-section" wx:if="{{classInfo.class_code}}">
      <view class="code-label">班级码</view>
      <view class="code-value">{{classInfo.class_code}}</view>
      <view class="code-tip">分享给家长/学生，快速加入班级</view>
    </view>
  </view>

  <!-- 班级切换 -->
  <view class="class-switcher" wx:if="{{myClasses.length > 1}}">
    <view class="switcher-label">切换班级:</view>
    <picker mode="selector" range="{{myClasses}}" range-key="class_name" value="{{currentClassIndex}}" bindchange="onSwitchClass">
      <view class="switcher-value">
        <text>{{classInfo.class_name}}</text>
        <text class="arrow">▼</text>
      </view>
    </picker>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-icon"></view>
    <view class="loading-text">加载中...</view>
  </view>
</view>
