/* pages/class/detail/detail.wxss */
.container {
  min-height: 100vh;
  background: var(--background-color);
  padding-bottom: 120rpx;
}

/* 天气提示 */
.weather-tip {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a52 100%);
  padding: 24rpx 30rpx;
  color: var(--white);
}

.weather-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.weather-text {
  font-size: 28rpx;
}

/* 生日提醒 */
.birthday-reminder {
  background: linear-gradient(135deg, #ff85c0 0%, #ff69b4 100%);
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.birthday-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  color: var(--white);
}

.birthday-left {
  display: flex;
  align-items: center;
}

.birthday-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.birthday-info {
  display: flex;
  flex-direction: column;
}

.birthday-title {
  font-size: 32rpx;
  font-weight: bold;
}

.birthday-count {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}

.birthday-content {
  background: var(--white);
  padding: 24rpx 30rpx;
}

.birthday-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.birthday-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background: #fff0f6;
  border-radius: 16rpx;
}

.birthday-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 16rpx;
}

.birthday-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-color);
  min-width: 0;
}

.birthday-wish {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #ff85c0 0%, #ff69b4 100%);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: var(--white);
}

/* 今日课程 */
.today-course {
  background: linear-gradient(135deg, #ffa940 0%, var(--warning-color) 100%);
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.course-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  color: var(--white);
}

.course-left {
  display: flex;
  align-items: center;
}

.course-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.course-info {
  display: flex;
  flex-direction: column;
}

.course-title {
  font-size: 32rpx;
  font-weight: bold;
}

.course-date {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}

.notification-icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.notification-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: var(--error-color);
  border-radius: 16rpx;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.course-content {
  background: var(--white);
  padding: 24rpx 30rpx;
}

.course-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.empty-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-color-light);
}

.course-list {
  margin-bottom: 20rpx;
}

.course-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.course-item:last-child {
  border-bottom: none;
}

.course-time {
  width: 120rpx;
  font-size: 24rpx;
  color: var(--text-color-light);
}

.course-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-color);
  min-width: 0;
}

.course-action {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  background: var(--background-color);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--primary-color);
}

.arrow {
  margin-left: 8rpx;
}

/* 今日任务 */
.today-task {
  background: var(--white);
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
}

.task-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.task-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.task-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-color);
}

.task-content {
  min-height: 80rpx;
}

.task-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-item {
  display: flex;
  align-items: center;
}

.task-check {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-size: 24rpx;
  color: var(--white);
}

.task-check.checked {
  background: var(--success-color);
  border-color: var(--success-color);
}

.task-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-color);
  min-width: 0;
}

.task-text.completed {
  color: var(--text-color-light);
  text-decoration: line-through;
}

/* 数据统计 */
.data-stats {
  display: flex;
  justify-content: space-between;
  margin: 20rpx;
  gap: 20rpx;
}

.stat-item {
  flex: 1;
  background: var(--white);
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-bottom: 16rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-color-light);
}

/* 积分排行榜 */
.score-rank {
  background: var(--white);
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.rank-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.rank-left {
  display: flex;
  align-items: center;
}

.rank-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.rank-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-color);
}

.rank-action {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--primary-color);
}

.rank-list {
  padding: 0 30rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-item.first {
  background: linear-gradient(90deg, #fff7e6 0%, var(--white) 100%);
  margin: 0 -30rpx;
  padding: 20rpx 30rpx;
}

.rank-number {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--border-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  color: var(--text-color-secondary);
  margin-right: 16rpx;
}

.rank-item.first .rank-number {
  background: linear-gradient(135deg, #ffd700 0%, #ffb800 100%);
  color: var(--white);
}

.rank-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--background-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 16rpx;
}

.rank-info {
  flex: 1;
  min-width: 0;
}

.rank-name {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 4rpx;
}

.rank-score {
  font-size: 24rpx;
  color: var(--primary-color);
}

.rank-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}

/* 班级信息卡片 */
.class-card {
  background: var(--white);
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.card-header {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.class-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}

.class-basic {
  flex: 1;
  min-width: 0;
}

.class-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 8rpx;
}

.class-meta {
  display: flex;
  gap: 20rpx;
}

.meta-item {
  font-size: 24rpx;
  color: var(--text-color-light);
}

.settings-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--background-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

/* 班级码 */
.class-code-section {
  padding: 24rpx 30rpx;
  background: var(--background-color);
  text-align: center;
}

.code-label {
  font-size: 24rpx;
  color: var(--text-color-light);
  margin-bottom: 8rpx;
}

.code-value {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--primary-color);
  letter-spacing: 8rpx;
  margin-bottom: 8rpx;
}

.code-tip {
  font-size: 22rpx;
  color: var(--text-color-light);
}

/* 班级切换 */
.class-switcher {
  display: flex;
  align-items: center;
  background: var(--white);
  margin: 20rpx;
  padding: 24rpx 30rpx;
  border-radius: 16rpx;
}

.switcher-label {
  font-size: 28rpx;
  color: var(--text-color-secondary);
  margin-right: 16rpx;
}

.switcher-value {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background: var(--background-color);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--text-color);
}

/* 快捷功能 */
.quick-actions {
  background: var(--white);
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 24rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.action-title {
  font-size: 24rpx;
  color: var(--text-color-secondary);
}

/* 加载状态 */
.loading {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading-icon {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border-color);
  border-top: 4rpx solid var(--primary-color);
  border-radius: 50%;
  margin-bottom: 20rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-color-light);
}

/* 底部导航栏 */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: var(--white);
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
}

.nav-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.nav-text {
  font-size: 22rpx;
  color: var(--text-color-light);
}

.nav-item.active .nav-icon {
  transform: scale(1.1);
}

.nav-item.active .nav-text {
  color: var(--primary-color);
  font-weight: bold;
}
