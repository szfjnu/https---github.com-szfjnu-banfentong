/* pages/discipline/revoke-admin/revoke-admin.wxss */
.container { padding: 20rpx; background: var(--background-color); min-height: 100vh; }

.stats-card { background: var(--white); border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.stats-row { display: flex; align-items: center; justify-content: space-around; }
.stat-item { text-align: center; flex: 1; }
.stat-value { display: block; font-size: 36rpx; font-weight: 700; }
.stat-value.warning { color: var(--warning-color); }
.stat-value.success { color: var(--success-color); }
.stat-value.danger { color: var(--error-color); }
.stat-label { font-size: 24rpx; color: var(--text-color-light); }
.stat-divider { width: 1rpx; height: 50rpx; background: var(--border-color); }

.filter-tabs { display: flex; background: var(--white); border-radius: 12rpx; padding: 8rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.filter-tab { flex: 1; text-align: center; padding: 14rpx 0; font-size: 26rpx; color: var(--text-color-secondary); border-radius: 8rpx; }
.filter-tab.active { background: var(--primary-color); color: var(--white); font-weight: 500; }

.app-card { background: var(--white); border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.app-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid var(--border-color); }
.student-info { display: flex; align-items: center; gap: 12rpx; }
.student-name { font-size: 30rpx; font-weight: 600; color: var(--text-color); }
.level-badge { display: inline-block; padding: 4rpx 16rpx; border-radius: 20rpx; font-size: 22rpx; font-weight: 500; }
.revoke-status { font-size: 24rpx; padding: 4rpx 16rpx; border-radius: 20rpx; }
.revoke-status.pending { background: #fff7e6; color: var(--warning-color); }
.revoke-status.approved { background: #f6ffed; color: var(--success-color); }
.revoke-status.rejected { background: #fff1f0; color: var(--error-color); }

.app-body { margin-bottom: 16rpx; }
.info-row { display: flex; margin-bottom: 8rpx; }
.info-label { font-size: 26rpx; color: var(--text-color-light); width: 140rpx; flex-shrink: 0; }
.info-value { font-size: 26rpx; color: var(--text-color); flex: 1; }

.app-footer { display: flex; justify-content: space-between; align-items: center; padding-top: 16rpx; border-top: 1rpx solid var(--border-color); }
.app-actions { display: flex; gap: 16rpx; }
.action-btn { padding: 10rpx 28rpx; border-radius: 8rpx; font-size: 26rpx; }
.action-btn.approve { background: #f6ffed; color: var(--success-color); border: 1rpx solid #b7eb8f; }
.action-btn.reject { background: #fff1f0; color: var(--error-color); border: 1rpx solid #ffa39e; }
.detail-btn { font-size: 26rpx; color: var(--primary-color); }

.empty-state { text-align: center; padding: 80rpx 0; }
.empty-icon { font-size: 60rpx; display: block; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; color: var(--text-color-light); }

/* 弹窗 */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center; }
.modal-content { width: 600rpx; background: var(--white); border-radius: 16rpx; overflow: hidden; }
.modal-header { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 32rpx; border-bottom: 1rpx solid var(--border-color); }
.modal-title { font-size: 32rpx; font-weight: 600; color: var(--text-color); }
.modal-close { font-size: 36rpx; color: var(--text-color-light); padding: 8rpx; }
.modal-body { padding: 24rpx 32rpx; }
.form-group { margin-bottom: 16rpx; }
.form-label { font-size: 28rpx; color: var(--text-color-secondary); margin-bottom: 8rpx; display: block; }
.form-textarea { width: 100%; height: 160rpx; border: 1rpx solid var(--border-color); border-radius: 8rpx; padding: 16rpx; font-size: 28rpx; box-sizing: border-box; }
.modal-footer { display: flex; border-top: 1rpx solid var(--border-color); }
.btn-cancel, .btn-confirm { flex: 1; text-align: center; padding: 24rpx 0; font-size: 30rpx; }
.btn-cancel { color: var(--text-color-light); border-right: 1rpx solid var(--border-color); }
.btn-confirm { color: var(--primary-color); font-weight: 500; }

.loading-state { text-align: center; padding: 80rpx 0; color: var(--text-color-light); }
