/* pages/volunteer/add/add.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 表单头部 */
.form-header {
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
  padding: 40rpx 30rpx;
  color: #fff;
}

.form-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.form-subtitle {
  display: block;
  font-size: 26rpx;
  opacity: 0.8;
}

/* 表单卡片 */
.form-card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: #fafafa;
}

.title-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

/* 表单项 */
.form-item {
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item.required .form-label::before {
  content: '*';
  color: #ff4d4f;
  margin-right: 8rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-input::placeholder {
  color: #bfbfbf;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

/* 选择器 */
.picker-value {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
}

.picker-value .arrow {
  font-size: 20rpx;
  color: #bfbfbf;
}

/* 积分信息 */
.score-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #f6ffed;
  margin: 20rpx 30rpx;
  border-radius: 12rpx;
}

.score-label {
  font-size: 28rpx;
  color: #52c41a;
}

.score-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #52c41a;
}

/* 图片上传 */
.image-upload {
  margin-top: 10rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.proof-image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
}

.add-image {
  width: 200rpx;
  height: 200rpx;
  background: #f5f7fa;
  border: 2rpx dashed #d9d9d9;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 60rpx;
  color: #bfbfbf;
}

.add-text {
  font-size: 24rpx;
  color: #bfbfbf;
  margin-top: 10rpx;
}

/* 操作按钮 */
.form-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
  gap: 20rpx;
}

.btn-cancel {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 30rpx;
  border-radius: 12rpx;
  border: none;
}

.btn-cancel::after {
  border: none;
}

.btn-submit {
  flex: 2;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
  color: #fff;
  font-size: 30rpx;
  border-radius: 12rpx;
  border: none;
}

.btn-submit::after {
  border: none;
}

/* ====== 学生选择区域 ====== */
.selected-students {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx 0;
}

.student-tag {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background: #e6f7ff;
  border-radius: 20rpx;
  gap: 8rpx;
}

.tag-name {
  font-size: 26rpx;
  color: #1890ff;
}

.tag-remove {
  font-size: 28rpx;
  color: #1890ff;
  font-weight: 300;
}

.add-student-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  margin-top: 16rpx;
}

.add-student-btn .btn-icon {
  font-size: 32rpx;
  color: #1890ff;
}

.add-student-btn .btn-text {
  font-size: 28rpx;
  color: #1890ff;
}

.student-count {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

/* ====== 学生选择器弹窗 ====== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.modal-content.student-picker {
  width: 100%;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  font-size: 32rpx;
  color: #999;
  padding: 8rpx;
}

.search-box {
  padding: 20rpx 32rpx;
}

.search-input {
  width: 100%;
  height: 72rpx;
  background: #f5f7fa;
  border-radius: 36rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.selected-info {
  padding: 0 32rpx 16rpx;
  font-size: 26rpx;
  color: #1890ff;
}

.student-list {
  flex: 1;
  max-height: 50vh;
  padding: 0 32rpx;
}

.student-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  gap: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.student-item.selected .student-avatar {
  background: linear-gradient(135deg, #52c41a, #389e0d);
}

.student-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666;
}

.student-info {
  flex: 1;
}

.student-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  display: block;
}

.student-id {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.check-box {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.student-item.selected .check-box {
  background: #1890ff;
  border-color: #1890ff;
}

.check-icon {
  font-size: 24rpx;
  color: #fff;
}

.modal-footer {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
}

.confirm-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

/* 积分信息更新 */
.score-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #f6ffed;
  margin: 20rpx 30rpx;
  border-radius: 12rpx;
}

.score-label {
  font-size: 28rpx;
  color: #52c41a;
}

.score-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #52c41a;
}

.score-hint {
  font-size: 24rpx;
  color: #73d13d;
  margin-left: 8rpx;
}
