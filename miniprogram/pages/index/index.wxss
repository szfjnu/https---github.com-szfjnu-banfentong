/* pages/index/index.wxss */
.container {
  padding: 20rpx;
  background: var(--background-color);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 卡片通用样式 */
.card {
  background: var(--white);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 30rpx;
}

/* 用户信息卡片 */
.user-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: var(--white);
}

.user-main {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.user-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.avatar {
  border-radius: 50%;
  margin-right: 30rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.avatar-large {
  width: 100rpx;
  height: 100rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.user-role {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 20rpx;
}

.tag {
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
}

.tag-primary {
  background: rgba(255, 255, 255, 0.3);
  color: var(--white);
}

.semester {
  font-size: 24rpx;
  opacity: 0.9;
}

/* 天气信息 */
.weather-section {
  text-align: right;
  padding-left: 20rpx;
}

.weather-main {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.weather-temp {
  font-size: 48rpx;
  font-weight: bold;
  line-height: 1;
}

.weather-desc {
  font-size: 24rpx;
  opacity: 0.9;
}

.weather-detail {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  font-size: 20rpx;
  opacity: 0.8;
}

.weather-wind, .weather-humidity {
  display: block;
}

.weather-tips {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.tips-icon {
  font-size: 24rpx;
}

.tips-text {
  font-size: 22rpx;
  opacity: 0.9;
}

/* 统计卡片 */
.stat-card {
  background: var(--white);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.stat-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 20rpx;
}

/* 紧凑型统计网格 - 四个一行 */
.stat-grid-compact {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15rpx;
  margin-bottom: 30rpx;
}

.stat-item-compact {
  text-align: center;
  padding: 20rpx 10rpx;
  background: linear-gradient(135deg, var(--background-color) 0%, #f0f2f5 100%);
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.stat-item-compact:active {
  transform: scale(0.95);
}

.stat-value-compact {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--primary-color);
  margin-bottom: 8rpx;
  line-height: 1.2;
}

.stat-label-compact {
  font-size: 22rpx;
  color: var(--text-color-secondary);
}

.text-warning {
  color: var(--warning-color);
}

/* 普通统计网格 */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.stat-item {
  text-align: center;
  padding: 30rpx 20rpx;
  background: linear-gradient(135deg, var(--background-color) 0%, #f0f2f5 100%);
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.stat-item:active {
  transform: scale(0.95);
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--primary-color);
  margin-bottom: 10rpx;
  line-height: 1.2;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-color-secondary);
}

/* 积分排行榜 */
.ranking-section {
  border-top: 1rpx solid var(--border-color);
  padding-top: 20rpx;
}

.ranking-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.ranking-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color);
}

.ranking-more {
  font-size: 24rpx;
  color: var(--primary-color);
}

.ranking-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ranking-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: var(--background-color);
  border-radius: 12rpx;
}

.ranking-item:nth-child(1) {
  background: linear-gradient(135deg, #fff7e6 0%, #fffbe6 100%);
}

.ranking-item:nth-child(2) {
  background: linear-gradient(135deg, var(--background-color) 0%, var(--background-color) 100%);
}

.ranking-item:nth-child(3) {
  background: linear-gradient(135deg, #fff1e6 0%, #fff7f0 100%);
}

.ranking-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.ranking-badge {
  width: 40rpx;
  font-size: 28rpx;
  text-align: center;
}

.ranking-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}

.ranking-name {
  font-size: 28rpx;
  color: var(--text-color);
  font-weight: 500;
}

.ranking-right {
  text-align: right;
}

.ranking-score {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--success-color);
  display: block;
}

.ranking-label {
  font-size: 20rpx;
  color: var(--text-color-light);
}

.ranking-empty, .ranking-loading {
  text-align: center;
  padding: 40rpx 0;
  color: var(--text-color-light);
  font-size: 26rpx;
}

/* 提醒区域 */
.reminder-section {
  margin-bottom: 20rpx;
}

.reminder-cards {
  display: flex;
  gap: 15rpx;
}

.reminder-card {
  flex: 1;
  background: var(--white);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.reminder-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.reminder-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color);
}

.reminder-icon {
  font-size: 28rpx;
}

.reminder-actions {
  display: flex;
  gap: 16rpx;
}

.switch-btn {
  font-size: 22rpx;
  color: var(--primary-color);
  padding: 4rpx 12rpx;
  background: #e6f7ff;
  border-radius: 8rpx;
}

.more-btn {
  font-size: 22rpx;
  color: var(--text-color-light);
}

/* 课程列表 */
.course-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.course-item {
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  background: var(--background-color);
  border-radius: 12rpx;
  gap: 16rpx;
}

.course-item.active {
  background: #e6f7ff;
  border-left: 4rpx solid var(--primary-color);
}

.course-item.upcoming {
  background: #fff7e6;
  border-left: 4rpx solid var(--warning-color);
}

.course-item.finished {
  opacity: 0.6;
}

.course-group {
  margin-bottom: 8rpx;
}

.course-group-label {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.current-label {
  color: var(--primary-color);
}

.upcoming-label {
  color: var(--warning-color);
}

.finished-label {
  color: var(--text-color-light);
  font-size: 24rpx;
  padding: 8rpx 0;
}

.finished-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  color: var(--text-color-light);
  background: var(--background-color);
  border-radius: 8rpx;
}

.toggle-icon {
  color: var(--primary-color);
  font-size: 22rpx;
}

.course-time {
  text-align: center;
  min-width: 80rpx;
}

.period {
  display: block;
  font-size: 24rpx;
  color: var(--text-color);
  font-weight: 500;
}

.time {
  display: block;
  font-size: 18rpx;
  color: var(--text-color-light);
}

.course-info {
  flex: 1;
}

.course-name {
  display: block;
  font-size: 26rpx;
  color: var(--text-color);
}

.course-teacher {
  display: block;
  font-size: 20rpx;
  color: var(--text-color-light);
}

.course-room {
  display: block;
  font-size: 20rpx;
  color: var(--text-color-light);
}

.course-status {
  font-size: 20rpx;
  color: var(--text-color-light);
  padding: 4rpx 12rpx;
  background: var(--border-color);
  border-radius: 8rpx;
}

.course-status.active {
  background: var(--success-color);
  color: var(--white);
}

.course-status.upcoming {
  background: var(--warning-color);
  color: var(--white);
}

.course-status.finished {
  background: var(--border-color);
  color: var(--text-color-light);
}

/* 生日列表 */
.birthday-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.birthday-item {
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  background: var(--background-color);
  border-radius: 12rpx;
  gap: 16rpx;
}

.birthday-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}

.birthday-info {
  flex: 1;
}

.birthday-name {
  display: block;
  font-size: 26rpx;
  color: var(--text-color);
  font-weight: 500;
}

.birthday-age {
  display: block;
  font-size: 20rpx;
  color: var(--text-color-light);
}

.birthday-wish {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a5a 100%);
  border-radius: 20rpx;
}

.wish-icon {
  font-size: 20rpx;
}

.wish-text {
  font-size: 22rpx;
  color: var(--white);
}

.reminder-empty, .reminder-loading {
  text-align: center;
  padding: 30rpx 0;
  color: var(--text-color-light);
  font-size: 24rpx;
}

/* 学生/家长功能导航卡片 */
.student-nav-card {
  background: var(--white);
  border-radius: 20rpx;
  padding: 24rpx 20rpx 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.nav-section-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-color);
}

.nav-title-bar {
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #667eea, #764ba2);
  border-radius: 3rpx;
  margin-right: 14rpx;
}

.nav-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.nav-entry {
  width: calc(33.33% - 8rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0 20rpx;
  border-radius: 16rpx;
  transition: all 0.2s;
}

.nav-entry:active {
  background: var(--background-color);
  transform: scale(0.95);
}

.nav-entry-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
  font-size: 40rpx;
}

.nav-entry-label {
  font-size: 22rpx;
  color: var(--text-color);
  white-space: nowrap;
}

/* 快捷操作区域 */
.quick-actions-section {
  background: var(--white);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 30rpx;
}

.quick-actions-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.quick-action-item {
  text-align: center;
  padding: 20rpx 10rpx;
  border-radius: 16rpx;
  transition: all 0.3s ease;
  position: relative;
}

.quick-action-item:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.quick-action-item.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.action-icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 15rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
}

.quick-action-item:active .action-icon-wrapper {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.action-icon-img {
  width: 50rpx;
  height: 50rpx;
}

.action-title {
  font-size: 24rpx;
  color: var(--text-color);
  font-weight: 500;
  line-height: 1.4;
}

.action-badge {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  background: var(--error-color);
  color: var(--white);
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  min-width: 30rpx;
  text-align: center;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 100rpx 0;
}

.loading-icon {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--background-color);
  border-top: 4rpx solid var(--primary-color);
  border-radius: 50%;
  margin: 0 auto 20rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-color-light);
}

/* 响应式布局 - 小屏幕适配 */
@media screen and (max-width: 375px) {
  .quick-actions-grid {
    grid-template-columns: repeat(3, 1fr);
  }
  
  .stat-grid-compact {
    gap: 10rpx;
  }
  
  .stat-value-compact {
    font-size: 32rpx;
  }
  
  .stat-label-compact {
    font-size: 20rpx;
  }
  
  .reminder-cards {
    flex-direction: column;
  }
  
  .action-icon-wrapper {
    width: 90rpx;
    height: 90rpx;
  }
  
  .action-icon-img {
    width: 45rpx;
    height: 45rpx;
  }
}

/* 响应式布局 - 超小屏幕适配 */
@media screen and (max-width: 320px) {
  .quick-actions-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 15rpx;
  }
  
  .stat-grid-compact {
    grid-template-columns: repeat(2, 1fr);
    gap: 10rpx;
  }
  
  .stat-item-compact {
    padding: 16rpx 8rpx;
  }
  
  .stat-value-compact {
    font-size: 28rpx;
  }
  
  .stat-grid {
    gap: 15rpx;
  }
  
  .stat-item {
    padding: 20rpx 15rpx;
  }
  
  .stat-value {
    font-size: 36rpx;
  }
  
  .weather-section {
    display: none;
  }
}

/* 响应式布局 - 大屏幕适配 */
@media screen and (min-width: 414px) {
  .quick-actions-grid {
    grid-template-columns: repeat(4, 1fr);
    gap: 25rpx;
  }
  
  .action-icon-wrapper {
    width: 110rpx;
    height: 110rpx;
  }
  
  .action-icon-img {
    width: 55rpx;
    height: 55rpx;
  }
}
