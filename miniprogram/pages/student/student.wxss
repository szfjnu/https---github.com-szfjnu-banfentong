/* pages/student/student.wxss */
.container {
  min-height: 100vh;
  background: var(--background-color);
  padding-bottom: 120rpx;
}

/* 班级功能导航 */
.class-nav {
  background: var(--white);
  padding: 24rpx 20rpx 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.class-nav-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-color);
}

.nav-title-bar {
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #667eea, #764ba2);
  border-radius: 3rpx;
  margin-right: 14rpx;
}

.class-nav-grid {
  display: flex;
  gap: 12rpx;
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0 20rpx;
  border-radius: 16rpx;
  transition: all 0.2s;
}

.nav-item:active {
  background: var(--background-color);
  transform: scale(0.95);
}

.nav-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}

.nav-icon {
  font-size: 40rpx;
}

.nav-label {
  font-size: 24rpx;
  color: var(--text-color);
  white-space: nowrap;
}

/* 筛选区域 */
.filter-section {
  background: var(--white);
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 搜索栏 */
.search-bar {
  margin-bottom: 20rpx;
}

.search-input {
  display: flex;
  align-items: center;
  background: var(--background-color);
  border-radius: 40rpx;
  padding: 20rpx 30rpx;
}

.search-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.search-input input {
  flex: 1;
  font-size: 28rpx;
}

.clear-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  gap: 15rpx;
}

.filter-item {
  flex: 1;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: var(--background-color);
  border-radius: 8rpx;
  font-size: 28rpx;
  color: var(--text-color);
}

.arrow {
  color: var(--text-color-light);
  font-size: 20rpx;
}

/* 学生列表 */
.student-list {
  padding: 0 20rpx;
}

.student-item {
  background: var(--white);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.student-main {
  display: flex;
  align-items: center;
  padding: 24rpx;
  transition: all 0.3s;
}

.student-main:active {
  background: var(--background-color);
}

/* 学生头像 */
.student-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 24rpx;
  background: var(--border-color);
}

.student-avatar image {
  width: 100%;
  height: 100%;
}

/* 学生信息 */
.student-info {
  flex: 1;
  min-width: 0;
}

.student-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.student-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
}

/* 标识徽章 */
.student-badges {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.student-badge {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.badge-position {
  background: #e6f7ff;
  color: var(--primary-color);
}

.badge-boarding {
  background: #fff7e6;
  color: #fa8c16;
}

.badge-group {
  background: #f6ffed;
  color: var(--success-color);
}

.student-meta {
  display: flex;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.meta-item {
  font-size: 24rpx;
  color: var(--text-color-light);
}

.student-score {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.score-left {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.score-label {
  font-size: 24rpx;
  color: var(--text-color-light);
}

.score-value {
  font-size: 32rpx;
  font-weight: bold;
}

.score-right {
  display: flex;
  align-items: center;
}

.score-level {
  font-size: 24rpx;
  color: var(--success-color);
  padding: 4rpx 12rpx;
  background: #f6ffed;
  border-radius: 6rpx;
}

/* 箭头 */
.student-arrow {
  font-size: 48rpx;
  color: var(--text-color-light);
  margin-left: 12rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-color-light);
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-icon {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border-color);
  border-top: 4rpx solid var(--primary-color);
  border-radius: 50%;
  margin-bottom: 20rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-color-light);
}

/* 添加按钮 */
.fab-button {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.4);
  z-index: 100;
}

.fab-button image {
  width: 48rpx;
  height: 48rpx;
}

/* 批量导入按钮 */
.import-button {
  position: fixed;
  left: 40rpx;
  bottom: 120rpx;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, var(--success-color) 0%, #389e0d 100%);
  padding: 20rpx 30rpx;
  border-radius: 50rpx;
  box-shadow: 0 4rpx 16rpx rgba(82, 196, 26, 0.4);
  z-index: 100;
}

.import-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.import-text {
  font-size: 26rpx;
  color: var(--white);
  font-weight: bold;
}

/* 积分重置按钮 */
.reset-button {
  position: fixed;
  left: 40rpx;
  bottom: 230rpx;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #722ed1 0%, #531dab 100%);
  padding: 20rpx 30rpx;
  border-radius: 50rpx;
  box-shadow: 0 4rpx 16rpx rgba(114, 46, 209, 0.4);
  z-index: 100;
}

.reset-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.reset-text {
  font-size: 26rpx;
  color: var(--white);
  font-weight: bold;
}

/* 响应式布局 - 小屏幕适配 */
@media screen and (max-width: 375px) {
  .filter-bar {
    flex-wrap: wrap;
  }

  .filter-item {
    width: calc(50% - 8rpx);
  }

  .filter-item:nth-child(3) {
    width: 100%;
  }

  .student-name {
    font-size: 30rpx;
  }

  .student-avatar {
    width: 80rpx;
    height: 80rpx;
  }
}

/* 响应式布局 - 超小屏幕适配 */
@media screen and (max-width: 320px) {
  .filter-item {
    width: 100%;
  }

  .student-header {
    flex-direction: column;
    align-items: flex-start;
  }

  .student-badges {
    margin-top: 8rpx;
  }
}
