<!--pages/score/score.wxml-->
<view class="container bg-page">
  <!-- 学生/家长视图：仅显示本人积分 -->
  <block wx:if="{{isStudentMode}}">
    <!-- 个人积分卡片 -->
    <view class="my-score-card radius-lg shadow-sm" wx:if="{{myScoreInfo}}">
      <view class="score-circle" style="background: {{myScoreInfo.scoreColor}}">
        <text class="score-number">{{myScoreInfo.current_score || 100}}</text>
        <text class="score-unit">分</text>
      </view>
      <view class="score-level-tag" style="background: {{myScoreInfo.scoreColor}}20; color: {{myScoreInfo.scoreColor}}">
        {{myScoreInfo.scoreLevel}}
      </view>
      <view class="rank-info">
        <view class="rank-item">
          <text class="rank-value">{{myRank}}</text>
          <text class="rank-label">班级排名</text>
        </view>
        <view class="rank-divider"></view>
        <view class="rank-item">
          <text class="rank-value">{{totalStudents}}</text>
          <text class="rank-label">班级总人数</text>
        </view>
      </view>
    </view>

    <!-- 功能入口 -->
    <view class="score-nav radius-lg shadow-sm">
      <view class="score-nav-title">
        <view class="nav-title-bar"></view>
        <text>积分服务</text>
      </view>
      <view class="score-nav-grid">
        <view class="nav-item" bindtap="onViewRecords">
          <view class="nav-icon-wrap" style="background: #1890ff15;">
            <text class="nav-icon">📋</text>
          </view>
          <text class="nav-label">积分明细</text>
        </view>
        <view class="nav-item" bindtap="onGoMall">
          <view class="nav-icon-wrap" style="background: #52c41a15;">
            <text class="nav-icon">🎁</text>
          </view>
          <text class="nav-label">积分商城</text>
        </view>
        <view class="nav-item" bindtap="onGoVolunteer">
          <view class="nav-icon-wrap" style="background: #722ed115;">
            <text class="nav-icon">🤝</text>
          </view>
          <text class="nav-label">志愿服务</text>
        </view>
        <view class="nav-item" bindtap="onGoDorm" wx:if="{{myScoreInfo && myScoreInfo.is_boarding}}">
          <view class="nav-icon-wrap" style="background: #fa8c1615;">
            <text class="nav-icon">🏠</text>
          </view>
          <text class="nav-label">住宿积分</text>
        </view>
        <view class="nav-item" bindtap="onViewRules">
          <view class="nav-icon-wrap" style="background: #eb2f9615;">
            <text class="nav-icon">📖</text>
          </view>
          <text class="nav-label">积分规则</text>
        </view>
      </view>
    </view>

    <!-- 前5名排行（学生/家长模式，仅自己可点击跳转） -->
    <view class="score-card radius-lg shadow-sm" wx:if="{{topStudents && topStudents.length > 0}}">
      <view class="card-title">班级积分排行（前5名）</view>
      <view class="ranking-list">
        <view
          class="ranking-item {{item.isSelf ? 'self-highlight' : 'no-tap'}}"
          wx:for="{{topStudents}}"
          wx:key="_id"
          bindtap="onViewDetail"
          data-id="{{item.student_id}}"
        >
          <view class="ranking-number {{index < 3 ? 'top-' + (index + 1) : ''}}">
            {{index + 1}}
          </view>
          <view class="student-avatar">
            <image src="/images/icons/default-avatar.png" mode="aspectFill"></image>
          </view>
          <view class="student-info min-w-0">
            <view class="student-name ellipsis">{{item.name}}<text wx:if="{{item.isSelf}}" class="self-tag">{{isParent ? '（我的孩子）' : '（我）'}}</text></view>
            <view class="student-meta">
              <text class="meta-item">{{item.student_id}}</text>
            </view>
          </view>
          <view class="score-info">
            <view class="score-value" style="color: {{item.scoreColor}}">
              {{item.current_score || 100}}
            </view>
            <view class="score-level">{{item.scoreLevel}}</view>
          </view>
          <view class="no-permission-hint" wx:if="{{!item.isSelf}}">
            <text class="hint-text">不可查看</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载状态 -->
    <view class="loading" wx:if="{{loading}}">
      <view class="loading-icon"></view>
      <view class="loading-text">加载中...</view>
    </view>
  </block>

  <!-- 管理员/教师视图：显示排行榜 -->
  <block wx:else>
    <!-- 功能入口 -->
    <view class="score-nav radius-lg shadow-sm">
      <view class="score-nav-title">
        <view class="nav-title-bar"></view>
        <text>积分管理</text>
      </view>
      <view class="score-nav-grid">
        <view class="nav-item" bindtap="onViewRecords">
          <view class="nav-icon-wrap" style="background: #1890ff15;">
            <text class="nav-icon">📋</text>
          </view>
          <text class="nav-label">积分记录</text>
        </view>
        <view class="nav-item" bindtap="onAddScore" wx:if="{{canAddScore}}">
          <view class="nav-icon-wrap" style="background: #52c41a15;">
            <text class="nav-icon">➕</text>
          </view>
          <text class="nav-label">添加积分</text>
        </view>
        <view class="nav-item" bindtap="onGoMall">
          <view class="nav-icon-wrap" style="background: #722ed115;">
            <text class="nav-icon">🎁</text>
          </view>
          <text class="nav-label">积分商城</text>
        </view>
        <view class="nav-item" bindtap="onManageRules">
          <view class="nav-icon-wrap" style="background: #fa8c1615;">
            <text class="nav-icon">📖</text>
          </view>
          <text class="nav-label">积分规则</text>
        </view>
        <view class="nav-item" bindtap="onManageExchange" wx:if="{{userRole === 'admin' || userRole === 'head_teacher'}}">
          <view class="nav-icon-wrap" style="background: #13c2c215;">
            <text class="nav-icon">⚙️</text>
          </view>
          <text class="nav-label">兑换管理</text>
        </view>
        <view class="nav-item" bindtap="onManageLedger" wx:if="{{userRole === 'admin' || userRole === 'head_teacher'}}">
          <view class="nav-icon-wrap" style="background: #eb2f9615;">
            <text class="nav-icon">📒</text>
          </view>
          <text class="nav-label">兑换台账</text>
        </view>
      </view>
    </view>

    <!-- 搜索栏 -->
    <view class="search-bar">
      <view class="search-input">
        <image class="search-icon" src="/images/icons/search.png" mode="aspectFit"></image>
        <input
          type="text"
          placeholder="搜索学号或姓名"
          value="{{searchKeyword}}"
          bindconfirm="onSearch"
          bindinput="onSearchInput"
        />
        <image
          class="clear-icon"
          wx:if="{{searchKeyword}}"
          src="/images/icons/clear.png"
          mode="aspectFit"
          bindtap="onClearSearch"
        ></image>
      </view>
    </view>

    <!-- 积分排行榜 -->
    <view class="score-card radius-lg shadow-sm">
      <view class="card-title">积分排行榜</view>
      <view class="ranking-list" wx:if="{{!loading && students.length > 0}}">
        <view
          class="ranking-item"
          wx:for="{{students}}"
          wx:key="_id"
          bindtap="onViewDetail"
          data-id="{{item.student_id}}"
        >
          <view class="ranking-number {{index < 3 ? 'top-' + (index + 1) : ''}}">
            {{index + 1}}
          </view>
          <view class="student-avatar">
            <image src="/images/icons/default-avatar.png" mode="aspectFill"></image>
          </view>
          <view class="student-info min-w-0">
            <view class="student-name ellipsis">{{item.name}}</view>
            <view class="student-meta">
              <text class="meta-item">{{item.student_id}}</text>
              <text class="meta-item">{{item.class_name}}</text>
            </view>
          </view>
          <view class="score-info">
            <view class="score-value" style="color: {{item.scoreColor}}">
              {{item.current_score || 100}}
            </view>
            <view class="score-level">{{item.scoreLevel}}</view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty" wx:if="{{!loading && students.length === 0}}">
        <image class="empty-icon" src="/images/icons/empty.png" mode="aspectFit"></image>
        <view class="empty-text">暂无积分数据</view>
      </view>

      <!-- 加载状态 -->
      <view class="loading" wx:if="{{loading}}">
        <view class="loading-icon"></view>
        <view class="loading-text">加载中...</view>
      </view>
    </view>
  </block>
</view>
