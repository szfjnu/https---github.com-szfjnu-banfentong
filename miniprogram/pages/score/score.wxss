/* pages/score/score.wxss */
.container {
  padding: 20rpx;
  background: var(--background-color);
  min-height: 100vh;
}

/* 积分功能导航 */
.score-nav {
  background: var(--white);
  padding: 24rpx 20rpx 8rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.score-nav-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-color);
}

.nav-title-bar {
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(180deg, var(--primary-color), var(--primary-color));
  border-radius: 3rpx;
  margin-right: 14rpx;
}

.score-nav-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.score-nav-grid .nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 16rpx;
  border-radius: 16rpx;
  transition: all 0.2s;
}

.score-nav-grid .nav-item:active {
  background: var(--background-color);
  transform: scale(0.95);
}

.nav-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}

.nav-icon {
  font-size: 40rpx;
}

.nav-label {
  font-size: 24rpx;
  color: var(--text-color);
  white-space: nowrap;
}

/* 操作按钮栏（保留用于旧引用） */
.action-bar {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 80rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color) 100%);
  color: var(--white);
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  padding: 0;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

.action-btn.primary {
  background: linear-gradient(135deg, var(--success-color) 0%, #73d13d 100%);
  box-shadow: 0 4rpx 12rpx rgba(82, 196, 26, 0.3);
}

.action-btn::after {
  border: none;
}

.btn-icon {
  width: 36rpx;
  height: 36rpx;
}

/* 搜索栏 */
.search-bar {
  margin-bottom: 20rpx;
}

.search-input {
  display: flex;
  align-items: center;
  background: var(--white);
  border-radius: 40rpx;
  padding: 20rpx 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.search-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.search-input input {
  flex: 1;
  font-size: 28rpx;
}

.clear-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 卡片 */
.score-card {
  background: var(--white);
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 30rpx;
}

/* 排行榜列表 */
.ranking-list {
  background: var(--white);
  border-radius: 16rpx;
  overflow: hidden;
}

.ranking-item {
  display: flex;
  align-items: center;
  padding: 30rpx 20rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.ranking-item:last-child {
  border-bottom: none;
}

/* 排名数字 */
.ranking-number {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--background-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-color-secondary);
  margin-right: 20rpx;
}

.ranking-number.top-1 {
  background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
  color: var(--white);
}

.ranking-number.top-2 {
  background: linear-gradient(135deg, #c0c0c0 0%, var(--border-color) 100%);
  color: var(--white);
}

.ranking-number.top-3 {
  background: linear-gradient(135deg, #cd7f32 0%, #e6a865 100%);
  color: var(--white);
}

/* 学生头像 */
.student-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 20rpx;
}

.student-avatar image {
  width: 100%;
  height: 100%;
}

/* 学生信息 */
.student-info {
  flex: 1;
  min-width: 0;
}

.student-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 8rpx;
}

.student-meta {
  display: flex;
  gap: 20rpx;
}

.meta-item {
  font-size: 24rpx;
  color: var(--text-color-light);
}

/* 积分信息 */
.score-info {
  text-align: right;
}

.score-value {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.score-level {
  font-size: 24rpx;
  color: var(--text-color-light);
  padding: 4rpx 12rpx;
  background: var(--background-color);
  border-radius: 6rpx;
  display: inline-block;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-color-light);
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 100rpx 0;
}

.loading-icon {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border-color);
  border-top: 4rpx solid var(--primary-color);
  border-radius: 50%;
  margin: 0 auto 20rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-color-light);
}

/* 管理功能区 */
.admin-section {
  background: var(--white);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 20rpx;
}

.admin-btns {
  display: flex;
  gap: 20rpx;
}

.admin-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  background: #f6f8fa;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--text-color);
}

.admin-btn:active {
  background: #eef0f2;
}

.btn-icon-text {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

/* 学生个人积分卡片 */
.my-score-card {
  background: var(--white);
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.score-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color) 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.3);
}

.score-number {
  font-size: 64rpx;
  font-weight: bold;
  color: var(--white);
}

.score-unit {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.score-level-tag {
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 30rpx;
}

.rank-info {
  display: flex;
  align-items: center;
  width: 100%;
  justify-content: center;
}

.rank-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 40rpx;
}

.rank-value {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--primary-color);
}

.rank-label {
  font-size: 24rpx;
  color: var(--text-color-light);
  margin-top: 8rpx;
}

.rank-divider {
  width: 1rpx;
  height: 60rpx;
  background: var(--border-color);
}

/* 学生快捷入口 */
.student-shortcuts {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.shortcut-item {
  flex: 1;
  min-width: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx 10rpx;
  background: var(--white);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.shortcut-item:active {
  background: var(--background-color);
}

.shortcut-icon {
  font-size: 44rpx;
  margin-bottom: 10rpx;
}

.shortcut-text {
  font-size: 24rpx;
  color: var(--text-color);
}

/* 排行榜权限控制样式 */
.ranking-item.disabled {
  opacity: 0.5;
  position: relative;
}

.ranking-item.disabled:active {
  background: var(--white);
}

.no-permission-mask {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  background: rgba(255, 77, 79, 0.1);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.no-permission-text {
  font-size: 20rpx;
  color: #ff4d4f;
}

/* 学生模式自身高亮 */
.ranking-item.self-highlight {
  background: rgba(24, 144, 255, 0.06);
  border-left: 6rpx solid var(--primary-color);
}

.ranking-item.no-tap {
  opacity: 0.7;
}

.ranking-item.no-tap:active {
  background: var(--white);
}

.no-permission-hint {
  position: absolute;
  right: 10rpx;
  top: 50%;
  transform: translateY(-50%);
}

.hint-text {
  font-size: 20rpx;
  color: var(--text-color-light);
}

.self-tag {
  font-size: 22rpx;
  color: var(--primary-color);
  margin-left: 8rpx;
}
