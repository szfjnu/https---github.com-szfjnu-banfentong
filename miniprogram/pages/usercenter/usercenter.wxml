<!-- pages/usercenter/usercenter.wxml -->
<view class="container bg-page">
  <!-- 用户信息头部 -->
  <view class="user-header">
    <view class="user-info">
      <view class="avatar-wrap">
        <image class="avatar" src="{{userInfo.avatarUrl || '/images/icons/default-avatar.png'}}" mode="aspectFill" />
        <view class="role-badge">{{roleLabel}}</view>
      </view>
      <view class="user-detail min-w-0">
        <text class="nickname ellipsis">{{userInfo.nickName || userInfo.name || '未设置'}}</text>
        <text class="class-name ellipsis" wx:if="{{className}}">{{className}}</text>
        <view class="member-tag member-{{membershipLevel}}" wx:if="{{membershipLevel !== 'free'}}">
          {{membershipLevel === 'pro' ? '专业版' : membershipLevel === 'basic' ? '基础版' : membershipLevel === 'enterprise' ? '企业版' : ''}}
        </view>
      </view>
    </view>
    <view class="notification-entry" bindtap="onMenuItemTap" data-id="notifications" data-url="/subPages/usercenter/notifications/notifications">
      <image class="notification-icon" src="/images/icons/notification.png" mode="aspectFit" />
      <view class="notification-badge" wx:if="{{unreadCount > 0}}">
        {{unreadCount > 99 ? '99+' : unreadCount}}
      </view>
    </view>
  </view>

  <!-- 菜单组 -->
  <view class="menu-section" wx:for="{{menuGroups}}" wx:key="title">
    <view class="section-title">{{item.title}}</view>
    <view class="menu-list radius-lg shadow-sm">
      <view class="menu-item {{child.disabled ? 'disabled' : ''}}"
            wx:for="{{item.items}}" wx:for-item="child" wx:key="id"
            bindtap="onMenuItemTap"
            data-id="{{child.id}}"
            data-url="{{child.url}}"
            data-disabled="{{child.disabled}}">
        <view class="menu-left">
          <view class="menu-icon" style="background: {{child.color}}20;">
            <text class="icon-emoji">{{child.icon}}</text>
          </view>
          <view class="menu-text min-w-0">
            <text class="menu-title ellipsis">{{child.title}}</text>
            <text class="menu-desc ellipsis" wx:if="{{child.desc}}">{{child.desc}}</text>
          </view>
        </view>
        <view class="menu-right">
          <view class="menu-badge" wx:if="{{child.badge > 0}}">
            {{child.badge > 99 ? '99+' : child.badge}}
          </view>
          <view class="coming-soon" wx:if="{{child.disabled}}">即将上线</view>
          <text class="arrow" wx:elif="{{child.url}}">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <button class="logout-btn radius-lg" bindtap="onLogout">退出登录</button>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    <text>学生成长管理系统 v2.5</text>
    <text class="version-sub">新增：成绩管理 · 微聊陪伴 · 心灵树洞 · 英雄台 · 校园闲鱼 · 聚光点</text>
  </view>
</view>
