.growth-page {
  padding: 20rpx 30rpx;
  min-height: 100vh;
  background: #f5f7fa;
}

.loading-wrap {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
}

.tab-item.active {
  color: #667eea;
  border-bottom-color: #667eea;
  font-weight: bold;
}

.section {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.chart-canvas {
  width: 100%;
  height: 400rpx;
}

.stat-row {
  display: flex;
  gap: 24rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #667eea;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.list-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.list-level {
  font-size: 24rpx;
  color: #ff4d4f;
  background: #fff2f0;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
}

.list-reason {
  font-size: 26rpx;
  color: #333;
}

.list-name {
  font-size: 26rpx;
  color: #333;
}

.ai-section {
  border-left: 6rpx solid #667eea;
}

.ai-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
}

.generate-btn {
  margin: 20rpx 0;
  padding: 20rpx;
  background: #667eea;
  color: #fff;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
}

.generate-btn.disabled {
  opacity: 0.5;
}

.report-content, .comment-content {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
}

.empty-tip {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #999;
}

.style-selector {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.style-btn {
  padding: 10rpx 24rpx;
  border: 1rpx solid #ddd;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #666;
}

.style-btn.active {
  background: #667eea;
  color: #fff;
  border-color: #667eea;
}

.warning-item {
  padding: 16rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.warning-item.high {
  background: #fff2f0;
  border-left: 6rpx solid #ff4d4f;
}

.warning-item.medium {
  background: #fffbe6;
  border-left: 6rpx solid #faad14;
}

.warning-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 4rpx;
}

.warning-msg {
  font-size: 26rpx;
  color: #666;
}

.rec-group {
  margin-bottom: 20rpx;
}

.rec-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 12rpx;
  display: block;
}

.rec-item {
  padding: 16rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.rec-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 4rpx;
}

.rec-reason {
  display: block;
  font-size: 24rpx;
  color: #666;
}

.rec-score {
  display: block;
  font-size: 22rpx;
  color: #52c41a;
  margin-top: 4rpx;
}

.action-bar {
  margin-top: 20rpx;
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  padding: 20rpx;
  background: #fff;
  border: 1rpx solid #667eea;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: #667eea;
}

.no-class-tip {
  text-align: center;
  padding: 120rpx 40rpx;
}

.no-class-text {
  font-size: 28rpx;
  color: #999;
}

.class-picker {
  padding: 20rpx 0;
}

.class-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.class-name {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.class-role {
  font-size: 24rpx;
  color: #667eea;
  background: #f0f3ff;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.student-picker {
  padding: 20rpx 0;
}

.student-count {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.student-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.student-name {
  font-size: 30rpx;
  color: #333;
}

.score-trend-section {
  margin-bottom: 20rpx;
}

.score-trend-chart {
  width: 100%;
  height: 400rpx;
}

.report-text-block {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
}

.report-chart-block {
  margin: 20rpx 0;
  padding: 40rpx;
  background: #f0f3ff;
  border-radius: 8rpx;
  text-align: center;
}

.chart-placeholder {
  font-size: 26rpx;
  color: #667eea;
}

.student-search {
  margin-bottom: 16rpx;
}

.search-input {
  padding: 16rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.search-results {
  max-height: 300rpx;
  overflow-y: auto;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.search-item {
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.selected-student {
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #667eea;
}

.student-check-list {
  max-height: 400rpx;
  overflow-y: auto;
  margin-bottom: 16rpx;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  padding: 12rpx;
}

.check-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.check-action-btn {
  padding: 6rpx 20rpx;
  border: 1rpx solid #667eea;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #667eea;
}

.checked-count {
  font-size: 24rpx;
  color: #999;
}

.student-check-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 8rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.check-box {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #ddd;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.check-box.checked {
  background: #667eea;
  border-color: #667eea;
}

.check-name {
  font-size: 28rpx;
  color: #333;
}

.batch-results {
  margin-top: 20rpx;
}

.batch-result-item {
  padding: 20rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.batch-result-fail {
  background: #fff2f0;
}

.batch-result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.batch-result-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.batch-result-status {
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
}

.batch-result-status.success {
  color: #52c41a;
  background: #f6ffed;
}

.batch-result-status.fail {
  color: #ff4d4f;
  background: #fff2f0;
}

.batch-result-content {
  font-size: 26rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
}

.comment-edit-area {
  margin-top: 20rpx;
}

.comment-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  box-sizing: border-box;
}

.comment-actions {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  gap: 16rpx;
}

.save-btn {
  padding: 10rpx 24rpx;
  background: #667eea;
  color: #fff;
  border-radius: 20rpx;
  font-size: 26rpx;
}

.modified-tag {
  font-size: 22rpx;
  color: #faad14;
  background: #fffbe6;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
}

.ai-original {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.ai-label {
  display: block;
  color: #999;
  margin-bottom: 4rpx;
}

.warning-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.config-btn {
  flex: 1;
  padding: 20rpx;
  background: #fff;
  border: 1rpx solid #667eea;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: #667eea;
}

.warning-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4rpx;
}

.warning-status {
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
}

.warning-status.pending {
  color: #faad14;
  background: #fffbe6;
}

.warning-status.confirmed {
  color: #1890ff;
  background: #e6f7ff;
}

.warning-status.resolved {
  color: #52c41a;
  background: #f6ffed;
}

.warning-ops {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
}

.op-btn {
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
}

.op-btn.confirm {
  background: #e6f7ff;
  color: #1890ff;
  border: 1rpx solid #91d5ff;
}

.op-btn.resolve {
  background: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #b7eb8f;
}

.rec-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 4rpx;
}

.feedback-btn {
  font-size: 22rpx;
  color: #999;
  text-decoration: underline;
}
