/* 发现页面 - 成长探索 */

.discover-container {
  min-height: 100vh;
  background: var(--background-color);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 顶部 Banner */
.discover-header {
  position: relative;
  height: 240rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 56rpx 32rpx 32rpx;
  color: var(--white);
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.header-subtitle {
  font-size: 26rpx;
  opacity: 0.85;
}

/* 功能分组 */
.feature-groups {
  padding: 0 24rpx;
  margin-top: -20rpx;
  position: relative;
  z-index: 2;
}

.feature-group {
  margin-bottom: 32rpx;
}

.group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.group-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.group-indicator {
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #667eea, #764ba2);
  border-radius: 3rpx;
}

.group-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-color);
}

.group-subtitle {
  font-size: 24rpx;
  color: var(--text-color-light);
}

/* 功能卡片网格 */
.feature-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.feature-card {
  display: flex;
  align-items: center;
  background: var(--white);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.2s, box-shadow 0.2s;
}

.feature-card:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.06);
}

.feature-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.feature-icon {
  font-size: 42rpx;
}

.feature-info {
  flex: 1;
  min-width: 0;
}

.feature-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-color);
  display: block;
  margin-bottom: 6rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: var(--text-color-light);
  display: block;
}

.feature-arrow {
  font-size: 36rpx;
  color: var(--border-color);
  margin-left: 12rpx;
  font-weight: 300;
}

/* 底部留白 */
.bottom-space {
  height: 40rpx;
}
