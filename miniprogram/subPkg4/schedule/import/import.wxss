.import-page {
  padding: 20rpx 30rpx;
  min-height: 100vh;
  background: #f5f7fa;
}

.info-section {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.info-text {
  font-size: 26rpx;
  color: #666;
}

.type-selector {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
}

.type-label {
  font-size: 28rpx;
  color: #333;
  white-space: nowrap;
}

.type-options {
  display: flex;
  gap: 16rpx;
  flex: 1;
}

.type-option {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
}

.type-option.active {
  color: #667eea;
  border-color: #667eea;
  background: #f0f3ff;
  font-weight: bold;
}

.input-section {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.sample-btn {
  font-size: 24rpx;
  color: #667eea;
  padding: 6rpx 16rpx;
  border: 1rpx solid #667eea;
  border-radius: 20rpx;
}

.json-input {
  width: 100%;
  min-height: 300rpx;
  max-height: 600rpx;
  padding: 16rpx;
  font-size: 24rpx;
  font-family: monospace;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  background: #fafafa;
  box-sizing: border-box;
}

.action-section {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
}

.validate-btn {
  background: #667eea;
}

.import-btn {
  background: #52c41a;
}

.fix-btn {
  background: #faad14;
  color: #333;
}

.action-btn.disabled {
  opacity: 0.5;
}

.preview {
  background: #f6ffed;
  border: 1rpx solid #b7eb8f;
  border-radius: 8rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
}

.preview-text {
  font-size: 26rpx;
  color: #52c41a;
}

.error-section {
  background: #fff2f0;
  border: 1rpx solid #ffccc7;
  border-radius: 8rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
}

.error-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #ff4d4f;
  display: block;
  margin-bottom: 8rpx;
}

.error-item {
  font-size: 24rpx;
  color: #ff4d4f;
  padding: 4rpx 0;
}

.result-section {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-top: 20rpx;
}

.result-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.result-summary {
  display: flex;
  gap: 30rpx;
  padding: 16rpx 0;
}

.result-success {
  font-size: 28rpx;
  color: #52c41a;
}

.result-failed {
  font-size: 28rpx;
  color: #ff4d4f;
}

.fail-details {
  padding-top: 16rpx;
  border-top: 1rpx solid #eee;
}

.fail-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}

.fail-item {
  font-size: 24rpx;
  color: #ff4d4f;
  padding: 4rpx 0;
}

.result-btn {
  margin-top: 20rpx;
  padding: 16rpx;
  background: #667eea;
  color: #fff;
  border-radius: 40rpx;
  text-align: center;
  font-size: 28rpx;
}

.method-tabs {
  display: flex;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.method-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.method-tab.active {
  color: #667eea;
  font-weight: bold;
  background: #f0f3ff;
}

.method-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 30%;
  right: 30%;
  height: 4rpx;
  background: #667eea;
  border-radius: 2rpx;
}

.method-tab.disabled {
  opacity: 0.5;
}

.vip-tag {
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  background: linear-gradient(135deg, #faad14, #fa8c16);
  color: #fff;
  border-radius: 4rpx;
  font-weight: normal;
}

.excel-section {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.excel-choose-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 24rpx 48rpx;
  background: #f0f3ff;
  border: 2rpx dashed #667eea;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #667eea;
}

.excel-icon {
  font-size: 36rpx;
}

.excel-hint {
  font-size: 24rpx;
  color: #999;
}

.result-skip {
  font-size: 28rpx;
  color: #faad14;
}
