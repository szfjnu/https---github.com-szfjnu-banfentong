.rotate-page {
  padding: 20rpx 30rpx;
  min-height: 100vh;
  background: var(--background-color);
}

.section {
  background: var(--white);
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 16rpx;
}

.picker-btn {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 8rpx;
  font-size: 28rpx;
  color: var(--text-color);
}

.arrow {
  font-size: 20rpx;
  color: var(--text-color-light);
}

.step-input {
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 8rpx;
  font-size: 28rpx;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--white);
}

.save-btn {
  background: #667eea;
}

.rotate-btn {
  background: var(--success-color);
}

.action-btn.disabled {
  opacity: 0.5;
}

.grid-section {
  background: var(--white);
  border-radius: 12rpx;
  padding: 24rpx;
}

.no-data {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-color-light);
  font-size: 28rpx;
}
