.layout-page {
  padding: 20rpx 30rpx;
  min-height: 100vh;
  background: var(--background-color);
}

.section {
  background: var(--white);
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 16rpx;
}

.input-row {
  display: flex;
  gap: 30rpx;
}

.input-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.input-label {
  font-size: 28rpx;
  color: var(--text-color-secondary);
}

.input-field {
  flex: 1;
  padding: 12rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 8rpx;
  font-size: 28rpx;
}

.input-hint {
  font-size: 22rpx;
  color: var(--text-color-light);
  margin-top: 8rpx;
  display: block;
}

.special-btns {
  display: flex;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.sp-btn {
  padding: 10rpx 24rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 20rpx;
  font-size: 26rpx;
  color: var(--text-color-secondary);
}

.sp-btn.active {
  background: #667eea;
  color: var(--white);
  border-color: #667eea;
}

.special-toggles {
  margin-bottom: 12rpx;
}

.sp-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.sp-row:last-child {
  border-bottom: none;
}

.sp-label {
  font-size: 28rpx;
  color: var(--text-color);
}

.hint-text {
  font-size: 22rpx;
  color: var(--text-color-light);
}

.save-btn {
  margin-top: 30rpx;
  padding: 24rpx;
  background: #667eea;
  color: var(--white);
  border-radius: 12rpx;
  text-align: center;
  font-size: 30rpx;
}

.save-btn.disabled {
  opacity: 0.5;
}
