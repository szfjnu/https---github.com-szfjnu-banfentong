.seat-page {
  padding: 20rpx 30rpx;
  min-height: 100vh;
  background: var(--background-color);
}

.loading-wrap {
  text-align: center;
  padding: 100rpx 0;
  color: var(--text-color-light);
}

.no-layout, .no-arrangement {
  text-align: center;
  padding: 80rpx 0;
}

.no-text {
  font-size: 28rpx;
  color: var(--text-color-light);
  display: block;
  margin-bottom: 30rpx;
}

.action-btn {
  display: inline-block;
  padding: 16rpx 40rpx;
  background: #667eea;
  color: var(--white);
  border-radius: 40rpx;
  font-size: 28rpx;
}

.toolbar {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 0;
  overflow-x: auto;
  margin-bottom: 16rpx;
}

.tool-btn {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  background: var(--white);
  border: 1rpx solid #667eea;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #667eea;
}

.tool-btn-danger {
  border-color: var(--error-color);
  color: var(--error-color);
}

.grid-section {
  background: var(--white);
  border-radius: 12rpx;
  padding: 20rpx;
}
