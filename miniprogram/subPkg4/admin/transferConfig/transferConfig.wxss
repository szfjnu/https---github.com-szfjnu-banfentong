.container {
  min-height: 100vh;
  background: var(--background-color, #f5f5f5);
  padding-bottom: 120rpx;
}

.section-title {
  padding: 30rpx 30rpx 10rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color, #333);
}

.desc {
  padding: 0 30rpx 20rpx;
  font-size: 24rpx;
  color: var(--text-color-secondary, #666);
}

.config-list {
  background: var(--white, #fff);
  border-radius: 16rpx;
  margin: 0 24rpx;
  overflow: hidden;
}

.config-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid var(--border-color, #eee);
}

.config-item:last-child {
  border-bottom: none;
}

.config-info {
  flex: 1;
  margin-right: 20rpx;
}

.config-label {
  font-size: 30rpx;
  color: var(--text-color, #333);
  display: block;
  margin-bottom: 6rpx;
}

.config-desc {
  font-size: 22rpx;
  color: var(--text-color-light, #999);
}

.save-area {
  padding: 40rpx 30rpx;
}

.save-btn {
  background: var(--primary-color, #1890ff);
  color: var(--white, #fff);
  border-radius: 16rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-color-light, #999);
  padding: 0 30rpx;
}