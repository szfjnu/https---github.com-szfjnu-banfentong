.ds-list-item {
  width: 100%;
}

.ds-list-item--clickable:active {
  background: var(--background-color, #f5f5f5);
}

.ds-list-item__content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
}

.ds-list-item__main {
  flex: 1;
  min-width: 0;
}

.ds-list-item__title {
  display: block;
  font-size: var(--font-size-md, 28rpx);
  color: var(--text-color, #333333);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ds-list-item__desc {
  display: block;
  font-size: var(--font-size-sm, 24rpx);
  color: var(--text-color-light, #999999);
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ds-list-item__extra {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.ds-list-item__extra-text {
  font-size: var(--font-size-sm, 24rpx);
  color: var(--text-color-light, #999999);
}

.ds-list-item__arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid var(--text-color-light, #999999);
  border-right: 4rpx solid var(--text-color-light, #999999);
  transform: rotate(45deg);
  margin-left: 8rpx;
}

.ds-list-item__divider {
  height: 2rpx;
  background: var(--border-color, #e8e8e8);
}
