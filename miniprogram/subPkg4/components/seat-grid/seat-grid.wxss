.seat-grid-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.seat-canvas {
  position: absolute;
  left: -9999px;
}

.grid-container {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.podium-row {
  margin-bottom: 8rpx;
}

.podium-bar {
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: bold;
  letter-spacing: 12rpx;
}

.door-row {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.door-left {
  flex-shrink: 0;
}

.door-right {
  flex-shrink: 0;
}

.door-spacer {
  flex: 1;
}

.door-label {
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  writing-mode: horizontal-tb;
}

.grid-row {
  display: flex;
  gap: 4rpx;
}

.grid-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #ddd;
  border-radius: 4rpx;
  background: #fff;
  position: relative;
  overflow: hidden;
  padding: 2rpx;
}

.grid-cell.male {
  background: #e3f2fd;
  border-color: #90caf9;
}

.grid-cell.female {
  background: #fce4ec;
  border-color: #f48fb1;
}

.grid-cell.empty {
  background: #f5f5f5;
}

.grid-cell.locked {
  border-color: #81c784;
}

.grid-cell.highlight {
  background: #e3f2fd;
  border-color: #42a5f5;
  box-shadow: 0 0 8rpx rgba(66, 165, 245, 0.4);
}

.grid-cell.male.highlight {
  background: #bbdefb;
}

.grid-cell.female.highlight {
  background: #f8bbd0;
}

.cell-name {
  font-size: 20rpx;
  color: #333;
  font-weight: bold;
  text-overflow: ellipsis;
  white-space: nowrap;
  overflow: hidden;
  max-width: 100%;
}

.cell-seat-no {
  font-size: 16rpx;
  color: #999;
}

.cell-seat-no-empty {
  font-size: 16rpx;
  color: #ccc;
}

.cell-info {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.cell-height {
  font-size: 16rpx;
  color: #888;
}

.cell-score {
  font-size: 16rpx;
  color: #1890ff;
}

.cell-group {
  font-size: 14rpx;
  color: #52c41a;
  max-width: 100%;
  text-overflow: ellipsis;
  white-space: nowrap;
  overflow: hidden;
}

.cell-lock {
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  font-size: 14rpx;
}

.cell-empty {
  font-size: 28rpx;
  color: #bbb;
}

.legend {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
  justify-content: center;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #666;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
}

.legend-dot.male {
  background: #e3f2fd;
  border: 1rpx solid #90caf9;
}

.legend-dot.female {
  background: #fce4ec;
  border: 1rpx solid #f48fb1;
}

.grid-cell.drag-source-ghost {
  opacity: 0.3;
  border: 2rpx dashed #999;
  background: #f0f0f0;
}

.grid-cell.drag-target-valid {
  border: 3rpx solid var(--primary-color, #1890ff);
  background: #e6f7ff;
  box-shadow: 0 0 12rpx rgba(24, 144, 255, 0.3);
  transition: all 0.15s ease;
}

.grid-cell.drag-target-invalid {
  border: 3rpx solid var(--error-color, #ff4d4f);
  background: #fff1f0;
  box-shadow: 0 0 12rpx rgba(255, 77, 79, 0.3);
  transition: all 0.15s ease;
}

.drag-float {
  position: fixed;
  z-index: 999;
  background: #fff;
  border-radius: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  transform: scale(1.1);
  pointer-events: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 12rpx;
  min-width: 80rpx;
  min-height: 60rpx;
}

.drag-float.male {
  background: #e3f2fd;
  border: 2rpx solid #90caf9;
}

.drag-float.female {
  background: #fce4ec;
  border: 2rpx solid #f48fb1;
}

.drag-float-name {
  font-size: 22rpx;
  font-weight: bold;
  color: #333;
}

.drag-float-gender {
  font-size: 18rpx;
  color: #666;
}

.drag-float-target {
  margin-top: 6rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.drag-float-target-arrow {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 10rpx solid rgba(24, 144, 255, 0.9);
}

.drag-float-target-body {
  background: rgba(24, 144, 255, 0.9);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
  white-space: nowrap;
}

.drag-float-target-label {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.85);
}

.drag-float-target-seat {
  font-size: 22rpx;
  font-weight: bold;
  color: #fff;
}

.drag-float-target-name {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.85);
}

.drag-target-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(24, 144, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 4rpx;
  animation: drag-target-pulse 0.8s ease-in-out infinite alternate;
}

.drag-target-overlay-text {
  font-size: 20rpx;
  font-weight: bold;
  color: var(--primary-color, #1890ff);
  text-shadow: 0 1rpx 4rpx rgba(255, 255, 255, 0.8);
}

@keyframes drag-target-pulse {
  from { background: rgba(24, 144, 255, 0.2); }
  to { background: rgba(24, 144, 255, 0.4); }
}
