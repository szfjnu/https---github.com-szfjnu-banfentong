<view class="seat-grid-wrap">
  <canvas type="2d" id="seatCanvas" class="seat-canvas" style="width:0;height:0;position:absolute;left:-9999px;"></canvas>

  <view class="grid-container" style="width:{{cols * cellSize}}px;">
    <view class="podium-row" wx:if="{{hasPodium}}">
      <view class="podium-bar">讲 台</view>
    </view>

    <view class="door-row" wx:if="{{hasFrontDoor || hasBackDoor}}">
      <view class="door-left" wx:if="{{hasFrontDoor}}">
        <text class="door-label">前门</text>
      </view>
      <view class="door-spacer"></view>
      <view class="door-right" wx:if="{{hasBackDoor}}">
        <text class="door-label">后门</text>
      </view>
    </view>

    <view class="grid-row" wx:for="{{gridData}}" wx:key="row" wx:for-item="rowArr" wx:for-index="rowIdx">
      <view
        class="grid-cell {{item.genderClass}} {{item.isEmpty ? 'empty' : ''}} {{item.isLocked ? 'locked' : ''}} {{item.isHighlight ? 'highlight' : ''}} {{isDragging && dragSourceKey === item.key ? 'drag-source-ghost' : ''}} {{isDragging && dragTargetKey === item.key && isTargetValid ? 'drag-target-valid' : ''}} {{isDragging && dragTargetKey === item.key && !isTargetValid ? 'drag-target-invalid' : ''}}"
        wx:for="{{rowArr}}" wx:key="col"
        style="width:{{cellSize}}px; height:{{cellSize * 1.15}}px;"
        bindtap="onSeatTap"
        bindlongpress="{{enableDrag ? '' : 'onSeatLongPress'}}"
        bindtouchstart="onDragTouchStart"
        bindtouchmove="onDragTouchMove"
        bindtouchend="onDragTouchEnd"
        bindtouchcancel="onDragTouchCancel"
        data-row="{{item.row}}"
        data-col="{{item.col}}"
      >
        <block wx:if="{{item.studentName}}">
          <text class="cell-seat-no">{{item.seatNo}}</text>
          <text class="cell-name">{{item.studentName}}</text>
          <text class="cell-score" wx:if="{{item.score !== undefined && item.score !== null}}">{{item.score}}分</text>
          <text class="cell-group" wx:if="{{item.groupName}}">{{item.groupName}}</text>
          <text class="cell-lock" wx:if="{{item.isLocked}}">🔒</text>
        </block>
        <text class="cell-empty" wx:elif="{{item.isEmpty && mode !== 'view'}}">+</text>
        <text class="cell-seat-no-empty" wx:elif="{{item.isEmpty}}">{{item.seatNo}}</text>
        <view class="drag-target-overlay" wx:if="{{isDragging && dragTargetKey === item.key && isTargetValid}}">
          <text class="drag-target-overlay-text">{{dragTargetStudentName ? '交换' : '放此'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view
    class="drag-float {{dragSourceCell.genderClass}}"
    wx:if="{{isDragging && dragSourceCell}}"
    style="left:{{dragFloatX}}px; top:{{dragFloatY}}px; opacity:{{dragFloatOpacity}};"
  >
    <text class="drag-float-name">{{dragSourceCell.studentName}}</text>
    <text class="drag-float-gender">{{dragSourceCell.gender}}</text>
    <view class="drag-float-target" wx:if="{{dragTargetSeatNo}}">
      <view class="drag-float-target-arrow"></view>
      <view class="drag-float-target-body">
        <text class="drag-float-target-label">放到</text>
        <text class="drag-float-target-seat">{{dragTargetSeatNo}}</text>
        <text class="drag-float-target-name" wx:if="{{dragTargetStudentName}}">({{dragTargetStudentName}})</text>
      </view>
    </view>
  </view>

  <view class="legend" wx:if="{{mode !== 'layout'}}">
    <view class="legend-item"><view class="legend-dot male"></view><text>男生</text></view>
    <view class="legend-item"><view class="legend-dot female"></view><text>女生</text></view>
  </view>
</view>