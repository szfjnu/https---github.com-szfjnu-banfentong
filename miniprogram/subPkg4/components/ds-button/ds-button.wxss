.ds-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md, 8rpx);
  font-weight: 500;
  line-height: 1;
  box-sizing: border-box;
  padding: 0 32rpx;
  border: none;
  background: none;
  transition: opacity 0.2s;
}

.ds-button::after {
  border: none;
}

.ds-button--sm {
  height: 56rpx;
  font-size: var(--font-size-sm, 24rpx);
  padding: 0 20rpx;
  border-radius: var(--radius-sm, 6rpx);
}

.ds-button--md {
  height: 72rpx;
  font-size: var(--font-size-md, 28rpx);
  padding: 0 32rpx;
  border-radius: var(--radius-md, 8rpx);
}

.ds-button--lg {
  height: 88rpx;
  font-size: var(--font-size-lg, 32rpx);
  padding: 0 40rpx;
  border-radius: var(--radius-lg, 12rpx);
}

.ds-button--block {
  display: flex;
  width: 100%;
}

.ds-button--primary {
  background: var(--primary-color);
  color: #ffffff;
}

.ds-button--success {
  background: var(--success-color, #52c41a);
  color: #ffffff;
}

.ds-button--warning {
  background: var(--warning-color, #faad14);
  color: #ffffff;
}

.ds-button--danger {
  background: var(--danger-color, #ff4d4f);
  color: #ffffff;
}

.ds-button--default {
  background: var(--background-color, #f5f5f5);
  color: var(--text-color, #333333);
  border: 2rpx solid var(--border-color, #d9d9d9);
}

.ds-button--text {
  background: transparent;
  color: var(--primary-color);
}

.ds-button--disabled {
  opacity: 0.5;
  pointer-events: none;
}

.ds-button--loading {
  pointer-events: none;
}

.ds-button__loading {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin-right: 8rpx;
}

.ds-button__loading-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
  animation: ds-button-loading-bounce 1s infinite ease-in-out both;
}

.ds-button__loading-dot:nth-child(1) {
  animation-delay: 0s;
}

.ds-button__loading-dot:nth-child(2) {
  animation-delay: 0.16s;
}

.ds-button__loading-dot:nth-child(3) {
  animation-delay: 0.32s;
}

@keyframes ds-button-loading-bounce {
  0%, 80%, 100% {
    transform: scale(0.4);
    opacity: 0.4;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}
