.student-picker {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
}

.picker-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.picker-search {
  margin-bottom: 16rpx;
}

.search-input {
  padding: 12rpx 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 26rpx;
  background: #f5f5f5;
}

.picker-group {
  margin-bottom: 16rpx;
}

.group-picker-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.arrow {
  font-size: 20rpx;
}

.picker-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.student-item {
  display: flex;
  align-items: center;
  padding: 16rpx 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.student-item.selected {
  background: #e3f2fd;
}

.student-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.student-group {
  font-size: 22rpx;
  color: #999;
  margin-right: 12rpx;
}

.select-mark {
  color: #1976d2;
  font-size: 28rpx;
  font-weight: bold;
}

.empty-tip {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #999;
}
