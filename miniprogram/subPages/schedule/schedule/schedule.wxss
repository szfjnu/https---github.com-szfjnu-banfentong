.schedule-page {
  padding-bottom: 120rpx;
  min-height: 100vh;
  background: #f5f7fa;
}

.week-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 30rpx;
  background: #fff;
}

.week-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #667eea;
}

.week-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.week-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.current-week-btn {
  font-size: 24rpx;
  color: #667eea;
  padding: 4rpx 16rpx;
  border: 1rpx solid #667eea;
  border-radius: 20rpx;
}

.view-switch {
  display: flex;
  justify-content: center;
  padding: 10rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.switch-item {
  padding: 8rpx 32rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 24rpx;
}

.switch-item.active {
  color: #fff;
  background: #667eea;
}

.view-type-switch {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  padding: 16rpx 30rpx;
  background: #fff;
}

.type-item {
  padding: 8rpx 28rpx;
  font-size: 26rpx;
  color: #666;
  border: 1rpx solid #ddd;
  border-radius: 20rpx;
}

.type-item.active {
  color: #667eea;
  border-color: #667eea;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

.schedule-grid {
  padding: 10rpx;
}

.grid-header {
  display: flex;
  background: #fff;
  border-radius: 8rpx 8rpx 0 0;
}

.grid-corner {
  width: 80rpx;
  min-width: 80rpx;
  padding: 12rpx 4rpx;
  text-align: center;
  font-size: 20rpx;
  color: #999;
  background: #f0f2f5;
}

.grid-day-header {
  flex: 1;
  padding: 12rpx 4rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: bold;
  color: #333;
  background: #f0f2f5;
}

.grid-row {
  display: flex;
}

.grid-section-label {
  width: 80rpx;
  min-width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #999;
  background: #fff;
  border-top: 1rpx solid #eee;
}

.grid-cell-wrap {
  flex: 1;
}

.grid-cell {
  padding: 6rpx;
  min-height: 80rpx;
  border-top: 1rpx solid #eee;
  border-left: 1rpx solid #eee;
  background: #fff;
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.grid-cell.empty {
  background: #fafafa;
}

.grid-cell.cancelled {
  opacity: 0.5;
}

.grid-cell.activity {
  background: #fff7e6;
  border-left: 3rpx solid #fa8c16;
}

.grid-cell.override::after {
  content: '';
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #faad14;
}

.cell-course {
  font-size: 20rpx;
  color: #333;
  text-align: center;
  word-break: break-all;
  line-height: 1.3;
}

.cell-room {
  font-size: 18rpx;
  color: #999;
  text-align: center;
}

.cell-teacher {
  font-size: 18rpx;
  color: #667eea;
  text-align: center;
}

.cell-cancel-mark {
  font-size: 18rpx;
  color: #ff4d4f;
}

.cell-override-mark {
  display: none;
}

.day-selector {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 30rpx;
  background: #fff;
}

.day-item {
  padding: 10rpx 30rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 20rpx;
}

.day-item.active {
  color: #fff;
  background: #667eea;
}

.day-list {
  padding: 20rpx 30rpx;
}

.day-course-item {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.day-course-item.cancelled {
  opacity: 0.5;
}

.day-course-item.override {
  border-left: 4rpx solid #faad14;
}

.day-section {
  font-size: 28rpx;
  font-weight: bold;
  color: #667eea;
  min-width: 80rpx;
  display: flex;
  align-items: center;
}

.day-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.day-course-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.day-time,
.day-room,
.day-teacher,
.day-building,
.day-campus {
  font-size: 24rpx;
  color: #666;
}

.day-cancel-tag {
  font-size: 24rpx;
  color: #ff4d4f;
  align-self: center;
}

.day-empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 30rpx;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.06);
}

.bar-btn {
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.import-btn {
  background: #667eea;
  color: #fff;
}

.edit-btn {
  background: #faad14;
  color: #fff;
}

.editing-bar {
  background: #fff7e6;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666;
}

.save-btn {
  background: #52c41a;
  color: #fff;
}

.edit-count {
  font-size: 24rpx;
  color: #faad14;
  display: flex;
  align-items: center;
}
