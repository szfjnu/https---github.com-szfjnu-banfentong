.timetable-container { min-height: 100vh; background: var(--background-color); padding-bottom: 120rpx; }
.loading-box { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; color: var(--text-color-light); }
.loading-spinner { width: 60rpx; height: 60rpx; border: 4rpx solid var(--border-color); border-top-color: var(--primary-color); border-radius: 50%; animation: spin 0.8s linear infinite; margin-bottom: 20rpx; }
@keyframes spin { to { transform: rotate(360deg); } }
.day-tabs { display: flex; background: var(--white); padding: 20rpx 24rpx; gap: 12rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }
.day-tab { flex: 1; text-align: center; padding: 16rpx 0; font-size: 28rpx; color: var(--text-color-secondary); background: var(--background-color); border-radius: 12rpx; }
.day-tab.active { color: var(--white); background: var(--primary-color); font-weight: 600; }
.section-list { margin: 20rpx 24rpx; }
.section-item { display: flex; justify-content: space-between; align-items: center; background: var(--white); padding: 24rpx 28rpx; margin-bottom: 12rpx; border-radius: 16rpx; border-left: 8rpx solid var(--primary-color); }
.section-item.break { border-left-color: #52c41a; }
.section-item.lunch { border-left-color: #faad14; }
.section-left { display: flex; align-items: center; gap: 12rpx; }
.section-name { font-size: 30rpx; font-weight: 600; color: var(--text-color); }
.section-type-tag { font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 6rpx; }
.type-class { color: var(--primary-color); background: #e6f7ff; }
.type-break { color: #52c41a; background: #f6ffed; }
.type-lunch { color: #faad14; background: #fffbe6; }
.section-right { display: flex; align-items: center; gap: 16rpx; }
.section-time { font-size: 26rpx; color: var(--text-color-secondary); }
.section-actions { display: flex; gap: 12rpx; }
.action-btn { font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 8rpx; }
.edit-btn { color: var(--primary-color); background: #e6f7ff; }
.del-btn { color: var(--error-color); background: #fff2f0; }
.empty-tip { text-align: center; padding: 80rpx 0; font-size: 28rpx; color: var(--text-color-light); }
.bottom-actions { position: fixed; bottom: 0; left: 0; right: 0; display: flex; gap: 20rpx; padding: 20rpx 24rpx; background: var(--white); box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.06); }
.bottom-actions .action-btn { flex: 1; text-align: center; padding: 24rpx 0; border-radius: 16rpx; font-size: 30rpx; font-weight: 600; }
.add-btn { background: var(--primary-color); color: var(--white); }
.reset-btn { background: var(--background-color); color: var(--text-color-secondary); border: 2rpx solid var(--border-color); }
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 999; display: flex; align-items: center; justify-content: center; }
.modal-content { width: 640rpx; background: var(--white); border-radius: 24rpx; padding: 40rpx; }
.modal-title { font-size: 34rpx; font-weight: 700; text-align: center; margin-bottom: 32rpx; }
.form-item { margin-bottom: 24rpx; }
.form-label { font-size: 28rpx; font-weight: 600; display: block; margin-bottom: 12rpx; }
.form-input, .form-picker { background: var(--background-color); padding: 18rpx 24rpx; border-radius: 12rpx; font-size: 28rpx; border: 2rpx solid var(--border-color); }
.modal-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.modal-btn { flex: 1; text-align: center; padding: 22rpx 0; border-radius: 16rpx; font-size: 30rpx; font-weight: 600; }
.cancel-btn { background: var(--background-color); color: var(--text-color-secondary); }
.confirm-btn { background: var(--primary-color); color: var(--white); }
