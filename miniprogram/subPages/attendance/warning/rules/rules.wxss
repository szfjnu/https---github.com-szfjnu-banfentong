.rules-container { min-height: 100vh; background: var(--background-color); padding: 20rpx 24rpx; }
.loading-box { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; color: var(--text-color-light); }
.loading-spinner { width: 60rpx; height: 60rpx; border: 4rpx solid var(--border-color); border-top-color: var(--primary-color); border-radius: 50%; animation: spin 0.8s linear infinite; margin-bottom: 20rpx; }
@keyframes spin { to { transform: rotate(360deg); } }
.section { background: var(--white); border-radius: 20rpx; padding: 30rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.section-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 24rpx; }
.section-title { font-size: 32rpx; font-weight: 700; color: var(--text-color); }
.default-tag { font-size: 22rpx; color: var(--primary-color); background: #e6f7ff; padding: 4rpx 12rpx; border-radius: 6rpx; }
.level-list { margin-bottom: 24rpx; }
.level-item { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--background-color); }
.level-item:last-child { border-bottom: none; }
.level-color { width: 12rpx; height: 40rpx; border-radius: 6rpx; flex-shrink: 0; }
.level-name { font-size: 28rpx; font-weight: 600; color: var(--text-color); width: 180rpx; }
.level-inputs { display: flex; align-items: center; gap: 8rpx; flex: 1; }
.level-label { font-size: 24rpx; color: var(--text-color-secondary); white-space: nowrap; }
.level-input { width: 80rpx; text-align: center; background: var(--background-color); padding: 8rpx; border-radius: 8rpx; font-size: 26rpx; border: 2rpx solid var(--border-color); }
.btn-row { display: flex; gap: 20rpx; }
.btn { flex: 1; text-align: center; padding: 20rpx 0; border-radius: 16rpx; font-size: 28rpx; font-weight: 600; }
.primary-btn { background: var(--primary-color); color: var(--white); }
.outline-btn { background: var(--white); color: var(--text-color-secondary); border: 2rpx solid var(--border-color); }
.leave-config { display: flex; align-items: center; gap: 12rpx; margin-bottom: 24rpx; padding: 20rpx 0; }
.leave-desc { font-size: 28rpx; color: var(--text-color); }
.leave-input { width: 100rpx; text-align: center; background: var(--background-color); padding: 12rpx; border-radius: 12rpx; font-size: 30rpx; font-weight: 600; border: 2rpx solid var(--primary-color); color: var(--primary-color); }
