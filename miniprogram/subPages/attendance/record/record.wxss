/* pages/attendance/record/record.wxss */

.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding-bottom: 120rpx;
}

/* 页面标题 */
.page-header {
  padding: 40rpx 30rpx 30rpx;
  text-align: center;
  color: var(--white);
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.page-subtitle {
  display: block;
  font-size: 28rpx;
  opacity: 0.9;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  margin: 0 30rpx 30rpx;
  background: var(--white);
  border-radius: 16rpx;
  padding: 20rpx;
}

.filter-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx;
  border-radius: 16rpx;
  background: var(--background-color);
  margin: 0 5rpx;
}

.filter-text {
  font-size: 26rpx;
  color: var(--text-color);
  margin-right: 8rpx;
}

.filter-icon {
  font-size: 20rpx;
  color: var(--text-color-light);
}

/* 统计卡片 */
.stats-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15rpx;
  margin: 0 30rpx 30rpx;
}

.stat-card {
  background: var(--white);
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-color-light);
}

.stat-card.total .stat-num {
  color: #667eea;
}

.stat-card.sick .stat-num {
  color: var(--success-color);
}

.stat-card.personal .stat-num {
  color: var(--primary-color);
}

.stat-card.late .stat-num {
  color: var(--warning-color);
}

.stat-card.early .stat-num {
  color: var(--warning-color);
}

.stat-card.absent .stat-num {
  color: var(--error-color);
}

/* 记录列表 */
.record-list {
  margin: 0 30rpx;
}

.record-item {
  background: var(--white);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.record-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.category-badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.category-icon {
  margin-right: 8rpx;
}

.record-right {
  text-align: right;
}

.student-name {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-color);
  margin-bottom: 5rpx;
}

.record-date {
  display: block;
  font-size: 24rpx;
  color: var(--text-color-light);
}

.record-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 15rpx;
  border-top: 1rpx solid var(--border-color);
}

.score-change {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--error-color);
}

.recorder {
  font-size: 24rpx;
  color: var(--text-color-light);
}

.record-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 15rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid var(--border-color);
}

.action-btn {
  padding: 8rpx 24rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.action-btn.delete {
  background: #fff1f0;
  color: var(--error-color);
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  display: block;
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: var(--white);
  opacity: 0.8;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 60rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: var(--white);
  opacity: 0.8;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 40rpx 0;
}

.load-more-text {
  font-size: 26rpx;
  color: var(--white);
  opacity: 0.8;
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 40rpx 0;
}

.no-more-text {
  font-size: 26rpx;
  color: var(--white);
  opacity: 0.6;
}

/* 编辑模式 */
.category-section {
  margin: 0 30rpx 30rpx;
  background: var(--white);
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-header .section-title {
  margin-bottom: 0;
}

.select-all-btn {
  padding: 10rpx 20rpx;
  background: var(--background-color);
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #667eea;
}

.category-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.category-item {
  display: flex;
  align-items: center;
  padding: 15rpx 20rpx;
  background: var(--background-color);
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.category-item.selected {
  background: #667eea10;
  border-color: #667eea;
}

.category-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  margin-right: 12rpx;
  font-size: 28rpx;
}

.category-text {
  font-size: 28rpx;
  color: var(--text-color);
  margin-right: 8rpx;
}

.category-score {
  font-size: 24rpx;
  color: var(--error-color);
}

/* 学生列表 */
.student-section {
  margin: 0 30rpx;
  background: var(--white);
  border-radius: 16rpx;
  padding: 30rpx;
}

.student-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.student-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: var(--background-color);
  border-radius: 16rpx;
  margin-bottom: 15rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.student-item.selected {
  background: #667eea10;
  border-color: #667eea;
}

.student-checkbox {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--border-color);
  border-radius: 16rpx;
  margin-right: 20rpx;
}

.student-item.selected .student-checkbox {
  background: #667eea;
  border-color: #667eea;
}

.checkbox-icon {
  font-size: 24rpx;
  color: var(--white);
}

.student-info {
  flex: 1;
  min-width: 0;
}

.student-info .student-name {
  font-size: 30rpx;
  color: var(--text-color);
  margin-bottom: 5rpx;
}

.student-id {
  font-size: 24rpx;
  color: var(--text-color-light);
}

.student-status {
  margin-left: 15rpx;
}

.status-badge {
  display: inline-block;
  padding: 6rpx 12rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
}

/* 旷课节次选择 */
.period-section {
  margin: 0 30rpx 30rpx;
  background: var(--white);
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.1);
}

.period-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.period-item {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  background: var(--background-color);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--text-color);
}

.period-text {
  margin-left: 10rpx;
}

/* 保存按钮 */
.save-btn-container {
  margin: 30rpx;
}

.save-btn {
  width: 100%;
  height: 90rpx;
  background: var(--white);
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #667eea;
}

/* 筛选弹窗 */
.filter-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  background: var(--white);
  border-radius: 30rpx 30rpx 0 0;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
}

.modal-close {
  font-size: 36rpx;
  color: var(--text-color-light);
}

.modal-body {
  padding: 30rpx;
}

.filter-group {
  margin-bottom: 30rpx;
}

.filter-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-color-secondary);
  margin-bottom: 15rpx;
}

.filter-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: var(--background-color);
  border-radius: 16rpx;
}

.picker-icon {
  font-size: 20rpx;
  color: var(--text-color-light);
}

.custom-date-range {
  display: flex;
  gap: 20rpx;
  margin-top: 15rpx;
}

.date-item {
  flex: 1;
}

.date-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-color-light);
  margin-bottom: 10rpx;
}

.date-picker {
  padding: 15rpx;
  background: var(--background-color);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--text-color);
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  border-top: 1rpx solid var(--border-color);
}

.reset-btn {
  flex: 1;
  height: 80rpx;
  background: var(--background-color);
  border-radius: 16rpx;
  font-size: 30rpx;
  color: var(--text-color-secondary);
}

.confirm-btn {
  flex: 2;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  font-size: 30rpx;
  color: var(--white);
}

.student-search { padding: 0 20rpx 16rpx; }
.student-search-input { width: 100%; padding: 16rpx 24rpx; background: var(--background-color); border-radius: 12rpx; font-size: 28rpx; color: var(--text-color); }

.edit-filter-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.edit-filter-bar .picker-filter {
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  background: var(--background-color);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--text-color);
  white-space: nowrap;
}

.edit-filter-bar .arrow {
  font-size: 18rpx;
  color: var(--text-color-light);
  margin-left: 6rpx;
}

.edit-filter-bar .search-input-small {
  flex: 1;
  min-width: 0;
}

.edit-filter-bar .search-input-small input {
  width: 100%;
  padding: 12rpx 16rpx;
  background: var(--background-color);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--text-color);
  box-sizing: border-box;
}

.edit-filter-bar .select-all-btn {
  padding: 12rpx 20rpx;
  background: var(--background-color);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #667eea;
  white-space: nowrap;
}

.selected-count {
  font-size: 26rpx;
  color: #667eea;
}

.period-info {
  font-size: 24rpx;
  color: #667eea;
  margin-right: 20rpx;
}

/* 记录详情弹窗 */
.detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1001;
}

.detail-modal .modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
}

.detail-modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  background: var(--white);
  border-radius: 30rpx 30rpx 0 0;
  max-height: 70vh;
  overflow-y: auto;
}

.detail-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.detail-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
}

.detail-modal-close {
  font-size: 36rpx;
  color: var(--text-color-light);
  padding: 10rpx;
}

.detail-modal-body {
  padding: 30rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--background-color);
}

.detail-label {
  font-size: 28rpx;
  color: var(--text-color-light);
}

.detail-value {
  font-size: 28rpx;
  color: var(--text-color);
  font-weight: 500;
}
/* 修复旷课节次选择器样式 */
.period-list .period-item checkbox {
  /* 缩放 checkbox 大小，使其可见 */
  transform: scale(0.8);
  /* 添加右边距，让文字和框有空隙 */
  margin-right: 10rpx !important;
}

/* 确保容器垂直居中，防止 checkbox 被挤出去 */
.period-item {
  display: flex;
  align-items: center; /* 修复点：让 checkbox 和文字垂直居中 */
  /* 原有属性... */
}