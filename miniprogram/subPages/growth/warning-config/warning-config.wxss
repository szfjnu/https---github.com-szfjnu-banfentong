.warning-config-page {
  padding: 20rpx 30rpx;
  min-height: 100vh;
  background: var(--background-color);
}

.section {
  background: var(--white);
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 16rpx;
}

.rule-list {
  margin-bottom: 20rpx;
}

.rule-item {
  padding: 16rpx;
  background: var(--background-color);
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.rule-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.rule-desc {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-color);
}

.rule-detail {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
}

.rule-indicator, .rule-op, .rule-threshold {
  font-size: 24rpx;
  color: #667eea;
  background: #f0f3ff;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
}

.rule-ops {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.op-link {
  font-size: 26rpx;
  color: #667eea;
}

.op-link.delete {
  color: var(--error-color);
}

.empty-tip {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: var(--text-color-light);
}

.form-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  gap: 16rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-color);
  width: 80rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  padding: 12rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 8rpx;
  font-size: 28rpx;
}

.picker-value {
  flex: 1;
  padding: 12rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 8rpx;
  font-size: 28rpx;
  color: var(--text-color);
}

.form-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.form-btn {
  flex: 1;
  padding: 20rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-color-secondary);
}

.form-btn.primary {
  background: #667eea;
  color: var(--white);
  border-color: #667eea;
}
