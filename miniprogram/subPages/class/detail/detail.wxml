<!--pages/class/detail/detail.wxml-->
<view class="container">
  <!-- 天气提示 -->
  <view class="weather-tip">
    <text class="weather-icon">☀️</text>
    <text class="weather-text">天气晴朗，适合户外活动</text>
  </view>

  <!-- 生日提醒 -->
  <view class="birthday-reminder" wx:if="{{todayBirthdays.length > 0}}">
    <view class="birthday-header">
      <view class="birthday-left">
        <text class="birthday-icon">🎂</text>
        <view class="birthday-info">
          <view class="birthday-title">今日生日</view>
          <view class="birthday-count">{{todayBirthdays.length}}位同学今天过生日</view>
        </view>
      </view>
    </view>
    <view class="birthday-content">
      <view class="birthday-list">
        <view class="birthday-item" wx:for="{{todayBirthdays}}" wx:key="_id">
          <view class="birthday-avatar">
            <text>👤</text>
          </view>
          <view class="birthday-name">{{item.name}}</view>
          <view class="birthday-wish" bindtap="onSendWish" data-id="{{item._id}}" data-name="{{item.name}}">
            <text>送祝福</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 今日课程 -->
  <view class="today-course">
    <view class="course-header">
      <view class="course-left">
        <text class="course-icon">📖</text>
        <view class="course-info">
          <view class="course-title">今日课程</view>
          <view class="course-date">{{todayDate}}</view>
        </view>
      </view>
      <view class="notification-icon" bindtap="onShowNotifications">
        <text>🔔</text>
        <view class="notification-badge" wx:if="{{notificationCount > 0}}">{{notificationCount}}</view>
      </view>
    </view>
    <view class="course-content">
      <view class="course-empty" wx:if="{{!todayCourses || todayCourses.length === 0}}">
        <text class="empty-icon">📚</text>
        <text class="empty-text">今日无课程安排</text>
      </view>
      <view class="course-list" wx:else>
        <view class="course-item" wx:for="{{todayCourses}}" wx:key="index">
          <view class="course-time">{{item.time}}</view>
          <view class="course-name">{{item.name}}</view>
        </view>
      </view>
      <view class="course-action" bindtap="onViewFullSchedule">
        <text>查看完整课表</text>
        <text class="arrow">→</text>
      </view>
    </view>
  </view>

  <!-- 今日任务 -->
  <view class="today-task">
    <view class="task-header">
      <text class="task-icon">📋</text>
      <text class="task-title">今日任务</text>
    </view>
    <view class="task-content">
      <view class="task-empty" wx:if="{{!todayTasks || todayTasks.length === 0}}">
        <text class="empty-text">今日无任务</text>
      </view>
      <view class="task-list" wx:else>
        <view class="task-item" wx:for="{{todayTasks}}" wx:key="index">
          <view class="task-check {{item.completed ? 'checked' : ''}}" bindtap="onToggleTask" data-index="{{index}}">
            <text wx:if="{{item.completed}}">✓</text>
          </view>
          <view class="task-text {{item.completed ? 'completed' : ''}}">{{item.title}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="data-stats">
    <view class="stat-item" bindtap="onManageStudents">
      <view class="stat-icon" style="background: linear-gradient(135deg, #ff6b6b 0%, #ee5a52 100%);">
        <text>👥</text>
      </view>
      <view class="stat-value">{{statistics.studentCount || 0}}</view>
      <view class="stat-label">学生总数</view>
    </view>
    <view class="stat-item" bindtap="onManageScore">
      <view class="stat-icon" style="background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);">
        <text>⭐</text>
      </view>
      <view class="stat-value">{{statistics.avgScore || 100}}</view>
      <view class="stat-label">平均积分</view>
    </view>
    <view class="stat-item" bindtap="onViewPending">
      <view class="stat-icon" style="background: linear-gradient(135deg, #fa8c16 0%, #d46b08 100%);">
        <text>📝</text>
      </view>
      <view class="stat-value">{{statistics.pendingCount || 0}}</view>
      <view class="stat-label">待处理</view>
    </view>
  </view>

  <!-- 积分排行榜 -->
  <view class="score-rank">
    <view class="rank-header">
      <view class="rank-left">
        <text class="rank-icon">🏆</text>
        <text class="rank-title">Top 5 积分榜</text>
      </view>
      <view class="rank-action" bindtap="onViewAllRank">
        <text>查看全部</text>
        <text class="arrow">→</text>
      </view>
    </view>
    <view class="rank-list" wx:if="{{topStudents.length > 0}}">
      <view class="rank-item {{index === 0 ? 'first' : ''}}" wx:for="{{topStudents}}" wx:key="_id">
        <view class="rank-number">{{index + 1}}</view>
        <view class="rank-avatar">
          <text>👤</text>
        </view>
        <view class="rank-info">
          <view class="rank-name">{{item.name}}</view>
          <view class="rank-score">{{item.current_score}}分</view>
        </view>
      </view>
    </view>
    <view class="rank-empty" wx:else>
      <text class="empty-text">暂无数据</text>
    </view>
  </view>

  <!-- 班级信息卡片 -->
  <view class="class-card" wx:if="{{!loading && classInfo}}">
    <view class="card-header">
      <view class="class-icon">📚</view>
      <view class="class-basic">
        <view class="class-name">{{classInfo.class_name}}</view>
        <view class="class-meta">
          <text class="meta-item">{{classInfo.grade}}</text>
          <text class="meta-item" wx:if="{{classInfo.creator_name}}">创建人: {{classInfo.creator_name}}</text>
        </view>
      </view>
      <view class="settings-btn" bindtap="onGoToSettings">
        <text>⚙️</text>
      </view>
    </view>

    <!-- 班级码 -->
    <view class="class-code-section" wx:if="{{classInfo.class_code}}">
      <view class="code-label">班级码</view>
      <view class="code-value">{{classInfo.class_code}}</view>
      <view class="code-tip">分享给家长/学生，快速加入班级</view>
    </view>
  </view>

  <!-- 班级切换 -->
  <view class="class-switcher" wx:if="{{myClasses.length > 1}}">
    <view class="switcher-label">切换班级:</view>
    <picker mode="selector" range="{{myClasses}}" range-key="class_name" value="{{currentClassIndex}}" bindchange="onSwitchClass">
      <view class="switcher-value">
        <text>{{classInfo.class_name}}</text>
        <text class="arrow">▼</text>
      </view>
    </picker>
  </view>

  <!-- 快捷功能 -->
  <view class="quick-actions">
    <view class="section-title">班级管理</view>
    <view class="action-grid">
      <view class="action-item" bindtap="onManageStudents">
        <view class="action-icon" style="background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);">
          <text>👥</text>
        </view>
        <view class="action-title">学生管理</view>
      </view>
      <view class="action-item" bindtap="onManageScore">
        <view class="action-icon" style="background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);">
          <text>📊</text>
        </view>
        <view class="action-title">积分管理</view>
      </view>
      <view class="action-item" bindtap="onManageVolunteer">
        <view class="action-icon" style="background: linear-gradient(135deg, #fa8c16 0%, #d46b08 100%);">
          <text>🤝</text>
        </view>
        <view class="action-title">志愿服务</view>
      </view>
      <view class="action-item" bindtap="onManageAttendance">
        <view class="action-icon" style="background: linear-gradient(135deg, #722ed1 0%, #531dab 100%);">
          <text>📅</text>
        </view>
        <view class="action-title">考勤管理</view>
      </view>
    </view>
  </view>

  <!-- 底部导航栏 -->
  <view class="bottom-nav">
    <view class="nav-item {{currentNav === 'home' ? 'active' : ''}}" bindtap="onNavToHome">
      <view class="nav-icon">
        <text>🏠</text>
      </view>
      <text class="nav-text">首页</text>
    </view>
    <view class="nav-item {{currentNav === 'student' ? 'active' : ''}}" bindtap="onManageStudents">
      <view class="nav-icon">
        <text>👥</text>
      </view>
      <text class="nav-text">学生</text>
    </view>
    <view class="nav-item {{currentNav === 'score' ? 'active' : ''}}" bindtap="onManageScore">
      <view class="nav-icon">
        <text>⭐</text>
      </view>
      <text class="nav-text">积分</text>
    </view>
    <view class="nav-item {{currentNav === 'volunteer' ? 'active' : ''}}" bindtap="onManageVolunteer">
      <view class="nav-icon">
        <text>🤝</text>
      </view>
      <text class="nav-text">志愿</text>
    </view>
    <view class="nav-item {{currentNav === 'more' ? 'active' : ''}}" bindtap="onShowMoreMenu">
      <view class="nav-icon">
        <text>📋</text>
      </view>
      <text class="nav-text">更多</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-icon"></view>
    <view class="loading-text">加载中...</view>
  </view>
</view>
