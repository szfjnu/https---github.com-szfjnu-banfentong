<!--pages/class/settings/settings.wxml-->
<view class="container">
  <!-- 班级信息 -->
  <view class="class-info-card" wx:if="{{classInfo}}">
    <view class="info-row">
      <text class="info-label">班级名称</text>
      <text class="info-value">{{classInfo.class_name}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">所属年级</text>
      <text class="info-value">{{classInfo.grade}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">创建时间</text>
      <text class="info-value">{{classInfo.created_at}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">班级状态</text>
      <text class="info-value {{classInfo.status === 'graduated' ? 'status-graduated' : ''}}">
        {{classInfo.status === 'graduated' ? '已毕业' : '正常'}}
      </text>
    </view>
  </view>

  <!-- 功能开启设置 -->
  <view class="settings-section">
    <view class="section-title">功能开启设置</view>
    <view class="settings-list">
      <view class="setting-item">
        <view class="setting-left">
          <text class="setting-icon">📊</text>
          <text class="setting-name">积分管理</text>
        </view>
        <switch checked="{{settings.score_enabled}}" bindchange="onToggleSetting" data-key="score_enabled" color="#1890ff" />
      </view>
      <view class="setting-item">
        <view class="setting-left">
          <text class="setting-icon">🤝</text>
          <text class="setting-name">志愿服务</text>
        </view>
        <switch checked="{{settings.volunteer_enabled}}" bindchange="onToggleSetting" data-key="volunteer_enabled" color="#1890ff" />
      </view>
      <view class="setting-item">
        <view class="setting-left">
          <text class="setting-icon">📅</text>
          <text class="setting-name">考勤管理</text>
        </view>
        <switch checked="{{settings.attendance_enabled}}" bindchange="onToggleSetting" data-key="attendance_enabled" color="#1890ff" />
      </view>
      <view class="setting-item">
        <view class="setting-left">
          <text class="setting-icon">🏆</text>
          <text class="setting-name">积分商城</text>
        </view>
        <switch checked="{{settings.mall_enabled}}" bindchange="onToggleSetting" data-key="mall_enabled" color="#1890ff" />
      </view>
      <view class="setting-item">
        <view class="setting-left">
          <text class="setting-icon">📋</text>
          <text class="setting-name">处分记录</text>
        </view>
        <switch checked="{{settings.discipline_enabled}}" bindchange="onToggleSetting" data-key="discipline_enabled" color="#1890ff" />
      </view>
      <view class="setting-item">
        <view class="setting-left">
          <text class="setting-icon">🏠</text>
          <text class="setting-name">宿舍管理</text>
        </view>
        <switch checked="{{settings.enable_dorm_management}}" bindchange="onToggleSetting" data-key="enable_dorm_management" color="#1890ff" />
      </view>
    </view>
  </view>

  <!-- 班级操作 -->
  <view class="actions-section">
    <view class="section-title">班级操作</view>
    <view class="action-list">
      <view class="action-item" bindtap="onMarkGraduated" wx:if="{{classInfo.status !== 'graduated'}}">
        <text class="action-icon">🎓</text>
        <text class="action-name ellipsis min-w-0">标记为毕业班级</text>
        <text class="action-arrow">›</text>
      </view>
      <view class="action-item" bindtap="onTransferClass">
        <text class="action-icon">🔄</text>
        <text class="action-name ellipsis min-w-0">转让班级</text>
        <text class="action-arrow">›</text>
      </view>
      <view class="action-item danger" bindtap="onDissolveClass">
        <text class="action-icon">⚠️</text>
        <text class="action-name ellipsis min-w-0">解散班级</text>
        <text class="action-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-icon"></view>
    <view class="loading-text">加载中...</view>
  </view>
</view>
