.detail-container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 140rpx;
}

/* ===== 图片轮播 ===== */
.image-swiper {
  width: 100%;
  height: 560rpx;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

/* ===== 价格区 ===== */
.price-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 28rpx;
  background: #ffffff;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.main-price {
  font-size: 44rpx;
  font-weight: 700;
  color: #ff4d4f;
}

.original-price {
  font-size: 26rpx;
  color: #cccccc;
  text-decoration: line-through;
}

.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.status-on_sale {
  background: #f6ffed;
  color: #52c41a;
}

.status-reserved {
  background: #fffbe6;
  color: #faad14;
}

.status-sold {
  background: #f5f5f5;
  color: #999999;
}

.status-removed {
  background: #fff2f0;
  color: #ff4d4f;
}

/* ===== 信息卡片 ===== */
.info-card {
  background: #ffffff;
  margin: 20rpx 24rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.info-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1.4;
}

.info-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tag {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.tag-category {
  background: #fff7e6;
  color: #ff6b35;
}

.tag-condition {
  background: #e6f7ff;
  color: #1890ff;
}

.info-desc {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  margin-top: 20rpx;
  white-space: pre-wrap;
}

.info-meta {
  font-size: 22rpx;
  color: #999999;
  margin-top: 20rpx;
}

.meta-dot {
  margin: 0 8rpx;
}

/* ===== 卖家信息 ===== */
.seller-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  margin: 0 24rpx 20rpx;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.seller-avatar-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

.seller-avatar {
  width: 100%;
  height: 100%;
}

.seller-info {
  margin-left: 20rpx;
  flex: 1;
}

.seller-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  display: block;
}

.seller-contact {
  font-size: 24rpx;
  color: #ff6b35;
  margin-top: 4rpx;
  display: block;
}

/* ===== 留言区 ===== */
.message-section {
  background: #ffffff;
  margin: 0 24rpx 20rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 20rpx;
}

.message-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.message-item:last-child {
  border-bottom: none;
}

.msg-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  display: block;
}

.msg-content {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  display: block;
  margin-top: 8rpx;
}

.msg-time {
  font-size: 22rpx;
  color: #cccccc;
  display: block;
  margin-top: 8rpx;
}

.empty-tip {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #999999;
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.bar-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 28rpx;
  padding: 8rpx 12rpx;
}

.bar-icon {
  font-size: 36rpx;
}

.bar-text {
  font-size: 20rpx;
  color: #999999;
  margin-top: 4rpx;
}

.bar-action.wanted .bar-text {
  color: #ff4d4f;
}

.bar-main-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  background: linear-gradient(135deg, #ff6b35, #ff8c42);
  color: #ffffff;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.bar-main-btn:active {
  opacity: 0.85;
}

.bar-main-btn.disabled {
  background: #d9d9d9;
  color: #ffffff;
  pointer-events: none;
}

/* ===== 弹窗通用 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 640rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333333;
  text-align: center;
  margin-bottom: 24rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.cancel-btn {
  background: #f5f7fa;
  color: #666666;
}

.confirm-btn {
  background: linear-gradient(135deg, #ff6b35, #ff8c42);
  color: #ffffff;
}

.confirm-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* 留言输入 */
.msg-textarea {
  width: 100%;
  min-height: 180rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333333;
  border: 2rpx solid #e8e8e8;
  box-sizing: border-box;
  line-height: 1.6;
}

/* 举报选项 */
.report-reasons {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.report-item {
  padding: 12rpx 24rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666666;
  border: 2rpx solid transparent;
}

.report-item.selected {
  background: #fff7e6;
  color: #ff6b35;
  border-color: #ff6b35;
}

.report-detail {
  width: 100%;
  min-height: 120rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 26rpx;
  color: #333333;
  border: 2rpx solid #e8e8e8;
  box-sizing: border-box;
}
