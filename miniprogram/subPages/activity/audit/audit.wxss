/* 聚光点 - 审核管理 */
.audit-container {
  min-height: 100vh;
  background: var(--background-color);
  padding: 20rpx;
}

.audit-card {
  background: var(--white);
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.card-main {
  padding: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 16rpx;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.meta-tag {
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  background: #667eea15;
  color: #667eea;
  border-radius: 6rpx;
}

.meta-text {
  font-size: 24rpx;
  color: var(--text-color-light);
}

.card-people {
  font-size: 24rpx;
  color: #667eea;
  margin-top: 10rpx;
}

.card-actions {
  display: flex;
  border-top: 1rpx solid var(--border-color);
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  font-weight: 600;
}

.action-btn.approve {
  color: var(--success-color);
}

.action-btn.reject {
  color: var(--error-color);
  border-left: 1rpx solid var(--border-color);
}

.action-btn:active {
  background: var(--background-color);
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-color-light);
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.loading-icon {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--background-color);
  border-top: 4rpx solid #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
