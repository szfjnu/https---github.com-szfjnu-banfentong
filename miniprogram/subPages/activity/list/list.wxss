/* 聚光点 - 活动列表 */
.activity-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
}

/* 顶部标题栏 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
}

.header-sub {
  font-size: 24rpx;
  opacity: 0.85;
  display: block;
  margin-top: 4rpx;
}

.header-right {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.my-btn {
  padding: 10rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
  font-size: 24rpx;
}

.my-btn:active {
  background: rgba(255, 255, 255, 0.35);
}

.audit-btn {
  position: relative;
  padding: 10rpx 24rpx;
  background: rgba(255, 77, 79, 0.8);
  border-radius: 30rpx;
  font-size: 24rpx;
}

.audit-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background: #ff4d4f;
  border-radius: 16rpx;
  font-size: 20rpx;
  color: white;
  padding: 0 6rpx;
}

/* 分类滚动 */
.category-scroll {
  white-space: nowrap;
  background: white;
  padding: 20rpx 20rpx 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.cat-item {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  transition: all 0.2s;
}

.cat-item.cat-active {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
}

/* 状态 Tab */
.tab-bar {
  display: flex;
  background: white;
  padding: 16rpx 20rpx;
  gap: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 28rpx;
  color: #999;
  border-radius: 8rpx;
  transition: all 0.2s;
}

.tab-item.tab-active {
  color: #667eea;
  font-weight: 600;
  background: #667eea10;
}

/* 活动列表 */
.activity-list {
  padding: 20rpx;
}

.activity-card {
  display: flex;
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.2s;
}

.activity-card:active {
  transform: scale(0.98);
}

/* 封面 */
.card-cover {
  width: 200rpx;
  min-height: 220rpx;
  flex-shrink: 0;
}

.card-cover image {
  width: 100%;
  height: 100%;
}

.card-cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea20, #764ba220);
}

.cover-emoji {
  font-size: 72rpx;
}

/* 信息区 */
.card-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.card-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.meta-tag {
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  background: #667eea15;
  color: #667eea;
  border-radius: 6rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #999;
}

.card-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14rpx;
}

.people-info {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.people-current {
  font-size: 30rpx;
  font-weight: bold;
  color: #667eea;
}

.people-divider {
  font-size: 24rpx;
  color: #ccc;
}

.people-max {
  font-size: 24rpx;
  color: #999;
}

.people-label {
  font-size: 22rpx;
  color: #999;
  margin-left: 4rpx;
}

.organizer {
  font-size: 24rpx;
  color: #999;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.loading-icon {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 发布按钮 */
.fab-publish {
  position: fixed;
  right: 40rpx;
  bottom: 140rpx;
  display: flex;
  align-items: center;
  padding: 20rpx 36rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 50rpx;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.45);
  z-index: 100;
}

.fab-publish:active {
  transform: scale(0.95);
}

.fab-icon {
  font-size: 36rpx;
  color: white;
  font-weight: bold;
  margin-right: 8rpx;
}

.fab-text {
  font-size: 28rpx;
  color: white;
  font-weight: 600;
}
