/* pages/dorm/beds/assign/assign.wxss */
.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 床位信息 */
.bed-info {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.info-header {
  margin-bottom: 15rpx;
}

.info-title {
  font-size: 28rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.8);
}

.info-details {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.detail-item {
  display: flex;
  align-items: center;
}

.detail-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-right: 10rpx;
}

.detail-value {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  padding: 15rpx 20rpx;
  background: white;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
}

.search-btn {
  padding: 10rpx 25rpx;
  background: #1890ff;
  color: white;
  border-radius: 8rpx;
  font-size: 24rpx;
  border: none;
}

/* 学生列表 */
.student-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.student-item {
  background: white;
  border-radius: 16rpx;
  padding: 25rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s;
}

.student-item:active {
  transform: scale(0.98);
}

.student-info {
  margin-bottom: 15rpx;
}

.student-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.student-id {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 4rpx;
  display: block;
}

.student-class {
  font-size: 24rpx;
  color: #666;
  display: block;
}

.student-status {
  padding: 12rpx;
  background: #f6f8fa;
  border-radius: 8rpx;
}

.status-text {
  font-size: 24rpx;
  color: #999;
}

.status-text.available {
  color: #52c41a;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 20rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载中 */
.loading {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: #999;
}
