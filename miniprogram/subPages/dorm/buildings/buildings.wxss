/* pages/dorm/buildings/buildings.wxss */
.container {
  padding: 20rpx;
  background: var(--background-color);
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  gap: 15rpx;
  margin-bottom: 20rpx;
}

.stat-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 25rpx 15rpx;
  background: var(--white);
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--primary-color);
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-color-light);
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  padding: 15rpx 20rpx;
  background: var(--white);
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
}

.search-btn {
  padding: 10rpx 25rpx;
  background: var(--primary-color);
  color: var(--white);
  border-radius: 8rpx;
  font-size: 24rpx;
  border: none;
}

/* 楼栋列表 */
.building-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.building-item {
  background: var(--white);
  border-radius: 16rpx;
  padding: 25rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s;
}

.building-item:active {
  transform: scale(0.98);
}

/* 楼栋头部 */
.building-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.building-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
}

.building-actions {
  display: flex;
  gap: 15rpx;
}

.action-btn {
  padding: 8rpx 20rpx;
  background: #f0f5ff;
  color: var(--primary-color);
  border-radius: 20rpx;
  font-size: 24rpx;
}

.action-btn.delete {
  background: #fff2e8;
  color: var(--error-color);
}

/* 楼栋信息 */
.building-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 15rpx;
}

.info-item {
  display: flex;
  align-items: center;
}

.info-label {
  font-size: 26rpx;
  color: var(--text-color-light);
  min-width: 140rpx;
}

.info-value {
  font-size: 26rpx;
  color: var(--text-color);
  flex: 1;
  min-width: 0;
}

/* 房间预览 */
.room-preview {
  padding: 15rpx;
  background: var(--background-color);
  border-radius: 8rpx;
}

.preview-label {
  font-size: 24rpx;
  color: var(--text-color-secondary);
  margin-bottom: 10rpx;
}

.preview-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  padding: 6rpx 16rpx;
  background: var(--white);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: var(--primary-color);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 20rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-color-light);
  margin-bottom: 30rpx;
}

.empty-btn {
  padding: 20rpx 40rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color) 100%);
  color: var(--white);
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

/* 加载更多 */
.loading-more,
.no-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: var(--text-color-light);
}

/* 顶部添加按钮 */
.top-add-bar {
  margin-bottom: 20rpx;
}

.top-add-btn {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color) 100%);
  color: var(--white);
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.top-add-btn .btn-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

/* 悬浮按钮 */
.fab-button {
  position: fixed;
  bottom: 40rpx;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.4);
  z-index: 100;
}

.fab-icon {
  font-size: 48rpx;
  color: var(--white);
}
