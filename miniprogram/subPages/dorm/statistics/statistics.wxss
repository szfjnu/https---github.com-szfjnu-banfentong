.container {
  min-height: 100vh;
  background: #f5f7fa;
}

/* 标签 */
.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 28rpx;
  color: #999;
  position: relative;
}

.tab-item.active {
  color: #1890ff;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #1890ff;
  border-radius: 2rpx;
}

.tab-content {
  padding: 20rpx;
}

/* 统计卡片 */
.stats-cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.stat-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #1890ff;
  margin-bottom: 10rpx;
}

.stat-card.warning .stat-value {
  color: #faad14;
}

.stat-card.danger .stat-value {
  color: #ff4d4f;
}

.stat-label {
  font-size: 26rpx;
  color: #999;
}

/* 区块 */
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

/* 积分分布 */
.distribution {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.dist-item {
  display: flex;
  flex-direction: column;
}

.dist-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.dist-label {
  font-size: 28rpx;
  color: #333;
}

.dist-count {
  font-size: 28rpx;
  color: #999;
}

.dist-bar-bg {
  flex: 1;
  height: 20rpx;
  background: #f0f0f0;
  border-radius: 10rpx;
  overflow: hidden;
}

.dist-bar {
  height: 100%;
  border-radius: 10rpx;
  transition: width 0.3s;
}

.dist-bar.excellent {
  background: #52c41a;
}

.dist-bar.good {
  background: #1890ff;
}

.dist-bar.pass {
  background: #faad14;
}

.dist-bar.warning {
  background: #ff7a45;
}

.dist-bar.danger {
  background: #ff4d4f;
}

.dist-percent {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  text-align: right;
}

/* 违规列表 */
.violation-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.violation-item {
  display: flex;
  align-items: center;
}

.violation-rank {
  width: 60rpx;
  height: 60rpx;
  background: #f5f5f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #999;
  margin-right: 20rpx;
}

.violation-info {
  flex: 1;
}

.violation-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.violation-count {
  font-size: 24rpx;
  color: #999;
}

/* 排名列表 */
.ranking-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.ranking-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.ranking-left {
  display: flex;
  align-items: center;
}

.ranking-medal {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.ranking-number {
  width: 60rpx;
  height: 60rpx;
  background: #f5f5f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #999;
  margin-right: 20rpx;
}

.ranking-info {
  display: flex;
  flex-direction: column;
}

.ranking-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.ranking-room {
  font-size: 24rpx;
  color: #999;
}

.ranking-right {
  display: flex;
  align-items: baseline;
}

.ranking-score {
  font-size: 40rpx;
  font-weight: bold;
  color: #1890ff;
}

.ranking-unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}

/* 预警列表 */
.warning-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.warning-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.warning-left {
  display: flex;
  align-items: center;
}

.warning-badge {
  width: 8rpx;
  height: 80rpx;
  border-radius: 4rpx;
  margin-right: 20rpx;
}

.warning-badge.yellow {
  background: #ffd700;
}

.warning-badge.orange {
  background: #ff9500;
}

.warning-badge.red {
  background: #ff3b30;
}

.warning-info {
  display: flex;
  flex-direction: column;
}

.warning-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.warning-room {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.warning-score {
  font-size: 24rpx;
  color: #ff9500;
}

.warning-right {
  display: flex;
  align-items: center;
}

.warning-level-text {
  font-size: 24rpx;
  color: #ff9500;
  background: #fff8e8;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 10rpx;
}

.warning-arrow {
  font-size: 24rpx;
  color: #999;
}

.empty-tip {
  text-align: center;
  padding: 60rpx;
  font-size: 28rpx;
  color: #999;
}
