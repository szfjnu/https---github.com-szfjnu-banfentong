<!--pages/dorm/rooms/rooms.wxml-->
<view class="container">
  <!-- 楼栋信息 -->
  <view class="building-info" wx:if="{{buildingInfo}}">
    <view class="building-header">
      <text class="building-name">{{buildingInfo.building_name}}</text>
      <text class="building-code">{{buildingInfo.building_code}}</text>
    </view>
    <view class="building-stats">
      <view class="stat">
        <text class="stat-value">{{totalRooms}}</text>
        <text class="stat-label">房间</text>
      </view>
      <view class="stat">
        <text class="stat-value">{{totalBeds}}</text>
        <text class="stat-label">床位</text>
      </view>
      <view class="stat">
        <text class="stat-value">{{occupiedBeds}}</text>
        <text class="stat-label">已入住</text>
      </view>
    </view>
  </view>

  <!-- 楼层筛选 -->
  <view class="filter-bar">
    <view
      class="filter-item {{selectedFloor === 'all' ? 'active' : ''}}"
      bindtap="onFloorChange"
      data-floor="all"
    >
      <text>全部楼层</text>
    </view>
    <view
      class="filter-item {{selectedFloor === item ? 'active' : ''}}"
      wx:for="{{floors}}"
      wx:key="*this"
      bindtap="onFloorChange"
      data-floor="{{item}}"
    >
      <text>{{item}}层</text>
    </view>
  </view>

  <!-- 房间列表 -->
  <view class="room-list">
    <view class="room-item" wx:for="{{rooms}}" wx:key="_id">
      <view class="room-header">
        <view class="room-number" bindtap="onViewDetail" data-id="{{item._id}}">{{item.room_number}}</view>
        <view class="room-status {{item.occupancy_rate >= 1 ? 'full' : ''}}">
          <text>{{item.occupancy_rate >= 1 ? '已满' : '空闲'}}</text>
        </view>
      </view>

      <view class="room-info" bindtap="onViewDetail" data-id="{{item._id}}">
        <view class="info-row">
          <text class="info-label">楼层：</text>
          <text class="info-value">{{item.floor}}层</text>
        </view>
        <view class="info-row">
          <text class="info-label">床位数：</text>
          <text class="info-value">{{item.bed_count}}个</text>
        </view>
        <view class="info-row">
          <text class="info-label">已入住：</text>
          <text class="info-value">{{item.occupied_count}}人</text>
        </view>
      </view>

      <view class="room-beds">
        <view class="bed {{bed.occupied ? 'occupied' : ''}}" wx:for="{{item.beds}}" wx:key="bed_number" wx:for-item="bed">
          <text class="bed-num">{{bed.bed_number}}</text>
          <text class="bed-name" wx:if="{{bed.occupied && bed.student_name}}">{{bed.student_name}}</text>
          <text class="bed-name empty" wx:elif="{{bed.occupied}}">未关联</text>
        </view>
      </view>

      <view class="room-actions" wx:if="{{isAdmin}}">
        <button class="action-btn" catchtap="onEdit" data-id="{{item._id}}" size="mini">
          <text>编辑</text>
        </button>
        <button class="action-btn delete" catchtap="onDelete" data-id="{{item._id}}" size="mini">
          <text>删除</text>
        </button>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{rooms.length === 0 && !loading}}">
      <text class="empty-icon">🚪</text>
      <text class="empty-text">暂无房间信息</text>
      <button class="empty-btn" bindtap="onAdd" wx:if="{{isAdmin}}">添加房间</button>
    </view>
  </view>

  <!-- 顶部添加按钮 -->
  <view class="top-add-bar">
    <button class="top-add-btn" bindtap="onAdd">
      <text class="btn-icon">➕</text>
      <text>添加房间</text>
    </button>
  </view>

  <!-- 添加按钮（始终显示） -->
  <view class="fab-button" bindtap="onAdd">
    <text class="fab-icon">➕</text>
  </view>
</view>
