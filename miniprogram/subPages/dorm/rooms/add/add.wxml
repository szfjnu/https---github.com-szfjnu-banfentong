<!--pages/dorm/rooms/add/add.wxml-->
<view class="container">
  <!-- 标题栏 -->
  <view class="header">
    <view class="header-title">{{editingRoom ? '编辑房间' : '添加房间'}}</view>
    <view class="header-subtitle" wx:if="{{buildingInfo}}">
      {{buildingInfo.campus}} - {{buildingInfo.building_name}}
    </view>
  </view>

  <!-- 表单 -->
  <view class="form-card">
    <view class="form-section-title">基本信息</view>

    <view class="form-item">
      <text class="form-label required">房间号</text>
      <input
        class="form-input"
        type="text"
        placeholder="如：301"
        value="{{formData.room_number}}"
        bindinput="onInputChange"
        data-field="room_number"
      />
    </view>

    <view class="form-item">
      <text class="form-label required">楼层</text>
      <input
        class="form-input"
        type="number"
        placeholder="请输入楼层号"
        value="{{formData.floor}}"
        bindinput="onInputChange"
        data-field="floor"
      />
    </view>

    <view class="form-item">
      <text class="form-label required">床位数</text>
      <input
        class="form-input"
        type="number"
        placeholder="请输入床位数"
        value="{{formData.bed_count}}"
        bindinput="onInputChange"
        data-field="bed_count"
      />
    </view>

    <view class="form-item">
      <text class="form-label">备注说明</text>
      <textarea
        class="form-textarea"
        placeholder="请输入备注说明（选填）"
        value="{{formData.description}}"
        bindinput="onInputChange"
        data-field="description"
        maxlength="200"
      ></textarea>
    </view>
  </view>

  <!-- 提示信息 -->
  <view class="tips-card" wx:if="{{!editingRoom}}">
    <view class="tips-title">💡 温馨提示</view>
    <view class="tips-content">
      <text>• 添加房间后，系统会自动创建相应数量的床位</text>
      <text>• 床位编号格式：房间号-序号（如：301-1）</text>
      <text>• 可以在房间详情中分配床位给学生</text>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="footer">
    <button class="footer-btn cancel" bindtap="onCancel">取消</button>
    <button class="footer-btn primary" bindtap="onSubmit" disabled="{{!canSubmit}}">保存</button>
  </view>
</view>
