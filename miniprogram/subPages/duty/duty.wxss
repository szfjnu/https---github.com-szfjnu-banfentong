/* pages/duty/duty.wxss */
.container {
  padding: 20rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

.date-picker {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.date-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.date-label {
  font-size: 28rpx;
  color: #666;
}

.date-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #1890ff;
  padding: 8rpx 20rpx;
  background: #e6f7ff;
  border-radius: 8rpx;
}

/* 统计卡片 */
.stats-card {
  background: linear-gradient(135deg, #1890ff, #096dd9);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(24,144,255,0.3);
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: white;
}

.stat-value.success { color: #95de64; }
.stat-value.warning { color: #ffd666; }
.stat-value.danger { color: #ff7875; }

.stat-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 6rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255,255,255,0.2);
}

/* 功能入口 */
.func-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.func-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 10rpx;
  background: white;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.func-item:active { opacity: 0.8; }

.func-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 12rpx;
}

.func-text {
  font-size: 24rpx;
  color: #333;
}

/* 分区卡片 */
.section-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.section-action {
  font-size: 26rpx;
  color: #1890ff;
  padding: 6rpx 16rpx;
  background: #e6f7ff;
  border-radius: 8rpx;
}

/* 轮转信息 */
.rotation-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.group-badge {
  padding: 10rpx 24rpx;
  background: #e6f7ff;
  color: #1890ff;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.rotation-mode {
  font-size: 24rpx;
  color: #999;
}

.no-rotation, .no-text {
  font-size: 26rpx;
  color: #999;
}

/* 任务列表 */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fafafa;
  border-radius: 12rpx;
}

.task-left {
  margin-right: 16rpx;
}

.task-status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.task-status-dot.done { background: #52c41a; }
.task-status-dot.fail { background: #ff4d4f; }
.task-status-dot.pending { background: #faad14; }

.task-center {
  flex: 1;
}

.task-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.task-meta {
  display: flex;
  gap: 16rpx;
  margin-top: 6rpx;
}

.task-student, .task-group {
  font-size: 22rpx;
  color: #999;
}

.task-right {
  text-align: right;
}

.task-score {
  font-size: 28rpx;
  font-weight: 600;
}

.task-score.plus { color: #52c41a; }
.task-score.minus { color: #ff4d4f; }

.task-status-text {
  font-size: 22rpx;
  display: block;
  margin-top: 4rpx;
}

.task-status-text.done { color: #52c41a; }
.task-status-text.fail { color: #ff4d4f; }
.task-status-text.pending { color: #faad14; }

/* 空状态 */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}

.empty-btn {
  margin-top: 20rpx;
  padding: 12rpx 40rpx;
  background: #1890ff;
  color: white;
  border-radius: 30rpx;
  font-size: 26rpx;
}

/* 提示卡片 */
.tip-card {
  background: #fff7e6;
  border: 1rpx solid #ffe58f;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tip-icon { font-size: 32rpx; }

.tip-text {
  flex: 1;
  font-size: 26rpx;
  color: #ad6800;
}

.tip-btn {
  padding: 8rpx 24rpx;
  background: #fa8c16;
  color: white;
  border-radius: 20rpx;
  font-size: 24rpx;
}
