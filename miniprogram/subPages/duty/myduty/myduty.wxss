/* pages/duty/myduty/myduty.wxss */
.container {
  padding: 20rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

/* 统计卡片 */
.stats-card {
  background: linear-gradient(135deg, #13c2c2, #08979c);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(19,194,194,0.3);
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: white;
}

.stat-value.success { color: #95de64; }
.stat-value.danger { color: #ff7875; }

.stat-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 6rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255,255,255,0.2);
}

/* 提醒区域 */
.reminder-section {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.reminder-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.reminder-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.reminder-read-all {
  font-size: 24rpx;
  color: #1890ff;
}

.reminder-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.reminder-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 16rpx;
  background: #fafafa;
  border-radius: 12rpx;
  position: relative;
}

.reminder-item.warning {
  background: #fff7e6;
  border: 1rpx solid #ffe58f;
}

.reminder-type {
  font-size: 32rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.reminder-content {
  flex: 1;
}

.reminder-text {
  font-size: 26rpx;
  color: #333;
  display: block;
  line-height: 1.5;
}

.reminder-date {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 6rpx;
}

.reminder-dot {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ff4d4f;
}

/* 任务Tab */
.task-tabs {
  display: flex;
  gap: 0;
  margin-bottom: 20rpx;
  background: white;
  border-radius: 12rpx;
  overflow: hidden;
}

.task-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
}

.task-tab.active {
  color: #13c2c2;
  border-bottom-color: #13c2c2;
  font-weight: 600;
}

/* 任务卡片 */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.task-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.task-icon { font-size: 40rpx; }

.task-info {
  flex: 1;
}

.task-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.task-date {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.task-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.task-status.done { background: #f6ffed; color: #52c41a; }
.task-status.fail { background: #fff1f0; color: #ff4d4f; }
.task-status.pending { background: #fffbe6; color: #faad14; }

.task-group {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.task-score {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
}

.score-label { font-size: 24rpx; color: #999; }

.score-value { font-size: 28rpx; font-weight: 600; }
.score-value.plus { color: #52c41a; }
.score-value.minus { color: #ff4d4f; }

/* 检查详情 */
.task-inspection {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}

.inspection-row {
  display: flex;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.inspection-label { font-size: 24rpx; color: #999; flex-shrink: 0; }
.inspection-value { font-size: 24rpx; color: #333; }
.inspection-value.problem { color: #ff4d4f; }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon { font-size: 60rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 26rpx; color: #999; }
.loading-state { text-align: center; padding: 60rpx 0; color: #999; }
