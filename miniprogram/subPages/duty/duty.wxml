<!--pages/duty/duty.wxml - 值日管理主页面-->
<view class="container">
  <!-- 日期选择 -->
  <view class="date-picker">
    <view class="date-info">
      <text class="date-label">值日日期</text>
      <picker mode="date" value="{{selectedDate}}" bindchange="onDateChange">
        <view class="date-value">{{selectedDate}}</view>
      </picker>
    </view>
  </view>

  <!-- 统计概览 -->
  <view class="stats-card">
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-value">{{stats.totalTasks}}</text>
        <text class="stat-label">总任务</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value success">{{stats.completedTasks}}</text>
        <text class="stat-label">已完成</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value warning">{{stats.pendingTasks}}</text>
        <text class="stat-label">待完成</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value danger">{{stats.incompleteTasks}}</text>
        <text class="stat-label">未完成</text>
      </view>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="func-grid">
    <view class="func-item" bindtap="onGoArrange">
      <view class="func-icon" style="background: #e6f7ff;">
        <text>📋</text>
      </view>
      <text class="func-text">安排值日</text>
    </view>
    <view class="func-item" bindtap="onGoCheck">
      <view class="func-icon" style="background: #f6ffed;">
        <text>✅</text>
      </view>
      <text class="func-text">值日检查</text>
    </view>
    <view class="func-item" bindtap="onGoTemplate">
      <view class="func-icon" style="background: #fff7e6;">
        <text>📝</text>
      </view>
      <text class="func-text">任务模板</text>
    </view>
    <view class="func-item" bindtap="onGoRotation">
      <view class="func-icon" style="background: #f9f0ff;">
        <text>🔄</text>
      </view>
      <text class="func-text">轮转设置</text>
    </view>
  </view>

  <!-- 今日轮转信息 -->
  <view class="section-card" wx:if="{{rotation}}">
    <view class="section-header">
      <text class="section-title">今日值日小组</text>
    </view>
    <view class="rotation-info" wx:if="{{todayDutyGroup}}">
      <view class="group-badge">{{todayDutyGroup.group_name || '未设置'}}</view>
      <text class="rotation-mode">轮转方式：{{rotation.rotation_mode === 'daily' ? '每日轮换' : '每周轮换'}}</text>
    </view>
    <view class="no-rotation" wx:else>
      <text class="no-text">暂无轮转配置，请先设置</text>
    </view>
  </view>

  <!-- 今日任务列表 -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-title">当日任务（{{todayTasks.length}}）</text>
      <view class="section-action" bindtap="onGoArrange">
        <text>+安排</text>
      </view>
    </view>

    <view class="task-list" wx:if="{{todayTasks.length > 0}}">
      <view class="task-item" wx:for="{{todayTasks}}" wx:key="task_id">
        <view class="task-left">
          <view class="task-status-dot {{item.status === '已完成' ? 'done' : (item.status === '未完成' ? 'fail' : 'pending')}}"></view>
        </view>
        <view class="task-center">
          <view class="task-name">{{item.task_name || '未分配任务'}}</view>
          <view class="task-meta">
            <text class="task-student">{{item.student_name}}</text>
            <text class="task-group">{{item.group_name}}</text>
          </view>
        </view>
        <view class="task-right">
          <text class="task-score {{item.score_change > 0 ? 'plus' : (item.score_change < 0 ? 'minus' : '')}}">
            {{item.score_change > 0 ? '+' : ''}}{{item.score_change}}
          </text>
          <text class="task-status-text {{item.status === '已完成' ? 'done' : (item.status === '未完成' ? 'fail' : 'pending')}}">
            {{item.status}}
          </text>
        </view>
        <view class="task-actions">
          <view class="task-btn edit-btn" catchtap="onEditTask" data-task="{{item}}">编辑</view>
          <view class="task-btn delete-btn" catchtap="onDeleteTask" data-task="{{item}}">删除</view>
        </view>
      </view>
    </view>

    <view class="empty-tip" wx:else>
      <text>今日暂无值日安排</text>
      <view class="empty-btn" bindtap="onGoArrange">安排值日</view>
    </view>
  </view>

  <!-- 任务模板提示 -->
  <view class="tip-card" wx:if="{{templateCount === 0}}">
    <text class="tip-icon">💡</text>
    <text class="tip-text">请先创建任务模板，再安排值日</text>
    <view class="tip-btn" bindtap="onGoTemplate">创建模板</view>
  </view>

  <!-- 编辑弹窗 -->
  <view class="modal-mask" wx:if="{{showEditModal}}" bindtap="onEditCancel">
    <view class="modal-content" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">编辑值日任务</text>
        <view class="modal-close" bindtap="onEditCancel">✕</view>
      </view>
      <view class="modal-body">
        <view class="form-item">
          <text class="form-label">任务名称</text>
          <input class="form-input" value="{{editForm.task_name}}" bindinput="onEditFormChange" data-field="task_name" placeholder="请输入任务名称" />
        </view>
        <view class="form-item">
          <text class="form-label">值日日期</text>
          <picker mode="date" value="{{editForm.duty_date}}" bindchange="onEditFormChange" data-field="duty_date">
            <view class="form-picker">{{editForm.duty_date || '选择日期'}}</view>
          </picker>
        </view>
        <view class="form-item">
          <text class="form-label">负责人</text>
          <input class="form-input" value="{{editForm.student_name}}" bindinput="onEditFormChange" data-field="student_name" placeholder="请输入负责人姓名" />
        </view>
        <view class="form-item">
          <text class="form-label">合格加分</text>
          <input class="form-input" type="number" value="{{editForm.score_for_qualified}}" bindinput="onEditFormChange" data-field="score_for_qualified" placeholder="2" />
        </view>
        <view class="form-item">
          <text class="form-label">不合格扣分</text>
          <input class="form-input" type="number" value="{{editForm.deduction_for_unqualified}}" bindinput="onEditFormChange" data-field="deduction_for_unqualified" placeholder="-2" />
        </view>
        <view class="form-item">
          <text class="form-label">小组名称</text>
          <input class="form-input" value="{{editForm.group_name}}" bindinput="onEditFormChange" data-field="group_name" placeholder="请输入小组名称" />
        </view>
      </view>
      <view class="modal-footer">
        <view class="modal-btn cancel" bindtap="onEditCancel">取消</view>
        <view class="modal-btn confirm {{editSubmitting ? 'disabled' : ''}}" bindtap="onEditSubmit">{{editSubmitting ? '保存中...' : '保存'}}</view>
      </view>
    </view>
  </view>
</view>
