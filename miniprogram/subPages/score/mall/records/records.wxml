<!--pages/score/mall/records/records.wxml-->
<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">我的兑换记录</text>
  </view>

  <!-- 状态筛选 -->
  <view class="filter-section">
    <picker mode="selector" range="{{statusOptions}}" range-key="label" bindchange="onStatusChange">
      <view class="filter-picker">
        <text>{{selectedStatusLabel}}</text>
        <text class="picker-arrow">▼</text>
      </view>
    </picker>
  </view>

  <!-- 记录列表 -->
  <view class="record-list" wx:if="{{!loading && records.length > 0}}">
    <view class="record-card" wx:for="{{records}}" wx:key="_id">
      <view class="card-header">
        <view class="item-name">{{item.item_name}}</view>
        <view class="status-tag {{item.statusClass}}">{{item.status}}</view>
      </view>

      <view class="card-body">
        <view class="info-row">
          <view class="info-item">
            <text class="info-label">兑换方式</text>
            <text class="info-value">{{item.modeText}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">消耗积分</text>
            <text class="info-value score-cost">{{item.bidScoreText}}</text>
          </view>
        </view>
        <view class="info-row">
          <view class="info-item">
            <text class="info-label">提交时间</text>
            <text class="info-value">{{item.dateStr}}</text>
          </view>
        </view>
        <view class="info-row" wx:if="{{item.approval_time}}">
          <view class="info-item">
            <text class="info-label">审批时间</text>
            <text class="info-value">{{item.approval_time_str || ''}}</text>
          </view>
        </view>
      </view>

      <!-- 物流/操作区 -->
      <view class="card-footer" wx:if="{{item.status === '已通过' || item.status === '已发货'}}">
        <view class="shipping-info">
          <text class="shipping-label">物流状态:</text>
          <text class="shipping-value {{item.shipping_status === 'received' ? 'received' : ''}}">{{item.shippingText}}</text>
        </view>
        <view 
          class="receive-btn" 
          wx:if="{{item.status === '已发货'}}" 
          catchtap="onConfirmReceive" 
          data-record="{{item}}"
        >
          确认收货
        </view>
      </view>

      <!-- 拒绝原因 -->
      <view class="reject-reason" wx:if="{{item.status === '已拒绝' && item.reject_reason}}">
        <text>拒绝原因: {{item.reject_reason}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && records.length === 0}}">
    <text class="empty-icon">🎁</text>
    <view class="empty-text">暂无兑换记录</view>
    <view class="empty-hint">去积分商城看看吧</view>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text class="loading-icon">⏳</text>
    <view class="loading-text">加载中...</view>
  </view>

  <!-- 没有更多 -->
  <view class="no-more" wx:if="{{!loading && records.length > 0 && !hasMore}}">
    <text>没有更多了</text>
  </view>
</view>
