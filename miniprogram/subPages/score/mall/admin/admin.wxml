<!--pages/score/mall/admin/admin.wxml-->
<view class="container">
  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-icon"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:else>
    <!-- 主标签切换 -->
    <view class="main-tabs">
      <view 
        class="main-tab {{mainTab === 'requests' ? 'active' : ''}}" 
        bindtap="onMainTabChange" 
        data-tab="requests"
      >
        兑换审批
        <view class="badge" wx:if="{{pendingRequests.length > 0}}">{{pendingRequests.length}}</view>
      </view>
      <view 
        class="main-tab {{mainTab === 'items' ? 'active' : ''}}" 
        bindtap="onMainTabChange" 
        data-tab="items"
      >
        商品管理
      </view>
      <view 
        class="main-tab" 
        bindtap="onGoLedger"
      >
        兑换台账
      </view>
    </view>

    <!-- ====== 兑换审批页面 ====== -->
    <block wx:if="{{mainTab === 'requests'}}">
      <!-- 统计卡片 -->
      <view class="stats-row">
        <view class="stat-card pending">
          <view class="stat-value">{{pendingRequests.length}}</view>
          <view class="stat-label">待审批</view>
        </view>
        <view class="stat-card approved">
          <view class="stat-value">{{approvedRequests.length}}</view>
          <view class="stat-label">已通过</view>
        </view>
        <view class="stat-card rejected">
          <view class="stat-value">{{rejectedRequests.length}}</view>
          <view class="stat-label">已拒绝</view>
        </view>
      </view>

      <!-- 标签切换 -->
      <view class="tabs">
        <view 
          class="tab-item {{activeTab === 'pending' ? 'active' : ''}}" 
          bindtap="onTabChange" 
          data-tab="pending"
        >
          待审批
        </view>
        <view 
          class="tab-item {{activeTab === 'approved' ? 'active' : ''}}" 
          bindtap="onTabChange" 
          data-tab="approved"
        >
          已通过
        </view>
        <view 
          class="tab-item {{activeTab === 'rejected' ? 'active' : ''}}" 
          bindtap="onTabChange" 
          data-tab="rejected"
        >
          已拒绝
        </view>
      </view>

      <!-- 筛选栏 -->
      <view class="filter-bar">
        <view class="search-input">
          <input 
            placeholder="搜索学生" 
            value="{{searchKeyword}}"
            bindinput="onSearchInput"
          />
        </view>
        <view class="batch-btn" bindtap="onBatchApprove" wx:if="{{activeTab === 'pending' && pendingRequests.length > 0}}">
          批量批准
        </view>
      </view>

      <!-- 请求列表 -->
      <view class="request-list">
        <block wx:for="{{pendingRequests}}" wx:key="_id" wx:if="{{activeTab === 'pending'}}">
          <view class="request-card" bindtap="onViewDetail" data-request="{{item}}">
            <view class="request-header">
              <view class="student-info">
                <text class="student-name">{{item.student_name}}</text>
                <text class="student-class">{{item.class_name}}</text>
              </view>
              <view class="request-time">{{item.created_at_text}}</view>
            </view>
            <view class="request-body">
              <view class="item-name">🎁 {{item.item_name}}</view>
              <view class="score-info">
                <text class="score-value">{{item.bid_score || item.required_score}}</text>
                <text class="score-unit">积分</text>
              </view>
            </view>
            <view class="request-footer">
              <view class="action-btns">
                <view class="btn approve" catchtap="onApprove" data-request="{{item}}">批准</view>
                <view class="btn reject" catchtap="onReject" data-request="{{item}}">拒绝</view>
              </view>
            </view>
          </view>
        </block>

        <block wx:for="{{approvedRequests}}" wx:key="_id" wx:if="{{activeTab === 'approved'}}">
          <view class="request-card approved" bindtap="onViewDetail" data-request="{{item}}">
            <view class="request-header">
              <view class="student-info">
                <text class="student-name">{{item.student_name}}</text>
                <text class="student-class">{{item.class_name}}</text>
              </view>
              <view class="status-tag approved">已通过</view>
            </view>
            <view class="request-body">
              <view class="item-name">🎁 {{item.item_name}}</view>
              <view class="score-info">
                <text class="score-value">{{item.bid_score || item.required_score}}</text>
                <text class="score-unit">积分</text>
              </view>
            </view>
          </view>
        </block>

        <block wx:for="{{rejectedRequests}}" wx:key="_id" wx:if="{{activeTab === 'rejected'}}">
          <view class="request-card rejected" bindtap="onViewDetail" data-request="{{item}}">
            <view class="request-header">
              <view class="student-info">
                <text class="student-name">{{item.student_name}}</text>
                <text class="student-class">{{item.class_name}}</text>
              </view>
              <view class="status-tag rejected">已拒绝</view>
            </view>
            <view class="request-body">
              <view class="item-name">🎁 {{item.item_name}}</view>
              <view class="score-info">
                <text class="score-value">{{item.bid_score || item.required_score}}</text>
                <text class="score-unit">积分</text>
              </view>
            </view>
          </view>
        </block>

        <!-- 空状态 -->
        <view class="empty" wx:if="{{(activeTab === 'pending' && pendingRequests.length === 0) || (activeTab === 'approved' && approvedRequests.length === 0) || (activeTab === 'rejected' && rejectedRequests.length === 0)}}">
          <text class="empty-icon">📭</text>
          <text class="empty-text">暂无{{activeTab === 'pending' ? '待审批' : activeTab === 'approved' ? '已通过' : '已拒绝'}}的请求</text>
        </view>
      </view>
    </block>

    <!-- ====== 商品管理页面 ====== -->
    <block wx:if="{{mainTab === 'items'}}">
      <!-- 操作栏 -->
      <view class="action-bar">
        <view class="add-btn" bindtap="onShowAddItemModal">
          <text class="add-icon">+</text>
          <text>添加商品</text>
        </view>
      </view>

      <!-- 商品列表 -->
      <view class="item-list">
        <view class="item-card" wx:for="{{items}}" wx:key="_id" bindtap="onEditItem" data-item="{{item}}">
          <view class="item-image">
            <image wx:if="{{item.image_url}}" src="{{item.image_url}}" mode="aspectFill"></image>
            <view wx:else class="no-image">🎁</view>
          </view>
          <view class="item-info">
            <view class="item-name">{{item.name}}</view>
            <view class="item-meta">
              <text class="item-score">所需积分: {{item.required_score}}</text>
              <text class="item-stock">库存: {{item.quantity || 0}}</text>
            </view>
            <view class="item-tags">
              <text class="tag {{item.redemption_mode === '投标模式' ? 'bid' : 'direct'}}">
                {{item.redemption_mode === '投标模式' ? '投标' : '直接兑换'}}
              </text>
              <text class="tag {{item.status === '可兑换' ? 'available' : 'unavailable'}}">
                {{item.status}}
              </text>
            </view>
          </view>
          <view class="item-actions">
            <view class="action-btn edit" catchtap="onEditItem" data-item="{{item}}">编辑</view>
            <view class="action-btn delete" catchtap="onDeleteItem" data-item="{{item}}">删除</view>
          </view>
        </view>

        <!-- 空状态 -->
        <view class="empty" wx:if="{{items.length === 0}}">
          <text class="empty-icon">📦</text>
          <text class="empty-text">暂无可兑换商品</text>
          <view class="empty-action" bindtap="onShowAddItemModal">添加第一个商品</view>
        </view>
      </view>
    </block>
  </block>

  <!-- ====== 兑换详情弹窗 ====== -->
  <view class="modal-mask" wx:if="{{showDetailModal}}" bindtap="onCloseDetailModal">
    <view class="modal-content" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">兑换详情</text>
        <text class="modal-close" catchtap="onCloseDetailModal">✕</text>
      </view>
      <view class="modal-body" wx:if="{{selectedRequest}}">
        <view class="detail-row">
          <text class="detail-label">学生姓名</text>
          <text class="detail-value">{{selectedRequest.student_name}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">兑换物品</text>
          <text class="detail-value">{{selectedRequest.item_name}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">消耗积分</text>
          <text class="detail-value highlight">{{selectedRequest.bid_score || selectedRequest.required_score}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">申请时间</text>
          <text class="detail-value">{{selectedRequest.created_at_text}}</text>
        </view>
      </view>
      <view class="modal-footer" wx:if="{{selectedRequest.status === '待审批' || selectedRequest.status === 'pending'}}">
        <view class="modal-btn reject" bindtap="onReject">拒绝</view>
        <view class="modal-btn approve" bindtap="onApprove">批准</view>
      </view>
    </view>
  </view>

  <!-- ====== 商品编辑弹窗 ====== -->
  <view class="modal-mask" wx:if="{{showItemModal}}" bindtap="onCloseItemModal">
    <view class="modal-content item-modal" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">{{editingItem ? '编辑商品' : '添加商品'}}</text>
        <text class="modal-close" catchtap="onCloseItemModal">✕</text>
      </view>
      <view class="modal-body">
        <view class="form-group">
          <text class="form-label required">商品名称</text>
          <input 
            class="form-input" 
            placeholder="请输入商品名称"
            value="{{itemForm.name}}"
            bindinput="onItemFormInput"
            data-field="name"
          />
        </view>
        
        <view class="form-group">
          <text class="form-label required">所需积分</text>
          <input 
            class="form-input" 
            type="number"
            placeholder="请输入所需积分"
            value="{{itemForm.required_score}}"
            bindinput="onItemFormInput"
            data-field="required_score"
          />
        </view>
        
        <view class="form-group">
          <text class="form-label required">库存数量</text>
          <input 
            class="form-input" 
            type="number"
            placeholder="请输入库存数量"
            value="{{itemForm.quantity}}"
            bindinput="onItemFormInput"
            data-field="quantity"
          />
        </view>
        
        <view class="form-group">
          <text class="form-label required">兑换模式</text>
          <picker mode="selector" range="{{modeOptions}}" value="{{itemForm.modeIndex}}" bindchange="onModeChange">
            <view class="picker-value">
              <text>{{modeOptions[itemForm.modeIndex]}}</text>
              <text class="arrow">▼</text>
            </view>
          </picker>
        </view>
        
        <view class="form-group" wx:if="{{itemForm.redemption_mode === '投标模式'}}">
          <text class="form-label">投标截止时间</text>
          <picker mode="date" value="{{itemForm.bid_end_time}}" bindchange="onBidEndTimeChange">
            <view class="picker-value">
              <text>{{itemForm.bid_end_time || '请选择'}}</text>
              <text class="arrow">▼</text>
            </view>
          </picker>
        </view>
        
        <view class="form-group">
          <text class="form-label">商品描述</text>
          <textarea 
            class="form-textarea" 
            placeholder="请输入商品描述（选填）"
            value="{{itemForm.description}}"
            bindinput="onItemFormInput"
            data-field="description"
          />
        </view>
        
        <view class="form-group">
          <text class="form-label">商品图片</text>
          <view class="image-upload">
            <image wx:if="{{itemForm.image_url}}" src="{{itemForm.image_url}}" mode="aspectFill" class="preview-image"></image>
            <view wx:else class="upload-btn" bindtap="onChooseItemImage">
              <text class="upload-icon">+</text>
              <text class="upload-text">上传图片</text>
            </view>
          </view>
        </view>
        
        <view class="form-group">
          <text class="form-label">状态</text>
          <view class="switch-row">
            <switch checked="{{itemForm.status === '可兑换'}}" bindchange="onStatusChange" color="#1890ff" />
            <text class="switch-text">{{itemForm.status === '可兑换' ? '可兑换' : '已下架'}}</text>
          </view>
        </view>
      </view>
      <view class="modal-footer">
        <view class="modal-btn cancel" bindtap="onCloseItemModal">取消</view>
        <view class="modal-btn confirm" bindtap="onSaveItem">保存</view>
      </view>
    </view>
  </view>
</view>
