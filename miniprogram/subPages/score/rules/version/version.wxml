<!--pages/score/rules/version.wxml-->
<view class="container">
  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-icon"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:else>
    <!-- 顶部信息 -->
    <view class="header">
      <view class="rule-name">{{ruleName}}</view>
      <view class="version-count">共 {{versions.length}} 个版本</view>
    </view>

    <!-- 操作栏 -->
    <view class="action-bar" wx:if="{{selectedVersions.length > 0}}">
      <view class="selected-info">已选择 {{selectedVersions.length}} 个版本</view>
      <view class="action-btn compare" bindtap="onCompareVersions" wx:if="{{selectedVersions.length === 2}}">
        开始对比
      </view>
      <view class="action-btn clear" bindtap="setData" data-selected-versions="{{[]}}">清除选择</view>
    </view>

    <!-- 版本列表 -->
    <view class="versions-list">
      <view 
        class="version-card {{item.status_class}} {{selectedVersions.length > 0 && selectedVersions[0].version_id === item.version_id || selectedVersions.length > 1 && selectedVersions[1].version_id === item.version_id ? 'selected' : ''}}"
        wx:for="{{versions}}" 
        wx:key="_id"
      >
        <view class="version-header">
          <view class="version-info">
            <view class="version-number">v{{item.version_number}}</view>
            <view class="version-status {{item.status_class}}">{{item.status_label}}</view>
          </view>
          <view class="version-actions">
            <view class="btn-icon" catchtap="onSelectVersion" data-version="{{item}}">
              <text wx:if="{{selectedVersions.length > 0 && selectedVersions[0].version_id === item.version_id || selectedVersions.length > 1 && selectedVersions[1].version_id === item.version_id}}">✓</text>
              <text wx:else>○</text>
            </view>
          </view>
        </view>

        <view class="version-body">
          <view class="info-row">
            <text class="label">积分值:</text>
            <text class="value score {{item.score_value < 0 ? 'deduct' : ''}}">
              {{item.score_value > 0 ? '+' : ''}}{{item.score_value}}
            </text>
          </view>
          <view class="info-row">
            <text class="label">分类:</text>
            <text class="value">{{item.category_id}}</text>
          </view>
          <view class="info-row">
            <text class="label">创建人:</text>
            <text class="value">{{item.created_by_name}}</text>
          </view>
          <view class="info-row">
            <text class="label">创建时间:</text>
            <text class="value">{{item.created_at_str}}</text>
          </view>
          <view class="info-row" wx:if="{{item.change_description}}">
            <text class="label">变更说明:</text>
            <text class="value">{{item.change_description}}</text>
          </view>
        </view>

        <view class="version-footer">
          <view class="btn-text" catchtap="onViewVersion" data-version="{{item}}">查看详情</view>
          <view class="btn-text rollback" catchtap="onRollback" data-version="{{item}}" wx:if="{{!item.is_active}}">
            回滚到此版本
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty" wx:if="{{versions.length === 0}}">
        <text class="empty-icon">📋</text>
        <text class="empty-text">暂无版本记录</text>
      </view>
    </view>

    <!-- 提示 -->
    <view class="tips">
      <view class="tip-item">💡 选择2个版本可进行对比</view>
      <view class="tip-item">💡 点击"回滚到此版本"可恢复历史版本</view>
    </view>
  </block>

  <!-- 版本对比弹窗 -->
  <view class="modal-mask" wx:if="{{showCompareModal}}" bindtap="onCloseCompareModal">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">版本对比</text>
        <text class="modal-close" catchtap="onCloseCompareModal">✕</text>
      </view>
      
      <scroll-view class="modal-body" scroll-y>
        <block wx:if="{{compareData}}">
          <!-- 版本信息对比 -->
          <view class="compare-section">
            <view class="compare-title">版本信息</view>
            <view class="compare-grid">
              <view class="compare-item">
                <view class="compare-label">旧版本</view>
                <view class="compare-value">{{compareData.oldVersion.version_number}}</view>
              </view>
              <view class="compare-item">
                <view class="compare-label">新版本</view>
                <view class="compare-value">{{compareData.newVersion.version_number}}</view>
              </view>
            </view>
          </view>

          <!-- 字段对比 -->
          <view class="compare-section">
            <view class="compare-title">字段对比</view>
            
            <view class="compare-row">
              <view class="compare-col label">规则名称</view>
              <view class="compare-col old">{{compareData.oldVersion.rule_name}}</view>
              <view class="compare-col new">{{compareData.newVersion.rule_name}}</view>
            </view>
            
            <view class="compare-row">
              <view class="compare-col label">规则编码</view>
              <view class="compare-col old">{{compareData.oldVersion.rule_code}}</view>
              <view class="compare-col new">{{compareData.newVersion.rule_code}}</view>
            </view>
            
            <view class="compare-row">
              <view class="compare-col label">积分值</view>
              <view class="compare-col old">{{compareData.oldVersion.score_value}}</view>
              <view class="compare-col new {{compareData.oldVersion.score_value !== compareData.newVersion.score_value ? 'highlight' : ''}}">
                {{compareData.newVersion.score_value}}
              </view>
            </view>
            
            <view class="compare-row">
              <view class="compare-col label">分类</view>
              <view class="compare-col old">{{compareData.oldVersion.category_id}}</view>
              <view class="compare-col new {{compareData.oldVersion.category_id !== compareData.newVersion.category_id ? 'highlight' : ''}}">
                {{compareData.newVersion.category_id}}
              </view>
            </view>
            
            <view class="compare-row">
              <view class="compare-col label">描述</view>
              <view class="compare-col old">{{compareData.oldVersion.description}}</view>
              <view class="compare-col new">{{compareData.newVersion.description}}</view>
            </view>
          </view>

          <!-- 变更记录 -->
          <view class="compare-section" wx:if="{{compareData.changes.length > 0}}">
            <view class="compare-title">变更记录</view>
            <view class="changes-list">
              <view class="change-item" wx:for="{{compareData.changes}}" wx:key="field">
                <view class="change-field">{{item.label}}</view>
                <view class="change-detail">
                  <text class="old">{{item.old_value || '空'}}</text>
                  <text class="arrow">→</text>
                  <text class="new">{{item.new_value || '空'}}</text>
                </view>
              </view>
            </view>
          </view>
        </block>
      </scroll-view>

      <view class="modal-footer">
        <view class="modal-btn confirm" bindtap="onCloseCompareModal">关闭</view>
      </view>
    </view>
  </view>
</view>
