<!--pages/score/add/add.wxml-->
<view class="container">
  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-icon"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:else>
    <!-- 积分项目选择（级联选择器） -->
    <view class="section">
      <view class="section-title">积分项目</view>
      <picker 
        mode="multiSelector" 
        range="{{cascaderData}}" 
        range-key="name"
        value="{{cascaderValue}}"
        bindchange="onCascaderChange"
        bindcolumnchange="onCascaderColumnChange"
      >
        <view class="picker-value cascader-picker">
          <view class="cascader-display">
            <text class="category-text">{{cascaderData[0][cascaderValue[0]].name}}</text>
            <text class="separator">/</text>
            <text class="item-text">{{cascaderData[1][cascaderValue[1]].name || '请选择'}}</text>
          </view>
          <text class="arrow">▼</text>
        </view>
      </picker>
    </view>

    <!-- 积分值（可加可减） -->
    <view class="section">
      <view class="section-title">积分值</view>
      <view class="score-input-wrapper">
        <view class="score-btn minus" bindtap="onScoreValueChange" data-delta="{{-1}}">
          <text>-</text>
        </view>
        <view class="score-value-center">
          <input 
            class="score-input" 
            type="number" 
            value="{{scoreValue}}"
            placeholder="0"
            bindinput="onScoreValueInput"
          />
          <text class="score-unit">分</text>
        </view>
        <view class="score-btn plus" bindtap="onScoreValueChange" data-delta="{{1}}">
          <text>+</text>
        </view>
      </view>
      <view class="score-type-toggle-wrapper" bindtap="onToggleScoreType">
        <view class="score-type-toggle {{isAddScore ? 'add' : 'deduct'}}">
          <text class="toggle-text">{{isAddScore ? '当前：加分' : '当前：扣分'}}</text>
          <text class="toggle-hint">点击切换</text>
        </view>
      </view>
    </view>

    <!-- 来源类型 -->
    <view class="section">
      <view class="section-title">来源类型</view>
      <picker mode="selector" range="{{sourceTypes}}" range-key="label" value="{{selectedSourceTypeIndex}}" bindchange="onSourceTypeChange">
        <view class="picker-value">
          <text>{{sourceTypes[selectedSourceTypeIndex].label}}</text>
          <text class="arrow">▼</text>
        </view>
      </picker>
    </view>

    <!-- 原因说明 -->
    <view class="section">
      <view class="section-title">原因说明</view>
      <input 
        class="reason-input"
        placeholder="请输入积分变动原因（必填）"
        value="{{reason}}"
        bindinput="onReasonInput"
        maxlength="100"
      />
    </view>

    <!-- 备注 -->
    <view class="section">
      <view class="section-title">备注（选填）</view>
      <textarea 
        class="remark-input"
        placeholder="可填写详细说明"
        value="{{remark}}"
        bindinput="onRemarkInput"
        maxlength="200"
      />
    </view>

    <!-- 学生选择 -->
    <view class="section">
      <view class="section-header">
        <view class="section-title">选择学生</view>
        <view class="selected-count">已选 {{selectedStudents.length}} 人</view>
      </view>
      
      <!-- 筛选栏 -->
      <view class="filter-bar">
        <picker mode="selector" range="{{classOptions}}" range-key="label" value="{{selectedClassIndex}}" bindchange="onClassChange">
          <view class="picker-filter">
            <text>{{classOptions[selectedClassIndex].label}}</text>
            <text class="arrow">▼</text>
          </view>
        </picker>
        <picker mode="selector" range="{{groupOptions}}" range-key="label" value="{{selectedGroupIndex}}" bindchange="onGroupChange">
          <view class="picker-filter">
            <text>{{groupOptions[selectedGroupIndex].label}}</text>
            <text class="arrow">▼</text>
          </view>
        </picker>
        <view class="search-input-small">
          <input 
            placeholder="搜索姓名/学号" 
            value="{{searchKeyword}}"
            bindinput="onSearchInput"
          />
        </view>
        <view class="select-all-btn" bindtap="onSelectAll">全选</view>
      </view>

      <!-- 学生列表 -->
      <scroll-view class="student-list" scroll-y>
        <view 
          class="student-item {{item.selected ? 'selected' : ''}}"
          wx:for="{{students}}" 
          wx:key="_id"
          wx:if="{{(selectedClass === '' || item.class_id === selectedClass) && (searchKeyword === '' || item.name.includes(searchKeyword) || item.student_id.includes(searchKeyword))}}"
          bindtap="onToggleStudent"
          data-id="{{item.student_id}}"
        >
          <view class="checkbox {{item.selected ? 'checked' : ''}}">
            <text wx:if="{{item.selected}}">✓</text>
          </view>
          <view class="student-info">
            <view class="student-name">
              {{item.name}}
              <text wx:if="{{item.isLeader}}" class="leader-tag">组长</text>
            </view>
            <view class="student-meta">
              <text>{{item.student_id}}</text>
              <text>{{item.class_name}}</text>
              <text wx:if="{{item.group}}">{{item.group}}</text>
            </view>
          </view>
          <view class="student-score">
            <text class="score-label">当前</text>
            <text class="score-value">{{item.current_score || 100}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 提交按钮 -->
    <view class="submit-section">
      <button 
        class="submit-btn {{isAddScore ? 'add' : 'deduct'}}" 
        bindtap="onSubmit"
        disabled="{{submitting || selectedStudents.length === 0 || scoreValue <= 0 || !reason}}"
      >
        {{submitting ? '提交中...' : (isAddScore ? '确认加分' : '确认扣分')}}
      </button>
    </view>
  </block>
</view>
