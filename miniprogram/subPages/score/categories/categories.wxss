/* pages/score/categories/categories.wxss */
.container {
  min-height: 100vh;
  background: var(--background-color);
  padding: 20rpx;
  padding-bottom: 120rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-icon {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  color: var(--text-color-light);
  font-size: 28rpx;
}

/* 类别列表 */
.category-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.category-card {
  background: var(--white);
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.category-card.disabled {
  opacity: 0.6;
}

.category-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.category-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.category-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.category-name {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-color);
}

.category-code {
  font-size: 24rpx;
  color: var(--text-color-light);
}

.category-status {
  transform: scale(0.9);
}

.category-body {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-color);
}

.category-desc {
  font-size: 26rpx;
  color: var(--text-color-secondary);
  line-height: 1.6;
}

.category-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-color);
}

.category-meta {
  display: flex;
  gap: 16rpx;
}

.meta-item {
  font-size: 24rpx;
  color: var(--text-color-light);
  padding: 4rpx 12rpx;
  background: var(--background-color);
  border-radius: 4rpx;
}

.category-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
}

.action-btn.edit {
  color: var(--primary-color);
  background: #e6f7ff;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-color-light);
  margin-bottom: 30rpx;
}

.empty-actions {
  margin-top: 20rpx;
}

.init-btn {
  background: var(--primary-color);
  color: var(--white);
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  border-radius: 8rpx;
}

/* 添加按钮 */
.fab-button {
  position: fixed;
  right: 40rpx;
  bottom: 40rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, var(--primary-color), #36cfc9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.4);
  z-index: 100;
}

.fab-button text {
  color: var(--white);
  font-size: 60rpx;
  font-weight: 300;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.modal-content {
  width: 100%;
  max-height: 80vh;
  background: var(--white);
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-color);
}

.modal-close {
  font-size: 40rpx;
  color: var(--text-color-light);
  padding: 10rpx;
}

.modal-body {
  flex: 1;
  padding: 30rpx 40rpx;
  max-height: 60vh;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-color);
  margin-bottom: 12rpx;
}

.form-label.required::before {
  content: '*';
  color: var(--error-color);
  margin-right: 4rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  padding: 20rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-tip {
  font-size: 24rpx;
  color: var(--text-color-light);
  margin-top: 8rpx;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 8rpx;
}

.icon-preview {
  font-size: 36rpx;
}

.color-preview {
  width: 60rpx;
  height: 40rpx;
  border-radius: 6rpx;
}

.arrow {
  font-size: 24rpx;
  color: var(--text-color-light);
}

.modal-footer {
  display: flex;
  padding: 30rpx 40rpx;
  border-top: 1rpx solid var(--border-color);
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.modal-btn.cancel {
  background: var(--background-color);
  color: var(--text-color-secondary);
}

.modal-btn.confirm {
  background: var(--primary-color);
  color: var(--white);
}