/* 成绩管理中心 */

.grade-container {
  min-height: 100vh;
  background: var(--background-color);
  padding-bottom: 40rpx;
}

/* 考试类型 Tab */
.exam-tabs {
  display: flex;
  background: var(--white);
  padding: 20rpx 24rpx;
  gap: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--text-color-secondary);
  background: #f0f2f5;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.tab-item.active {
  color: var(--white);
  background: linear-gradient(135deg, var(--primary-color), var(--primary-color));
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.4);
}

/* 筛选行 */
.filter-row {
  display: flex;
  padding: 20rpx 24rpx;
  gap: 20rpx;
  background: var(--white);
  margin-bottom: 20rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  background: var(--background-color);
  padding: 14rpx 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.picker-label {
  color: var(--text-color-light);
  margin-right: 8rpx;
}

.picker-value {
  color: var(--text-color);
  font-weight: 500;
}

.picker-arrow {
  font-size: 20rpx;
  color: var(--text-color-light);
  margin-left: 8rpx;
}

/* 加载状态 */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: var(--text-color-light);
  font-size: 28rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 统计卡片区域 */
.stats-section {
  margin: 20rpx 24rpx;
  background: var(--white);
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.stats-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 24rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  min-width: 140rpx;
  background: linear-gradient(135deg, #e6f7ff, #bae7ff);
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary-color);
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-color-secondary);
  margin-top: 8rpx;
}

/* 各科目统计 */
.subject-stats {
  margin-top: 24rpx;
  border-top: 1rpx solid var(--border-color);
  padding-top: 20rpx;
}

.subject-stat-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--background-color);
}

.subject-stat-item:last-child {
  border-bottom: none;
}

.subject-stat-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-color);
}

.subject-stat-detail {
  font-size: 24rpx;
  color: var(--text-color-secondary);
}

/* 趋势图 */
.trend-chart {
  margin: 20rpx 24rpx;
  background: var(--white);
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.chart-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 24rpx;
}

.chart-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 300rpx;
  padding: 0 10rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.chart-bar-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  max-width: 100rpx;
  position: relative;
}

.chart-bar {
  width: 48rpx;
  border-radius: 8rpx 8rpx 0 0;
  min-height: 8rpx;
  transition: height 0.5s ease;
}

.chart-bar-label {
  font-size: 20rpx;
  color: var(--text-color-light);
  margin-top: 8rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 80rpx;
}

.chart-bar-score {
  font-size: 22rpx;
  color: var(--text-color);
  font-weight: 600;
  margin-bottom: 8rpx;
}

/* 个人成绩列表 */
.my-grade-list {
  margin: 20rpx 24rpx;
}

.grade-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--white);
  border-radius: 16rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.grade-card-left {
  flex: 1;
}

.grade-subject {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 8rpx;
}

.grade-meta {
  font-size: 24rpx;
  color: var(--text-color-light);
}

.grade-card-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.grade-score {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-color);
}

.grade-pass-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-top: 8rpx;
}

.grade-pass-tag.pass {
  color: var(--success-color);
  background: #f6ffed;
}

.grade-pass-tag.fail {
  color: var(--error-color);
  background: #fff2f0;
}

/* 不及格分数红色 */
.text-fail {
  color: var(--error-color) !important;
}

/* 操作栏 */
.action-bar {
  padding: 20rpx 24rpx;
}

.import-btn {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-color));
  color: var(--white);
  text-align: center;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.3);
}

.import-btn:active {
  opacity: 0.85;
}

/* 成绩表格 */
.grade-table {
  margin: 0 24rpx;
  background: var(--white);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.table-header {
  display: flex;
  background: var(--background-color);
  padding: 20rpx 16rpx;
  font-size: 24rpx;
  color: var(--text-color-secondary);
  font-weight: 600;
}

.table-row {
  display: flex;
  padding: 24rpx 16rpx;
  font-size: 26rpx;
  color: var(--text-color);
  border-bottom: 1rpx solid var(--background-color);
  align-items: center;
}

.table-row:active {
  background: var(--background-color);
}

.table-row:last-child {
  border-bottom: none;
}

.th, .td {
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.th-rank, .td-rank {
  width: 80rpx;
  flex-shrink: 0;
}

.th-name, .td-name {
  width: 100rpx;
  flex-shrink: 0;
  text-align: left;
}

.th-total, .td-total {
  width: 80rpx;
  flex-shrink: 0;
  font-weight: 600;
}

.th-subject, .td-subject {
  flex: 1;
  min-width: 70rpx;
}

.td-rank.top-rank {
  color: var(--warning-color);
  font-weight: 700;
}

.td-total {
  color: var(--primary-color);
}

/* 空状态 */
.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: var(--text-color-light);
}

/* ===== 批量导入弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 640rpx;
  background: var(--white);
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-color);
  text-align: center;
  margin-bottom: 32rpx;
}

.import-field {
  margin-bottom: 24rpx;
}

.import-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color);
  display: block;
  margin-bottom: 12rpx;
}

.import-hint {
  font-size: 22rpx;
  color: var(--text-color-light);
  display: block;
  margin-bottom: 12rpx;
}

.import-picker {
  background: var(--background-color);
  padding: 18rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text-color);
  border: 2rpx solid var(--border-color);
}

.import-textarea {
  width: 100%;
  min-height: 240rpx;
  background: var(--background-color);
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: var(--text-color);
  border: 2rpx solid var(--border-color);
  box-sizing: border-box;
  line-height: 1.6;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.cancel-btn {
  background: var(--background-color);
  color: var(--text-color-secondary);
}

.cancel-btn:active {
  background: var(--border-color);
}

.confirm-btn {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-color));
  color: var(--white);
}

.confirm-btn:active {
  opacity: 0.85;
}

.confirm-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* 科目管理按钮 */
.subject-manage-btn {
  background: var(--white);
  color: var(--text-color-secondary);
  text-align: center;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: 2rpx solid var(--border-color);
}

/* 科目管理弹窗 */
.subject-modal-content {
  max-height: 80vh;
  overflow-y: auto;
}

.subject-section {
  margin-bottom: 24rpx;
}

.subject-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-color-secondary);
  margin-bottom: 16rpx;
}

.subject-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.subject-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--background-color);
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.subject-name {
  color: var(--text-color);
}

.subject-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.default-tag {
  color: var(--primary-color);
  background: #e6f7ff;
}

.subject-remove-btn {
  font-size: 22rpx;
  color: var(--error-color);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #fff2f0;
}

.subject-add-row {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
}

.subject-add-input {
  flex: 1;
  background: var(--background-color);
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: 2rpx solid var(--border-color);
}

.subject-add-btn {
  background: var(--primary-color);
  color: var(--white);
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* 导入弹窗增强 */
.import-modal-content {
  max-height: 85vh;
  overflow-y: auto;
}

.import-tabs {
  display: flex;
  gap: 0;
  margin-bottom: 28rpx;
  background: var(--background-color);
  border-radius: 12rpx;
  overflow: hidden;
}

.import-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: var(--text-color-secondary);
  position: relative;
  transition: all 0.3s;
}

.import-tab.active {
  color: var(--primary-color);
  background: var(--white);
  font-weight: 600;
}

.import-tab.tab-locked {
  opacity: 0.5;
}

.pro-tag {
  display: inline-block;
  font-size: 18rpx;
  color: var(--warning-color);
  background: #fff7e6;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  margin-left: 6rpx;
  font-weight: 700;
  vertical-align: middle;
}

/* 科目输入框+下拉建议 */
.subject-input-wrap {
  position: relative;
}

.subject-input {
  width: 100%;
  background: var(--background-color);
  padding: 18rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text-color);
  border: 2rpx solid var(--border-color);
  box-sizing: border-box;
}

.subject-suggestions {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: var(--white);
  border-radius: 0 0 12rpx 12rpx;
  border: 2rpx solid var(--border-color);
  border-top: none;
  max-height: 300rpx;
  overflow-y: auto;
  z-index: 10;
}

.suggestion-item {
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-color);
  border-bottom: 1rpx solid var(--background-color);
}

.suggestion-item:last-child {
  border-bottom: none;
}

/* Excel导入 */
.excel-upload-area {
  margin: 20rpx 0;
}

.excel-upload-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--background-color);
  border: 4rpx dashed var(--border-color);
  border-radius: 16rpx;
  padding: 60rpx 40rpx;
}

.excel-upload-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.excel-upload-text {
  font-size: 30rpx;
  color: var(--primary-color);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.excel-upload-hint {
  font-size: 22rpx;
  color: var(--text-color-light);
}

.excel-file-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #e6f7ff;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.excel-file-name {
  font-size: 26rpx;
  color: var(--text-color);
  font-weight: 500;
}

.excel-file-size {
  font-size: 22rpx;
  color: var(--text-color-secondary);
}

.excel-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 60rpx 0;
  color: var(--text-color-light);
  font-size: 28rpx;
}

.loading-spinner.small {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 0;
}

/* 预览表格 */
.excel-preview {
  margin: 20rpx 0;
}

.excel-preview-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 16rpx;
}

.preview-table {
  background: var(--white);
  border-radius: 12rpx;
  overflow: hidden;
  border: 2rpx solid var(--border-color);
}

.preview-header {
  display: flex;
  background: var(--background-color);
  padding: 16rpx 12rpx;
}

.preview-th {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-color-secondary);
  font-weight: 600;
}

.preview-row {
  display: flex;
  padding: 16rpx 12rpx;
  border-bottom: 1rpx solid var(--background-color);
  font-size: 24rpx;
}

.preview-row:last-child {
  border-bottom: none;
}

.preview-row.row-invalid {
  background: #fff2f0;
}

.preview-td {
  flex: 1;
  text-align: center;
  color: var(--text-color);
}

.status-valid {
  color: var(--success-color);
  font-weight: 600;
}

.status-invalid {
  color: var(--error-color);
  font-weight: 600;
}
