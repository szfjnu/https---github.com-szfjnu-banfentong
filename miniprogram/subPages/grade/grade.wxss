/* 成绩管理中心 */

.grade-container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 40rpx;
}

/* 考试类型 Tab */
.exam-tabs {
  display: flex;
  background: #ffffff;
  padding: 20rpx 24rpx;
  gap: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666666;
  background: #f0f2f5;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.tab-item.active {
  color: #ffffff;
  background: linear-gradient(135deg, #1890ff, #096dd9);
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.4);
}

/* 筛选行 */
.filter-row {
  display: flex;
  padding: 20rpx 24rpx;
  gap: 20rpx;
  background: #ffffff;
  margin-bottom: 20rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  padding: 14rpx 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.picker-label {
  color: #999999;
  margin-right: 8rpx;
}

.picker-value {
  color: #333333;
  font-weight: 500;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999999;
  margin-left: 8rpx;
}

/* 加载状态 */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #999999;
  font-size: 28rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e8e8e8;
  border-top-color: #1890ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 统计卡片区域 */
.stats-section {
  margin: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.stats-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  min-width: 140rpx;
  background: linear-gradient(135deg, #e6f7ff, #bae7ff);
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #1890ff;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: #666666;
  margin-top: 8rpx;
}

/* 各科目统计 */
.subject-stats {
  margin-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.subject-stat-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.subject-stat-item:last-child {
  border-bottom: none;
}

.subject-stat-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

.subject-stat-detail {
  font-size: 24rpx;
  color: #666666;
}

/* 趋势图 */
.trend-chart {
  margin: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.chart-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

.chart-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 300rpx;
  padding: 0 10rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.chart-bar-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  max-width: 100rpx;
  position: relative;
}

.chart-bar {
  width: 48rpx;
  border-radius: 8rpx 8rpx 0 0;
  min-height: 8rpx;
  transition: height 0.5s ease;
}

.chart-bar-label {
  font-size: 20rpx;
  color: #999999;
  margin-top: 8rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 80rpx;
}

.chart-bar-score {
  font-size: 22rpx;
  color: #333333;
  font-weight: 600;
  margin-bottom: 8rpx;
}

/* 个人成绩列表 */
.my-grade-list {
  margin: 20rpx 24rpx;
}

.grade-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.grade-card-left {
  flex: 1;
}

.grade-subject {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.grade-meta {
  font-size: 24rpx;
  color: #999999;
}

.grade-card-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.grade-score {
  font-size: 44rpx;
  font-weight: 700;
  color: #333333;
}

.grade-pass-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-top: 8rpx;
}

.grade-pass-tag.pass {
  color: #52c41a;
  background: #f6ffed;
}

.grade-pass-tag.fail {
  color: #ff4d4f;
  background: #fff2f0;
}

/* 不及格分数红色 */
.text-fail {
  color: #ff4d4f !important;
}

/* 操作栏 */
.action-bar {
  padding: 20rpx 24rpx;
}

.import-btn {
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #ffffff;
  text-align: center;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.3);
}

.import-btn:active {
  opacity: 0.85;
}

/* 成绩表格 */
.grade-table {
  margin: 0 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.table-header {
  display: flex;
  background: #f5f7fa;
  padding: 20rpx 16rpx;
  font-size: 24rpx;
  color: #666666;
  font-weight: 600;
}

.table-row {
  display: flex;
  padding: 24rpx 16rpx;
  font-size: 26rpx;
  color: #333333;
  border-bottom: 1rpx solid #f5f5f5;
  align-items: center;
}

.table-row:active {
  background: #f9f9f9;
}

.table-row:last-child {
  border-bottom: none;
}

.th, .td {
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.th-rank, .td-rank {
  width: 80rpx;
  flex-shrink: 0;
}

.th-name, .td-name {
  width: 100rpx;
  flex-shrink: 0;
  text-align: left;
}

.th-total, .td-total {
  width: 80rpx;
  flex-shrink: 0;
  font-weight: 600;
}

.th-subject, .td-subject {
  flex: 1;
  min-width: 70rpx;
}

.td-rank.top-rank {
  color: #faad14;
  font-weight: 700;
}

.td-total {
  color: #1890ff;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: #999999;
}

/* ===== 批量导入弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 640rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333333;
  text-align: center;
  margin-bottom: 32rpx;
}

.import-field {
  margin-bottom: 24rpx;
}

.import-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 12rpx;
}

.import-hint {
  font-size: 22rpx;
  color: #999999;
  display: block;
  margin-bottom: 12rpx;
}

.import-picker {
  background: #f5f7fa;
  padding: 18rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333333;
  border: 2rpx solid #e8e8e8;
}

.import-textarea {
  width: 100%;
  min-height: 240rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #333333;
  border: 2rpx solid #e8e8e8;
  box-sizing: border-box;
  line-height: 1.6;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.cancel-btn {
  background: #f5f7fa;
  color: #666666;
}

.cancel-btn:active {
  background: #e8e8e8;
}

.confirm-btn {
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #ffffff;
}

.confirm-btn:active {
  opacity: 0.85;
}

.confirm-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}
