/* pages/discipline/revoke-apply/revoke-apply.wxss */
.container { padding: 20rpx; min-height: 100vh; background: #f5f5f5; padding-bottom: 40rpx; }

.info-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }
.info-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.level-badge { padding: 8rpx 20rpx; border-radius: 8rpx; font-size: 28rpx; font-weight: bold; }
.status-tag { padding: 6rpx 14rpx; border-radius: 6rpx; font-size: 22rpx; }
.status-tag.active { background: #fff1f0; color: #ff4d4f; }
.status-tag.revoked { background: #f6ffed; color: #52c41a; }
.info-row { display: flex; padding: 8rpx 0; }
.info-label { font-size: 26rpx; color: #999; width: 160rpx; flex-shrink: 0; }
.info-value { font-size: 26rpx; color: #333; flex: 1; }
.info-value.danger { color: #ff4d4f; font-weight: bold; }

.progress-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }
.card-title { font-size: 30rpx; font-weight: bold; color: #333; margin-bottom: 16rpx; }
.progress-item { margin-bottom: 16rpx; }
.progress-item:last-child { margin-bottom: 0; }
.progress-header { display: flex; justify-content: space-between; margin-bottom: 8rpx; }
.progress-label { font-size: 26rpx; color: #666; }
.progress-num { font-size: 26rpx; color: #333; font-weight: bold; }
.progress-bar { height: 16rpx; background: #e8e8e8; border-radius: 8rpx; overflow: hidden; }
.progress-fill { height: 100%; background: #1890ff; border-radius: 8rpx; }
.progress-fill.service { background: #52c41a; }

.action-section { display: flex; gap: 12rpx; margin-bottom: 20rpx; }
.action-btn { flex: 1; padding: 20rpx; border-radius: 12rpx; text-align: center; font-size: 26rpx; font-weight: bold; }
.action-btn.primary { background: #1890ff; color: #fff; }
.action-btn.green { background: #52c41a; color: #fff; }
.action-btn.warn { background: #faad14; color: #fff; }

.section-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }
.section-title { font-size: 28rpx; font-weight: bold; color: #333; margin-bottom: 12rpx; padding-bottom: 12rpx; border-bottom: 1rpx solid #f0f0f0; }

.report-item, .service-item, .revoke-item { padding: 12rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.report-item:last-child, .service-item:last-child, .revoke-item:last-child { border-bottom: none; }
.report-header, .service-header, .revoke-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 4rpx; }
.report-title { font-size: 26rpx; color: #333; flex: 1; }
.report-status, .service-status, .revoke-status { font-size: 22rpx; padding: 2rpx 10rpx; border-radius: 4rpx; }
.report-status.pending, .service-status.pending { background: #fff7e6; color: #faad14; }
.report-status.approved, .service-status.approved { background: #f6ffed; color: #52c41a; }
.report-status.rejected, .service-status.rejected { background: #fff1f0; color: #ff4d4f; }
.revoke-status { background: #fff7e6; color: #faad14; }
.revoke-status.approved { background: #f6ffed; color: #52c41a; }
.revoke-status.rejected { background: #fff1f0; color: #ff4d4f; }
.report-month, .service-date, .revoke-date { font-size: 24rpx; color: #999; }
.service-type { font-size: 26rpx; color: #333; flex: 1; }
.service-hours { font-size: 26rpx; color: #1890ff; font-weight: bold; }
.revoke-reason { font-size: 26rpx; color: #333; display: block; margin-top: 4rpx; }
.revoke-comment { font-size: 24rpx; color: #faad14; display: block; margin-top: 4rpx; }

.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 100; display: flex; align-items: center; justify-content: center; }
.modal-content { width: 90%; max-height: 80vh; background: #fff; border-radius: 20rpx; overflow: hidden; }
.modal-header { display: flex; align-items: center; justify-content: space-between; padding: 30rpx; border-bottom: 1rpx solid #f0f0f0; }
.modal-title { font-size: 32rpx; font-weight: bold; }
.modal-close { font-size: 36rpx; color: #999; padding: 0 10rpx; }
.modal-body { padding: 30rpx; max-height: 60vh; overflow-y: auto; }
.modal-footer { display: flex; border-top: 1rpx solid #f0f0f0; }
.btn-cancel, .btn-confirm { flex: 1; text-align: center; padding: 28rpx 0; font-size: 30rpx; }
.btn-cancel { color: #999; }
.btn-confirm { color: #1890ff; font-weight: bold; }

.form-group { margin-bottom: 24rpx; }
.form-label { font-size: 28rpx; color: #333; margin-bottom: 8rpx; display: block; }
.form-input { border: 1rpx solid #e8e8e8; border-radius: 8rpx; padding: 16rpx 20rpx; font-size: 28rpx; }
.form-textarea { border: 1rpx solid #e8e8e8; border-radius: 8rpx; padding: 16rpx 20rpx; font-size: 28rpx; width: 100%; min-height: 160rpx; box-sizing: border-box; }
.form-picker { border: 1rpx solid #e8e8e8; border-radius: 8rpx; padding: 16rpx 20rpx; font-size: 28rpx; }

.loading-state { text-align: center; padding-top: 120rpx; color: #999; }
