/* pages/discipline/record/record.wxss */
.container { padding: 20rpx; min-height: 100vh; background: #f5f5f5; }

.stats-card { background: #fff; border-radius: 16rpx; padding: 30rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }
.stats-row { display: flex; align-items: center; justify-content: space-around; }
.stat-item { display: flex; flex-direction: column; align-items: center; }
.stat-value { font-size: 40rpx; font-weight: bold; color: #333; }
.stat-value.danger { color: #ff4d4f; }
.stat-value.success { color: #52c41a; }
.stat-label { font-size: 24rpx; color: #999; margin-top: 4rpx; }
.stat-divider { width: 1rpx; height: 60rpx; background: #e8e8e8; }

.action-bar { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.action-btn { flex: 1; padding: 20rpx; border-radius: 12rpx; text-align: center; font-size: 28rpx; font-weight: bold; }
.action-btn.primary { background: #1890ff; color: #fff; }
.action-btn.outline { background: #fff; color: #1890ff; border: 1rpx solid #1890ff; }

.filter-tabs { display: flex; background: #fff; border-radius: 12rpx; padding: 8rpx; margin-bottom: 20rpx; }
.filter-tab { flex: 1; text-align: center; padding: 14rpx 0; border-radius: 8rpx; font-size: 26rpx; color: #666; }
.filter-tab.active { background: #1890ff; color: #fff; font-weight: bold; }

.record-list { padding-bottom: 40rpx; }
.record-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }
.record-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.student-info { display: flex; align-items: center; gap: 12rpx; }
.student-name { font-size: 30rpx; font-weight: bold; color: #333; }
.level-tag { padding: 4rpx 14rpx; border-radius: 6rpx; font-size: 22rpx; }
.status-tag { padding: 4rpx 14rpx; border-radius: 6rpx; font-size: 22rpx; }
.status-tag.active { background: #fff1f0; color: #ff4d4f; }
.status-tag.revoked { background: #f6ffed; color: #52c41a; }

.record-body { margin-bottom: 12rpx; }
.record-reason { font-size: 26rpx; color: #666; }

.record-footer { display: flex; align-items: center; gap: 12rpx; }
.record-date { font-size: 24rpx; color: #999; }
.record-meta { flex: 1; display: flex; align-items: center; gap: 8rpx; }
.meta-score { font-size: 24rpx; color: #ff4d4f; font-weight: bold; }
.meta-divider { color: #e8e8e8; }
.meta-period { font-size: 24rpx; color: #999; }
.record-actions { display: flex; gap: 12rpx; }
.del-btn { font-size: 24rpx; color: #ff4d4f; padding: 4rpx 16rpx; }

.empty-state { display: flex; flex-direction: column; align-items: center; padding-top: 120rpx; }
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: #999; }

.loading-state { text-align: center; padding-top: 120rpx; color: #999; }
