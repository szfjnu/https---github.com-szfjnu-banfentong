/* pages/discipline/record/record.wxss */
.container { padding: 20rpx; min-height: 100vh; background: var(--background-color); }

.stats-card { background: var(--white); border-radius: 16rpx; padding: 30rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }
.stats-row { display: flex; align-items: center; justify-content: space-around; }
.stat-item { display: flex; flex-direction: column; align-items: center; }
.stat-value { font-size: 40rpx; font-weight: bold; color: var(--text-color); }
.stat-value.danger { color: var(--error-color); }
.stat-value.success { color: var(--success-color); }
.stat-label { font-size: 24rpx; color: var(--text-color-light); margin-top: 4rpx; }
.stat-divider { width: 1rpx; height: 60rpx; background: var(--border-color); }

.action-bar { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.action-btn { flex: 1; padding: 20rpx; border-radius: 12rpx; text-align: center; font-size: 28rpx; font-weight: bold; }
.action-btn.primary { background: var(--primary-color); color: var(--white); }
.action-btn.outline { background: var(--white); color: var(--primary-color); border: 1rpx solid var(--primary-color); }

.filter-tabs { display: flex; background: var(--white); border-radius: 12rpx; padding: 8rpx; margin-bottom: 20rpx; }
.filter-tab { flex: 1; text-align: center; padding: 14rpx 0; border-radius: 8rpx; font-size: 26rpx; color: var(--text-color-secondary); }
.filter-tab.active { background: var(--primary-color); color: var(--white); font-weight: bold; }

.record-list { padding-bottom: 40rpx; }
.record-card { background: var(--white); border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }
.record-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.student-info { display: flex; align-items: center; gap: 12rpx; }
.student-name { font-size: 30rpx; font-weight: bold; color: var(--text-color); }
.level-tag { padding: 4rpx 14rpx; border-radius: 6rpx; font-size: 22rpx; }
.status-tag { padding: 4rpx 14rpx; border-radius: 6rpx; font-size: 22rpx; }
.status-tag.active { background: #fff1f0; color: var(--error-color); }
.status-tag.revoked { background: #f6ffed; color: var(--success-color); }

.record-body { margin-bottom: 12rpx; }
.record-reason { font-size: 26rpx; color: var(--text-color-secondary); }

.record-footer { display: flex; align-items: center; gap: 12rpx; }
.record-date { font-size: 24rpx; color: var(--text-color-light); }
.record-meta { flex: 1; display: flex; align-items: center; gap: 8rpx; }
.meta-score { font-size: 24rpx; color: var(--error-color); font-weight: bold; }
.meta-divider { color: var(--border-color); }
.meta-period { font-size: 24rpx; color: var(--text-color-light); }
.record-actions { display: flex; gap: 12rpx; }
.del-btn { font-size: 24rpx; color: var(--error-color); padding: 4rpx 16rpx; }

.empty-state { display: flex; flex-direction: column; align-items: center; padding-top: 120rpx; }
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: var(--text-color-light); }

.loading-state { text-align: center; padding-top: 120rpx; color: var(--text-color-light); }
