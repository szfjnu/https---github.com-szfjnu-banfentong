/* pages/usercenter/settings/settings.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.tab-bar {
  display: flex;
  background: #fff;
  padding: 0 10rpx;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #1890ff;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #1890ff;
  border-radius: 2rpx;
}

.tab-content {
  padding: 20rpx 24rpx;
}

.form-section {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item.static {
  background: #fafafa;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  width: 140rpx;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #666;
}

.form-right {
  display: flex;
  align-items: center;
}

.avatar-preview {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.form-value {
  font-size: 28rpx;
  color: #999;
}

.arrow {
  font-size: 32rpx;
  color: #ccc;
  margin-left: 8rpx;
}

.save-btn {
  background: #1890ff;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 20rpx;
}

.save-btn::after {
  border: none;
}

.setting-section {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.section-hint {
  padding: 20rpx 28rpx;
  font-size: 24rpx;
  color: #999;
  background: #fafafa;
}

.notification-list {
  padding: 0;
}

.notification-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.notification-item:last-child {
  border-bottom: none;
}

.ntf-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.ntf-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.ntf-label {
  font-size: 28rpx;
  color: #333;
}

.ntf-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.switch-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.switch-label {
  font-size: 22rpx;
  color: #999;
}

.privacy-list {
  padding: 0;
}

.privacy-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.privacy-item:last-child {
  border-bottom: none;
}

.privacy-label {
  font-size: 28rpx;
  color: #333;
}

.display-list {
  padding: 0;
}

.display-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}

.display-label {
  font-size: 28rpx;
  color: #333;
}

.font-size-options {
  display: flex;
  gap: 16rpx;
}

.font-option {
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  border: 1rpx solid #e8e8e8;
}

.font-option.active {
  background: #e6f7ff;
  color: #1890ff;
  border-color: #1890ff;
}
