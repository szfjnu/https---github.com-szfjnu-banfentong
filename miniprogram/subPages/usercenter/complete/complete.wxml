<view class="container">
  <view class="loading-mask" wx:if="{{loading}}">
    <view class="loading-text">加载中...</view>
  </view>

  <block wx:if="{{!loading}}">
    <view class="tip-bar" wx:if="{{incompleteCount > 0}}">
      <text class="tip-icon">!</text>
      <text class="tip-text">还有 {{incompleteCount}} 项信息未填写，请尽快补全</text>
    </view>
    <view class="tip-bar tip-ok" wx:else>
      <text class="tip-icon">✓</text>
      <text class="tip-text">信息已全部填写</text>
    </view>

    <view class="form-section">
      <view class="section-label">基本信息</view>

      <view class="form-item">
        <text class="form-label">姓名</text>
        <text class="form-value readonly">{{studentName || '未设置'}}</text>
      </view>

      <view class="form-item">
        <text class="form-label">入学日期</text>
        <picker mode="date" value="{{enrollment_date}}" bindchange="onEnrollmentDateChange">
          <view class="picker-value {{enrollment_date ? '' : 'placeholder'}}">
            {{enrollment_date || '请选择入学日期'}}
          </view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">出生日期</text>
        <picker mode="date" value="{{date_of_birth}}" bindchange="onDateOfBirthChange">
          <view class="picker-value {{date_of_birth ? '' : 'placeholder'}}">
            {{date_of_birth || '请选择出生日期'}}
          </view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">政治面貌</text>
        <picker range="{{politicalOptions}}" value="{{politicalOptions.indexOf(political_status)}}" bindchange="onPoliticalConfirm">
          <view class="picker-value {{political_status ? '' : 'placeholder'}}">
            {{political_status || '请选择政治面貌'}}
          </view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">民族</text>
        <picker range="{{ethnicityOptions}}" value="{{ethnicityOptions.indexOf(ethnicity)}}" bindchange="onEthnicityConfirm">
          <view class="picker-value {{ethnicity ? '' : 'placeholder'}}">
            {{ethnicity || '请选择民族'}}
          </view>
        </picker>
      </view>
    </view>

    <view class="form-section">
      <view class="section-label">联系方式</view>

      <view class="form-item">
        <text class="form-label">手机号</text>
        <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone_number}}" bindinput="onPhoneNumberInput" />
      </view>

      <view class="form-item">
        <text class="form-label">家长手机</text>
        <input class="form-input" type="number" maxlength="11" placeholder="请输入家长手机号" value="{{parent_phone_number}}" bindinput="onParentPhoneInput" />
      </view>

      <view class="form-item form-item-textarea">
        <text class="form-label">家庭住址</text>
        <textarea class="form-textarea" placeholder="请输入家庭住址" value="{{home_address}}" bindinput="onHomeAddressInput" maxlength="200" />
      </view>
    </view>

    <view class="form-section">
      <view class="section-label">住宿信息</view>

      <view class="form-item">
        <text class="form-label">是否住宿</text>
        <switch checked="{{is_boarding}}" bindchange="onBoardingChange" color="#1890ff" />
      </view>

      <block wx:if="{{is_boarding}}">
        <view class="form-item">
          <text class="form-label">楼栋</text>
          <input class="form-input" placeholder="请输入楼栋" value="{{dorm_building}}" bindinput="onDormBuildingInput" />
        </view>

        <view class="form-item">
          <text class="form-label">房间号</text>
          <input class="form-input" placeholder="请输入房间号" value="{{dorm_room}}" bindinput="onDormRoomInput" />
        </view>

        <view class="form-item">
          <text class="form-label">床位号</text>
          <input class="form-input" placeholder="请输入床位号" value="{{dorm_bed}}" bindinput="onDormBedInput" />
        </view>
      </block>
    </view>

    <view class="btn-section">
      <button class="save-btn" bindtap="onSave">保存信息</button>
    </view>
  </block>
</view>
