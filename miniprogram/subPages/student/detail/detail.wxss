/* pages/student/detail/detail.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 学生信息卡片 */
.info-card {
  background: white;
  margin: 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #f0f5ff 0%, #e6f7ff 100%);
}

.student-basic {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #ddd;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.basic-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.meta {
  display: flex;
  gap: 20rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #666;
}

.score-badge {
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  color: white;
  font-size: 24rpx;
  font-weight: 500;
}

.card-body {
  padding: 30rpx;
}

.info-group {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.info-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.label {
  width: 180rpx;
  font-size: 28rpx;
  color: #666;
}

.value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.score-value {
  font-size: 36rpx;
  font-weight: bold;
}

.dorm-info {
  background: #f9f9f9;
  padding: 20rpx;
  border-radius: 12rpx;
}

.card-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.edit-btn {
  flex: 1;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: white;
  border-radius: 40rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  border: none;
}

.edit-btn::after {
  border: none;
}

.delete-btn {
  flex: 1;
  background: #fff;
  color: #ff4d4f;
  border-radius: 40rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  border: 1rpx solid #ffccc7;
}

.delete-btn::after {
  border: none;
}

/* 标签页容器 */
.tabs-container {
  margin: 20rpx;
}

.tabs {
  display: flex;
  background: white;
  border-radius: 16rpx 16rpx 0 0;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  background: white;
  border-bottom: 4rpx solid transparent;
  transition: all 0.3s;
}

.tab-item.active {
  color: #1890ff;
  border-bottom-color: #1890ff;
  font-weight: 500;
}

.tab-content {
  background: white;
  border-radius: 0 0 16rpx 16rpx;
  padding: 30rpx;
  min-height: 400rpx;
}

/* 联系方式 */
.contact-info {
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
}

/* 记录列表 */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-item {
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 24rpx;
  transition: all 0.3s;
}

.record-item:active {
  transform: scale(0.98);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.record-date {
  font-size: 24rpx;
  color: #999;
}

.score-change {
  font-size: 32rpx;
  font-weight: bold;
}

.score-add {
  color: #52c41a;
}

.score-minus {
  color: #ff4d4f;
}

.service-type,
.discipline-level {
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  background: white;
}

.record-body {
  margin-bottom: 16rpx;
}

.record-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.record-reason,
.record-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.record-doc {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.record-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #e8e8e8;
}

.record-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.record-operator {
  font-size: 22rpx;
  color: #999;
}

.record-source,
.record-status,
.record-duration,
.record-score,
.record-deduction,
.record-revoked {
  font-size: 24rpx;
  color: #999;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx 0;
}

.loading-icon {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #1890ff;
  border-radius: 50%;
  margin: 0 auto 20rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.loading {
  text-align: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: #999;
}

/* 空状态容器 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx 0;
}

.empty-container .empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-container .empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 响应式布局 */
@media screen and (max-width: 375px) {
  .name {
    font-size: 32rpx;
  }

  .avatar {
    width: 80rpx;
    height: 80rpx;
  }

  .label {
    width: 150rpx;
    font-size: 26rpx;
  }

  .value {
    font-size: 26rpx;
  }
}

/* 考勤统计 */
.attendance-stats-card,
.attendance-records-card,
.dorm-score-card {
  background: white;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 20rpx;
}

.stats-grid .stat-item {
  flex: 1;
  min-width: 140rpx;
  text-align: center;
  padding: 20rpx 0;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.stats-grid .stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.stats-grid .stat-label {
  display: block;
  font-size: 22rpx;
  color: #999;
}

.attendance-type {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  background: white;
}

/* 住宿积分 */
.dorm-score-overview {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 20rpx 0;
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  color: white;
}

.dorm-score-main {
  display: flex;
  align-items: baseline;
}

.dorm-score-value {
  font-size: 60rpx;
  font-weight: bold;
}

.dorm-score-unit {
  font-size: 28rpx;
  margin-left: 8rpx;
}

.dorm-score-detail {
  display: flex;
  gap: 24rpx;
}

.dorm-stat {
  font-size: 26rpx;
  font-weight: 500;
}

.dorm-stat.add {
  color: #95de64;
}

.dorm-stat.minus {
  color: #ff7875;
}

.dorm-records {
  margin-top: 20rpx;
}

.dorm-record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.dorm-record-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.dorm-record-reason {
  font-size: 28rpx;
  color: #333;
}

.dorm-record-date {
  font-size: 24rpx;
  color: #999;
}

.dorm-record-score {
  font-size: 32rpx;
  font-weight: bold;
}

.dorm-record-score.score-add {
  color: #52c41a;
}

.dorm-record-score.score-minus {
  color: #ff4d4f;
}
