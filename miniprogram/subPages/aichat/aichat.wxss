/* 微聊陪伴 */

.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, #f0f4ff 0%, var(--background-color) 100%);
}

/* 加载状态 */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  color: var(--text-color-light);
  font-size: 28rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* NPC 切换栏 */
.npc-bar {
  position: relative;
  z-index: 10;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  padding: 16rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f5;
}

.npc-current {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.npc-icon {
  font-size: 36rpx;
}

.npc-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color);
}

.npc-arrow {
  font-size: 20rpx;
  color: var(--text-color-light);
  transition: transform 0.3s;
}

.npc-arrow.up {
  transform: rotate(180deg);
}

/* NPC 下拉选择 */
.npc-dropdown {
  position: relative;
  z-index: 20;
}

.npc-dropdown-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
}

.npc-dropdown-list {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  background: var(--white);
  padding: 16rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  border-radius: 0 0 20rpx 20rpx;
}

.npc-option {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: 16rpx;
  transition: background 0.2s;
}

.npc-option:active {
  background: var(--background-color);
}

.npc-option.active {
  background: #f0edff;
}

.npc-option-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.npc-option-info {
  flex: 1;
}

.npc-option-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color);
  display: block;
}

.npc-option-desc {
  font-size: 22rpx;
  color: var(--text-color-light);
  display: block;
  margin-top: 4rpx;
}

.npc-option-check {
  font-size: 28rpx;
  color: #667eea;
  font-weight: bold;
}

/* 聊天列表 */
.chat-list {
  flex: 1;
  padding: 20rpx 24rpx;
  padding-bottom: 20rpx;
  overflow-y: auto;
}

/* 空状态 */
.empty-chat {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-color-light);
  margin-bottom: 40rpx;
}

.empty-hint {
  font-size: 28rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.08);
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
}

/* 消息项 */
.message-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
  animation: fadeInUp 0.3s ease;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.message-item.user {
  flex-direction: row-reverse;
}

/* 头像 */
.message-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: var(--white);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  flex-shrink: 0;
}

.user-avatar {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: var(--white);
  font-size: 24rpx;
  font-weight: 600;
}

/* 消息气泡 */
.message-bubble {
  max-width: 70%;
  padding: 22rpx 28rpx;
  border-radius: 24rpx;
  margin: 0 16rpx;
  position: relative;
  word-break: break-all;
}

.user-bubble {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: var(--white);
  border-top-right-radius: 8rpx;
}

.ai-bubble {
  background: var(--white);
  color: var(--text-color);
  border-top-left-radius: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.message-text {
  font-size: 28rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

/* 打字指示器 */
.typing-indicator {
  display: flex;
  gap: 8rpx;
  padding: 8rpx 0;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--text-color-light);
  animation: typingBounce 1.4s infinite;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typingBounce {
  0%, 60%, 100% {
    transform: translateY(0);
    background: var(--text-color-light);
  }
  30% {
    transform: translateY(-8rpx);
    background: #667eea;
  }
}

/* 底部锚点 */
.chat-bottom {
  height: 20rpx;
}

/* 底部输入栏 */
.input-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(10px);
  border-top: 1rpx solid #f0f0f5;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.input-wrap {
  flex: 1;
  min-width: 0;
}

.chat-input {
  width: 100%;
  height: 76rpx;
  background: var(--background-color);
  border-radius: 38rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: var(--text-color);
  box-sizing: border-box;
}

.send-btn {
  padding: 16rpx 28rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: var(--white);
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
  transition: opacity 0.2s;
}

.send-btn:active {
  opacity: 0.85;
}

.send-btn.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.clear-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border-radius: 50%;
  background: var(--background-color);
}

.clear-btn:active {
  background: var(--border-color);
}
