/* pages/join/confirm/confirm.wxss */
.container {
  min-height: 100vh;
  background: var(--background-color);
  padding-bottom: 200rpx;
}

/* 表单区域 */
.form-section {
  background: var(--white);
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 24rpx;
}

/* 学生信息卡片 */
.student-info-card {
  background: var(--background-color);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: var(--text-color-light);
}

.info-value {
  font-size: 28rpx;
  color: var(--text-color);
  font-weight: 500;
}

/* 表单卡片 */
.form-card {
  background: var(--background-color);
  border-radius: 12rpx;
  padding: 20rpx;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-item.required .form-label::before {
  content: '*';
  color: var(--error-color);
  margin-right: 8rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-color);
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: var(--white);
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--text-color);
  box-sizing: border-box;
}

.picker-value {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
  background: var(--white);
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--text-color);
}

.arrow {
  color: var(--text-color-light);
  font-size: 20rpx;
}

/* 关系选择 */
.relation-section {
  margin-top: 24rpx;
}

.relation-label {
  font-size: 28rpx;
  color: var(--text-color);
  margin-bottom: 16rpx;
}

.relation-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.relation-item {
  padding: 16rpx 32rpx;
  background: var(--background-color);
  border-radius: 8rpx;
  font-size: 28rpx;
  color: var(--text-color-secondary);
  border: 2rpx solid transparent;
}

.relation-item.active {
  background: #e6f7ff;
  color: var(--primary-color);
  border-color: var(--primary-color);
}

/* 隐私协议 */
.agreement-section {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  padding: 20rpx 30rpx;
}

.agreement-text {
  font-size: 26rpx;
  color: var(--text-color-secondary);
  margin-left: 8rpx;
}

.agreement-link {
  font-size: 26rpx;
  color: var(--primary-color);
}

/* 操作按钮 */
.action-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--white);
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.btn-confirm {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color) 100%);
  color: var(--white);
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
}

.btn-confirm[disabled] {
  background: var(--border-color);
  color: var(--text-color-light);
}

.btn-confirm::after {
  border: none;
}

/* 加载状态 */
.loading {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading-icon {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--background-color);
  border-top: 4rpx solid var(--primary-color);
  border-radius: 50%;
  margin-bottom: 20rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-color-light);
}
