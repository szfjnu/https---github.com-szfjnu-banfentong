/* pages/volunteer/detail/detail.wxss */
.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.status-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  gap: 15rpx;
}

.status-header.pending {
  background: linear-gradient(135deg, #fa8c16 0%, #faad14 100%);
}

.status-header.pending-head {
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
}

.status-header.approved {
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
}

.status-header.rejected {
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%);
}

.status-icon {
  font-size: 40rpx;
}

.status-text {
  font-size: 32rpx;
  font-weight: bold;
  color: white;
}

.detail-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.detail-label {
  font-size: 26rpx;
  color: #999;
}

.detail-value {
  font-size: 26rpx;
  color: #333;
}

.type-tag {
  font-weight: 600;
}

.score-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.score-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #52c41a;
}

.score-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.description-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.proof-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
}

.loading-icon {
  font-size: 60rpx;
  display: block;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}
