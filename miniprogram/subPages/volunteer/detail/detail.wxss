/* pages/volunteer/detail/detail.wxss */
.container {
  padding: 20rpx;
  background: var(--background-color);
  min-height: 100vh;
}

.status-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  gap: 15rpx;
}

.status-header.pending {
  background: linear-gradient(135deg, var(--warning-color) 0%, var(--warning-color) 100%);
}

.status-header.pending-head {
  background: linear-gradient(135deg, var(--primary-color) 0%, #40a9ff 100%);
}

.status-header.approved {
  background: linear-gradient(135deg, var(--success-color) 0%, var(--success-color) 100%);
}

.status-header.rejected {
  background: linear-gradient(135deg, var(--error-color) 0%, var(--error-color) 100%);
}

.status-icon {
  font-size: 40rpx;
}

.status-text {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--white);
}

.detail-card {
  background: var(--white);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.detail-label {
  font-size: 26rpx;
  color: var(--text-color-light);
}

.detail-value {
  font-size: 26rpx;
  color: var(--text-color);
}

.type-tag {
  font-weight: 600;
}

.score-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.score-value {
  font-size: 56rpx;
  font-weight: bold;
  color: var(--success-color);
}

.score-label {
  font-size: 24rpx;
  color: var(--text-color-light);
  margin-top: 10rpx;
}

.description-text {
  font-size: 26rpx;
  color: var(--text-color-secondary);
  line-height: 1.8;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.proof-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
}

.loading-icon {
  font-size: 60rpx;
  display: block;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-color-light);
}
