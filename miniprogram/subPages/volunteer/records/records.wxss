/* pages/volunteer/records/records.wxss */
.container {
  padding: 20rpx;
  background: var(--background-color);
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.page-header {
  margin-bottom: 20rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-color);
}

.filter-section {
  margin-bottom: 20rpx;
}

.filter-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--white);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  font-size: 28rpx;
  color: var(--text-color);
}

.picker-arrow {
  font-size: 24rpx;
  color: var(--text-color-light);
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-card {
  background: var(--white);
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.activity-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
  flex: 1;
  margin-right: 20rpx;
}

.status-tag {
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  white-space: nowrap;
}

.status-tag.pending {
  background: #fff7e6;
  color: var(--warning-color);
  border: 1rpx solid #ffd591;
}

.status-tag.pending-head {
  background: #e6f7ff;
  color: var(--primary-color);
  border: 1rpx solid #91d5ff;
}

.status-tag.approved {
  background: #f6ffed;
  color: var(--success-color);
  border: 1rpx solid #b7eb8f;
}

.status-tag.rejected {
  background: #fff2f0;
  color: var(--error-color);
  border: 1rpx solid var(--error-color);
}

.card-body {
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 15rpx;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: var(--text-color-secondary);
}

.info-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.score-badge {
  background: linear-gradient(135deg, var(--success-color) 0%, var(--success-color) 100%);
  color: var(--white);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.description {
  font-size: 26rpx;
  color: var(--text-color-secondary);
  line-height: 1.6;
  margin-top: 15rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid var(--border-color);
}

/* 审核进度 */
.approval-progress {
  display: flex;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-color);
}

.progress-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  flex: 0 0 auto;
}

.step-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--border-color);
  margin-bottom: 8rpx;
}

.progress-step.current .step-dot {
  background: var(--primary-color);
  box-shadow: 0 0 0 6rpx rgba(24, 144, 255, 0.2);
}

.progress-step.done .step-dot {
  background: var(--success-color);
}

.progress-step.rejected .step-dot {
  background: var(--error-color);
}

.step-text {
  font-size: 20rpx;
  color: var(--text-color-light);
}

.progress-step.current .step-text {
  color: var(--primary-color);
  font-weight: 600;
}

.progress-step.done .step-text {
  color: var(--success-color);
}

.progress-step.rejected .step-text {
  color: var(--error-color);
}

.progress-line {
  flex: 1;
  height: 4rpx;
  background: var(--border-color);
  margin: 0 8rpx;
  margin-bottom: 28rpx;
}

.progress-line.done {
  background: var(--success-color);
}

.empty-state {
  text-align: center;
  padding: 150rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 32rpx;
  color: var(--text-color-light);
  margin-bottom: 15rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-color-light);
}

.loading {
  text-align: center;
  padding: 100rpx 0;
}

.loading-icon {
  font-size: 60rpx;
  display: block;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-color-light);
}

.fab-button {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(24, 144, 255, 0.4);
  z-index: 100;
}

.fab-icon {
  font-size: 48rpx;
  color: var(--white);
  font-weight: 300;
}
