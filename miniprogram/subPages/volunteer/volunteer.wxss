/* pages/volunteer/volunteer.wxss */
.container {
  padding: 20rpx;
  background: var(--background-color);
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 统计卡片 */
.stats-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.stats-title {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
}

.rule-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
}

.rule-icon {
  font-size: 24rpx;
}

.rule-text {
  font-size: 22rpx;
  color: var(--white);
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--white);
  margin-bottom: 10rpx;
  line-height: 1.2;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 新增：积分规则提示 */
.rule-tip {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.tip-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 我的记录入口 */
.my-records-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
}

.entry-text {
  font-size: 26rpx;
  color: var(--white);
}

.entry-arrow {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 新增：搜索区域 */
.search-section {
  margin-bottom: 20rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: var(--white);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-color);
}

/* 新增：筛选区域 */
.filter-section {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.filter-picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--white);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  font-size: 28rpx;
  color: var(--text-color);
}

.picker-arrow {
  font-size: 24rpx;
  color: var(--text-color-light);
}

/* 新增：学生信息显示 */
.student-info {
  margin-top: 12rpx;
}

/* 新增：加载更多 */
.load-more, .no-more {
  text-align: center;
  padding: 30rpx;
  font-size: 26rpx;
  color: var(--text-color-light);
}

/* 新增：弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 600rpx;
  background: var(--white);
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
}

.modal-close {
  font-size: 32rpx;
  color: var(--text-color-light);
  padding: 8rpx;
}

.modal-body {
  padding: 32rpx;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid var(--border-color);
}

.cancel-btn, .confirm-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cancel-btn {
  background: var(--background-color);
  color: var(--text-color-secondary);
}

.confirm-btn {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-color));
  color: var(--white);
}

/* 日期选择器弹窗 */
.date-picker-modal .date-item {
  margin-bottom: 24rpx;
}

.date-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-color);
  margin-bottom: 12rpx;
}

.date-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--background-color);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-color);
}

/* 积分规则弹窗 */
.rule-modal .rule-item {
  margin-bottom: 24rpx;
}

.rule-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-color);
  margin-bottom: 12rpx;
}

.rule-input-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.rule-input {
  flex: 1;
  height: 80rpx;
  background: var(--background-color);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  text-align: center;
}

.rule-unit {
  font-size: 28rpx;
  color: var(--text-color-secondary);
}

.rule-examples {
  background: #f0f5ff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.examples-title {
  display: block;
  font-size: 26rpx;
  color: var(--primary-color);
  margin-bottom: 12rpx;
}

.example-item {
  display: block;
  font-size: 26rpx;
  color: var(--text-color-secondary);
  margin-bottom: 8rpx;
}

.rule-note {
  display: flex;
  gap: 12rpx;
  background: #fffbe6;
  border: 1rpx solid #ffe58f;
  border-radius: 12rpx;
  padding: 16rpx;
}

.note-icon {
  font-size: 28rpx;
}

.note-text {
  flex: 1;
  font-size: 24rpx;
  color: #d48806;
  line-height: 1.6;
}

/* 信息图标使用emoji */
.info-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

/* 筛选和搜索 */
.filter-section {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--white);
  border-radius: 12rpx;
  padding: 20rpx 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 20rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-color);
}

.filter-picker {
  display: flex;
  align-items: center;
  background: var(--white);
  border-radius: 12rpx;
  padding: 20rpx 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  font-size: 28rpx;
  color: var(--text-color);
  gap: 10rpx;
}

.picker-arrow {
  font-size: 32rpx;
  color: var(--text-color-light);
  font-weight: bold;
}

/* 志愿服务列表 */
.volunteer-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.volunteer-card {
  background: var(--white);
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.volunteer-card:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.1);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.activity-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
  flex: 1;
  margin-right: 20rpx;
}

.service-type-tag {
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  color: var(--white);
  white-space: nowrap;
}

.card-body {
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 15rpx;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: var(--text-color-secondary);
}

.info-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.6;
}

.score-badge {
  background: linear-gradient(135deg, var(--success-color) 0%, var(--success-color) 100%);
  color: var(--white);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.description {
  font-size: 26rpx;
  color: var(--text-color-secondary);
  line-height: 1.6;
  margin-top: 15rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid var(--border-color);
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-color);
}

.recorder-info {
  font-size: 24rpx;
  color: var(--text-color-light);
}

.verify-status {
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
}

.verify-status.verified {
  background: #f6ffed;
  color: var(--success-color);
  border: 1rpx solid #b7eb8f;
}

.verify-status.pending {
  background: #fff7e6;
  color: var(--warning-color);
  border: 1rpx solid #ffd591;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 150rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 30rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 32rpx;
  color: var(--text-color-light);
  margin-bottom: 15rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-color-light);
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 100rpx 0;
}

.loading-icon {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--background-color);
  border-top: 4rpx solid var(--primary-color);
  border-radius: 50%;
  margin: 0 auto 20rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-color-light);
}

/* 添加按钮 */
.fab-button {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(24, 144, 255, 0.4);
  transition: all 0.3s ease;
  z-index: 100;
}

.fab-button:active {
  transform: scale(0.9);
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.5);
}

.fab-icon {
  width: 50rpx;
  height: 50rpx;
}
