/* 心灵树洞 */

.treehole-container {
  min-height: 100vh;
  background: #f0f4f8;
  padding-bottom: 120rpx;
}

/* 顶部标语 */
.treehole-banner {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 24rpx 36rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #ffffff;
}

.banner-emoji {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.banner-text {
  font-size: 28rpx;
  opacity: 0.9;
  letter-spacing: 2rpx;
}

/* 加载状态 */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #999999;
  font-size: 28rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e8e8e8;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 帖子列表 */
.post-list {
  padding: 20rpx 24rpx;
}

.post-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  position: relative;
}

.post-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.mood-tag {
  background: #f0f2f5;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666666;
}

.post-time {
  font-size: 22rpx;
  color: #999999;
}

.post-content {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.7;
  margin-bottom: 16rpx;
  word-break: break-all;
}

.post-author {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

/* 底部操作栏 */
.post-footer {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.post-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  color: #999999;
}

.action-icon {
  font-size: 32rpx;
}

.action-icon.hearted {
  animation: heartBeat 0.4s ease;
}

@keyframes heartBeat {
  0% { transform: scale(1); }
  50% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

.action-count {
  font-size: 24rpx;
  color: #999999;
}

.admin-action {
  margin-left: auto;
}

/* 举报标记 */
.reported-badge {
  margin-top: 16rpx;
  padding: 12rpx 20rpx;
  background: #fff7e6;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #fa8c16;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: 28rpx;
  color: #667eea;
}

.no-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: 26rpx;
  color: #cccccc;
}

/* 空状态 */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  font-size: 28rpx;
  color: #999999;
}

.empty-emoji {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

/* 发帖按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 108rpx;
  height: 108rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  font-size: 44rpx;
  z-index: 100;
}

.fab-btn:active {
  transform: scale(0.92);
}

/* ===== 发帖弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-content {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.1);
  max-height: 85vh;
  overflow-y: auto;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333333;
  text-align: center;
  margin-bottom: 32rpx;
}

/* 心情选择器 */
.mood-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.mood-option {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  background: #f5f7fa;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #666666;
  border: 2rpx solid transparent;
}

.mood-option.active {
  background: #f0edff;
  color: #667eea;
  border-color: #667eea;
}

.mood-emoji {
  font-size: 30rpx;
}

.mood-text {
  font-size: 24rpx;
}

/* 内容输入 */
.publish-textarea {
  width: 100%;
  min-height: 240rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #333333;
  box-sizing: border-box;
  line-height: 1.7;
  border: 2rpx solid #e8e8e8;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #cccccc;
  margin-top: 8rpx;
}

/* 匿名开关 */
.anonymous-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  margin-bottom: 8rpx;
}

.anonymous-label {
  font-size: 28rpx;
  color: #333333;
}

/* 操作按钮 */
.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.cancel-btn {
  background: #f5f7fa;
  color: #666666;
}

.cancel-btn:active {
  background: #e8e8e8;
}

.confirm-btn {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #ffffff;
}

.confirm-btn:active {
  opacity: 0.85;
}

.confirm-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* ===== 举报弹窗 ===== */
.report-hint {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 20rpx;
}

.report-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.report-option {
  padding: 14rpx 24rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666666;
  border: 2rpx solid transparent;
}

.report-option.active {
  background: #fff2f0;
  color: #ff4d4f;
  border-color: #ff4d4f;
}

.report-textarea {
  width: 100%;
  min-height: 120rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #333333;
  box-sizing: border-box;
  line-height: 1.6;
  border: 2rpx solid #e8e8e8;
}

/* ===== 管理员操作 ===== */
.admin-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.admin-action-btn {
  padding: 24rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333333;
  text-align: center;
}

.admin-action-btn:active {
  background: #e8e8e8;
}

.admin-action-btn.danger {
  color: #ff4d4f;
  background: #fff2f0;
}

.admin-action-btn.danger:active {
  background: #ffccc7;
}
