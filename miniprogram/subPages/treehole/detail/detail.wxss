/* 树洞帖子详情 */

.detail-container {
  min-height: 100vh;
  background: #f0f4f8;
  padding-bottom: 140rpx;
}

/* 加载状态 */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #999999;
  font-size: 28rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e8e8e8;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 帖子内容区域 */
.post-section {
  background: #ffffff;
  padding: 32rpx 30rpx;
  margin-bottom: 20rpx;
}

.post-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.mood-tag {
  background: #f0edff;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #667eea;
}

.post-time {
  font-size: 22rpx;
  color: #999999;
}

.post-content {
  font-size: 32rpx;
  color: #333333;
  line-height: 1.8;
  margin-bottom: 20rpx;
  word-break: break-all;
}

.post-author {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 20rpx;
}

.post-stats {
  display: flex;
  gap: 40rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stat-icon {
  font-size: 34rpx;
}

.stat-icon.hearted {
  animation: heartBeat 0.4s ease;
}

@keyframes heartBeat {
  0% { transform: scale(1); }
  50% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

.stat-text {
  font-size: 26rpx;
  color: #666666;
}

/* 回复列表区域 */
.replies-section {
  background: #ffffff;
  padding: 24rpx 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

.reply-list {
  padding-bottom: 20rpx;
}

.reply-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.reply-item:last-child {
  border-bottom: none;
}

.reply-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.reply-author {
  font-size: 26rpx;
  color: #666666;
}

.teacher-badge {
  color: #667eea;
  font-weight: 600;
}

.reply-time {
  font-size: 22rpx;
  color: #cccccc;
}

.reply-content {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  font-size: 28rpx;
  color: #999999;
}

/* 底部回复栏 */
.reply-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #f0f0f0;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.reply-input-wrap {
  flex: 1;
  min-width: 0;
}

.reply-input {
  width: 100%;
  height: 72rpx;
  background: #f5f7fa;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.reply-anonymous {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.anon-label {
  font-size: 22rpx;
  color: #999999;
}

.reply-send-btn {
  padding: 14rpx 28rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #ffffff;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
}

.reply-send-btn:active {
  opacity: 0.85;
}

.reply-send-btn.disabled {
  opacity: 0.4;
  pointer-events: none;
}
