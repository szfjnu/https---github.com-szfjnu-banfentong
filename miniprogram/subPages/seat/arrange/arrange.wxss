.arrange-page {
  padding: 20rpx 30rpx;
  min-height: 100vh;
  background: #f5f7fa;
}

.loading-wrap, .no-layout {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

.mode-tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
}

.mode-tab.active {
  color: #667eea;
  border-bottom-color: #667eea;
  font-weight: bold;
}

.action-area {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.group-info {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.group-info .warn {
  color: #ff4d4f;
}

.action-btn {
  display: inline-block;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.action-btn.primary {
  background: #667eea;
  color: #fff;
}

.action-btn.disabled {
  opacity: 0.5;
}

.manual-area {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.manual-hint {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.grid-section {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
}
