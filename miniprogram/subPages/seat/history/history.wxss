.history-page {
  padding: 20rpx 30rpx;
  min-height: 100vh;
  background: var(--background-color);
}

.loading-wrap {
  text-align: center;
  padding: 100rpx 0;
  color: var(--text-color-light);
}

.history-list {
  background: var(--white);
  border-radius: 12rpx;
  overflow: hidden;
}

.history-item {
  padding: 24rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.history-type {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 8rpx;
}

.history-info {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.history-operator {
  font-size: 24rpx;
  color: #667eea;
}

.history-remark {
  font-size: 24rpx;
  color: var(--text-color-secondary);
}

.history-time {
  font-size: 22rpx;
  color: var(--text-color-light);
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  font-size: 28rpx;
  color: var(--text-color-light);
}

.load-more {
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #667eea;
}

.detail-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-panel {
  width: 90%;
  max-height: 80vh;
  background: var(--white);
  border-radius: 12rpx;
  padding: 24rpx;
  overflow-y: auto;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.detail-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
}

.detail-close {
  font-size: 36rpx;
  color: var(--text-color-light);
  padding: 8rpx;
}

.detail-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--text-color-secondary);
  margin-bottom: 20rpx;
}

.detail-subtitle {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 12rpx;
}

.detail-snapshot {
  border-top: 1rpx solid var(--border-color);
  padding-top: 16rpx;
}
