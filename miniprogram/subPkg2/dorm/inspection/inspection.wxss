.container {
  min-height: 100vh;
  background: var(--background-color);
  padding-bottom: 100rpx;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: var(--white);
  border-bottom: 1rpx solid var(--border-color);
}

.filter-item {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--background-color);
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.arrow {
  font-size: 20rpx;
  color: var(--text-color-light);
}

/* 记录列表 */
.record-list {
  padding: 20rpx;
}

.record-item {
  background: var(--white);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.record-type-tag {
  background: #e8f4ff;
  color: var(--primary-color);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.record-score {
  font-size: 36rpx;
  font-weight: bold;
}

.record-score.pass {
  color: var(--success-color);
}

.record-score.fail {
  color: var(--error-color);
}

.record-body {
  margin-bottom: 16rpx;
}

.record-location {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 12rpx;
}

.record-students {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-color);
  margin-bottom: 12rpx;
}

.icon {
  margin-right: 10rpx;
  font-size: 32rpx;
}

.record-info {
  display: flex;
  gap: 30rpx;
  font-size: 26rpx;
  color: var(--text-color-light);
}

.record-problems {
  background: #fff7e6;
  padding: 16rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.problem-count {
  font-size: 26rpx;
  color: var(--warning-color);
}

.record-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-color);
}

.record-status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.record-status.pending {
  background: #fff7e6;
  color: var(--warning-color);
}

.record-status.processed {
  background: #e6f7ff;
  color: var(--primary-color);
}

.record-status.archived {
  background: var(--background-color);
  color: var(--text-color-light);
}

.record-arrow {
  font-size: 24rpx;
  color: var(--text-color-light);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-color-light);
  margin-bottom: 30rpx;
}

.empty-btn {
  background: var(--primary-color);
  color: var(--white);
  border: none;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

/* 加载更多 */
.load-more, .no-more {
  text-align: center;
  padding: 30rpx;
  font-size: 28rpx;
  color: var(--primary-color);
}

.no-more {
  color: var(--text-color-light);
}

/* 浮动按钮 */
.fab {
  position: fixed;
  right: 30rpx;
  bottom: 100rpx;
  width: 100rpx;
  height: 100rpx;
  background: var(--primary-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(24, 144, 255, 0.3);
  font-size: 48rpx;
  color: var(--white);
  z-index: 100;
}

.fab:active {
  transform: scale(0.9);
}
