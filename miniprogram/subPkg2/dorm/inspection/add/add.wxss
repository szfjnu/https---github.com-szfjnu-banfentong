.container {
  min-height: 100vh;
  background: var(--background-color);
  padding-bottom: 120rpx;
}

.form-section {
  background: var(--white);
  margin-bottom: 20rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.add-problem-btn {
  background: #e8f4ff;
  color: var(--primary-color);
  border: none;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-color);
  margin-bottom: 12rpx;
}

.form-label.required::before {
  content: '*';
  color: var(--error-color);
  margin-right: 8rpx;
}

.form-input, .form-textarea, .form-picker {
  width: 100%;
  padding: 20rpx;
  background: var(--background-color);
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  height: 150rpx;
}

.form-textarea.large {
  height: 200rpx;
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.arrow {
  font-size: 20rpx;
  color: var(--text-color-light);
}

/* 评分 */
.score-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.score-label {
  flex: 0 0 160rpx;
  font-size: 28rpx;
  color: var(--text-color);
}

.score-input {
  flex: 1;
  min-width: 0;
  padding: 20rpx;
  background: var(--background-color);
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
}

.score-unit {
  flex: 0 0 60rpx;
  font-size: 28rpx;
  color: var(--text-color-light);
  text-align: right;
}

/* 问题列表 */
.problem-item {
  background: var(--background-color);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.problem-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.problem-index {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--primary-color);
}

.problem-delete {
  font-size: 24rpx;
  color: var(--error-color);
  padding: 8rpx 16rpx;
}

.select-student-btn {
  width: 100%;
  padding: 20rpx;
  background: #e8f4ff;
  color: var(--primary-color);
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.empty-tip {
  text-align: center;
  padding: 40rpx;
  font-size: 28rpx;
  color: var(--text-color-light);
}

/* 图片上传 */
.image-upload {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.image-delete {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background: var(--error-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--white);
  font-size: 24rpx;
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  background: var(--background-color);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--border-color);
}

.upload-icon {
  font-size: 60rpx;
  color: var(--text-color-light);
  margin-bottom: 10rpx;
}

.upload-text {
  font-size: 24rpx;
  color: var(--text-color-light);
}

/* 提交按钮 */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: var(--white);
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.submit-btn {
  width: 100%;
  padding: 30rpx;
  background: var(--primary-color);
  color: var(--white);
  border: none;
  border-radius: 12rpx;
  font-size: 32rpx;
}
