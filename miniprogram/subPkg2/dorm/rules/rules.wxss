.container {
  min-height: 100vh;
  background: var(--background-color);
}

/* 筛选器 */
.filter-bar {
  display: flex;
  gap: 15rpx;
  padding: 20rpx;
  background: var(--white);
}

.filter-picker {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--background-color);
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text-color);
  min-width: 0;
}

.filter-picker text:first-child {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow {
  font-size: 20rpx;
  color: var(--text-color-light);
}

/* 标签 */
.tabs {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: var(--white);
  border-bottom: 1rpx solid var(--border-color);
}

.tabs-left {
  display: flex;
  gap: 0;
  flex: 1;
  min-width: 0;
}

.tab-item {
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-color-light);
  position: relative;
  white-space: nowrap;
  min-width: 140rpx;
  text-align: center;
}

.tab-item.active {
  color: var(--primary-color);
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 24rpx;
  right: 24rpx;
  height: 4rpx;
  background: var(--primary-color);
  border-radius: 2rpx;
}

.init-rules-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  background: #f6ffed;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #52c41a;
}

.init-rules-btn .icon {
  font-size: 28rpx;
}

.add-btn {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color) 100%);
  color: var(--white);
  border: none;
  padding: 16rpx 28rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  line-height: 1;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
  margin-left: 20rpx;
  min-width: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-btn::after {
  border: none;
}

/* 规则列表 */
.rules-list {
  padding: 20rpx;
}

.rule-item {
  background: var(--white);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.rule-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.rule-category-tag {
  background: #f0f5ff;
  color: var(--primary-color);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.rule-score {
  font-size: 32rpx;
  font-weight: bold;
}

.rule-score.add {
  color: var(--success-color);
}

.rule-score.deduct {
  color: var(--error-color);
}

.rule-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 12rpx;
}

.rule-desc {
  font-size: 26rpx;
  color: var(--text-color-light);
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.rule-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.rule-severity {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.severity-label {
  color: var(--text-color-light);
}

.severity-value {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: var(--background-color);
}

.severity-value.minor {
  background: #e6f7ff;
  color: var(--primary-color);
}

.severity-value.general {
  background: #fff7e6;
  color: var(--warning-color);
}

.severity-value.serious {
  background: #fff1f0;
  color: var(--error-color);
}

.severity-value.critical {
  background: var(--error-color);
  color: var(--white);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-color-light);
  margin-bottom: 30rpx;
}

.empty-btn {
  background: var(--primary-color);
  color: var(--white);
  border: none;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

/* 加载更多 */
.load-more, .no-more {
  text-align: center;
  padding: 30rpx;
  font-size: 28rpx;
  color: var(--primary-color);
}

.no-more {
  color: var(--text-color-light);
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-height: 80vh;
  background: var(--white);
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
}

.modal-close {
  font-size: 36rpx;
  color: var(--text-color-light);
  padding: 10rpx;
}

.modal-body {
  max-height: 60vh;
  overflow-y: auto;
  padding: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-color);
  margin-bottom: 12rpx;
}

.form-input, .form-textarea, .form-picker {
  width: 100%;
  padding: 20rpx;
  background: var(--background-color);
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  height: 150rpx;
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.form-item.inline {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  border-top: 1rpx solid var(--border-color);
}

.btn-cancel, .btn-confirm {
  flex: 1;
  min-width: 0;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
}

.btn-cancel {
  background: var(--background-color);
  color: var(--text-color-secondary);
}

.btn-confirm {
  background: var(--primary-color);
  color: var(--white);
}
