page {
  --bg-color: #f5f7fa;
  --white: #ffffff;
  --text-main: #333333;
  --text-light: #999999;
  --text-second: #666666;
  --border-color: #eeeeee;
  --primary: #1890ff;
  --success: #52c41a;
  --danger: #f5222d;
  --warn: #faad14;
}

.container {
  min-height: 100vh;
  background: var(--bg-color);
  padding: 10rpx;
  box-sizing: border-box;
}

.filter-bar {
  display: flex;
  gap: 20rpx;
  padding: 16rpx 20rpx;
  background: var(--white);
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  align-items: center;
}

.filter-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 200rpx;
  height: 60rpx;
  padding: 0 16rpx;
  background: var(--bg-color);
  border-radius: 6rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.filter-picker text:first-child {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow {
  font-size: 20rpx;
  color: var(--text-light);
}

/* Tabs 栏：左右分离，按钮不被挤压 */
.tabs {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--white);
  padding: 0 20rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  height: 88rpx;
  box-sizing: border-box;
}

.tabs-left {
  display: flex;
  gap: 24rpx;
  /* 关键修改：
     由 flex: 0 0 60% 改为 flex: 1
     让左侧自动填充剩余空间，而不是强制占用60%，防止右侧按钮被挤出屏幕
  */
  flex: 1;
  min-width: 0;
  margin-right: 10rpx; /* 给右侧留一点呼吸空间 */
}

.tab-item {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
  border-bottom: 4rpx solid transparent;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}

.tab-item.active {
  color: var(--primary);
  border-bottom-color: var(--primary);
  font-weight: bold;
}

.tabs-right {
  display: flex;
  align-items: center;
  /* 关键修改：禁止右侧区域被压缩 */
  flex-shrink: 0;
}

.tabs-actions {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.init-rules-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 60rpx;
  padding: 0 16rpx;
  background: #f6ffed;
  border-radius: 6rpx;
  font-size: 24rpx; /* 稍微缩小字体以适应更多机型 */
  color: var(--success);
  white-space: nowrap;
}

.add-btn {
  height: 60rpx;
  padding: 0 24rpx;
  background: var(--primary);
  border-radius: 6rpx;
  border: none;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;

  /* 关键修改：
     1. 移除 color: var(--success)，因为它会让文字变绿（在蓝底上看不清）
     2. 显式设置 color: #fff 确保文字为白色
  */
  color: #ffffff;
}

/* 移除 button 组件默认的边框和样式 */
.add-btn::after {
  border: none;
}

.rules-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rule-item {
  background: var(--white);
  padding: 20rpx;
  border-radius: 8rpx;
}

.rule-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.rule-category-tag {
  background: #e8f4ff;
  color: var(--primary);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
}

.rule-score {
  font-size: 32rpx;
  font-weight: bold;
}

.rule-score.add {
  color: var(--success);
}

.rule-score.deduct {
  color: var(--danger);
}

.rule-name {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.rule-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.rule-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.rule-severity {
  font-size: 26rpx;
  color: #666;
}

.severity-value {
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.severity-value.light {
  background: #f0f9ff;
  color: var(--primary);
}

.severity-value.normal {
  background: #fffbe6;
  color: var(--warn);
}

.severity-value.serious {
  background: #fff1f0;
  color: var(--danger);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: #999;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-btn {
  margin-top: 24rpx;
  background: var(--primary);
  color: #fff;
  border: none;
  border-radius: 6rpx;
  padding: 12rpx 32rpx;
  font-size: 26rpx;
}

.load-more,
.no-more {
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #999;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  width: 85%;
  max-width: 600rpx;
  background: var(--white);
  border-radius: 12rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-close {
  font-size: 32rpx;
  color: #999;
}

.modal-body {
  padding: 20rpx;
  max-height: 70vh;
  overflow-y: auto;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.form-input,
.form-textarea {
  width: 100%;
  padding: 16rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 6rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  min-height: 120rpx;
}

.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
  padding: 0 16rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 6rpx;
  font-size: 28rpx;
}

.form-item.inline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #eee;
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border: none;
  font-size: 28rpx;
}

.btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.btn-confirm {
  background: var(--primary);
  color: #fff;
}