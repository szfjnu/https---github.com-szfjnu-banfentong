.container {
  padding: 20rpx;
  background: var(--background-color, #f5f5f5);
  min-height: 100vh;
}

.form-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.form-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-color, #333);
  margin-bottom: 24rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  width: 120rpx;
  font-size: 28rpx;
  color: var(--text-color, #333);
  flex-shrink: 0;
}

.picker-value {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #666;
}

.arrow {
  font-size: 20rpx;
  color: #999;
}

.locked-value {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.lock-tag {
  font-size: 22rpx;
  color: #fff;
  background: #1890ff;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.score-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.remark-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  min-height: 80rpx;
}

.submit-btn {
  margin-top: 40rpx;
  background: var(--primary-color, #1890ff);
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.submit-btn[disabled] {
  background: #b0c4de;
  color: #fff;
}
