.container {
  padding: 20rpx;
  background: var(--background-color, #f5f5f5);
  min-height: 100vh;
}

.selector-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.selector-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.selector-picker {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #f7f8fa;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333;
}

.arrow {
  font-size: 18rpx;
  color: #999;
}

.chart-type-bar {
  display: flex;
  gap: 12rpx;
}

.type-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 24rpx;
  color: #666;
  background: #f7f8fa;
  border-radius: 8rpx;
}

.type-item.active {
  color: #fff;
  background: var(--primary-color, #1890ff);
}

.chart-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  min-height: 500rpx;
  position: relative;
}

ec-canvas {
  width: 100%;
  height: 500rpx;
}

.loading, .no-data {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 500rpx;
  font-size: 28rpx;
  color: #999;
}

.fallback-list {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.fallback-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}

.fb-date {
  color: #666;
}

.fb-score {
  color: var(--primary-color, #1890ff);
  font-weight: bold;
}
