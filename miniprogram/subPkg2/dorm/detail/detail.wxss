.container {
  min-height: 100vh;
  background: var(--background-color);
  padding-bottom: 120rpx;
}

/* 学生卡片 */
.student-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 40rpx;
  color: var(--white);
}

.student-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.student-avatar {
  width: 100rpx;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 30rpx;
}

.student-info {
  display: flex;
  flex-direction: column;
}

.student-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.student-class {
  font-size: 26rpx;
  opacity: 0.8;
}

.student-dorm {
  display: flex;
  gap: 40rpx;
}

.dorm-item {
  display: flex;
  align-items: center;
}

.dorm-label {
  font-size: 26rpx;
  opacity: 0.8;
  margin-right: 10rpx;
}

.dorm-value {
  font-size: 28rpx;
  font-weight: bold;
}

/* 积分卡片 */
.score-card {
  background: var(--white);
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 40rpx;
}

.score-main {
  text-align: center;
  margin-bottom: 30rpx;
}

.score-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-color-light);
  margin-bottom: 20rpx;
}

.score-value {
  font-size: 80rpx;
  font-weight: bold;
}

.score-value.good {
  color: var(--success-color);
}

.score-value.warning {
  color: var(--error-color);
}

.score-details {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding-top: 30rpx;
  border-top: 1rpx solid var(--border-color);
}

.score-detail-item {
  text-align: center;
}

.detail-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-color-light);
  margin-bottom: 10rpx;
}

.detail-value {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
}

.score-divider {
  width: 1rpx;
  height: 60rpx;
  background: var(--border-color);
}

/* 区块 */
.section {
  background: var(--white);
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
}

.section-filter {
  font-size: 26rpx;
  color: var(--primary-color);
}

/* 记录列表 */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: var(--background-color);
  border-radius: 12rpx;
}

.record-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.record-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.record-icon.add {
  background: #e6f7ff;
  color: var(--success-color);
}

.record-icon.deduct {
  background: #fff1f0;
  color: var(--error-color);
}

.record-info {
  display: flex;
  flex-direction: column;
}

.record-reason {
  font-size: 28rpx;
  color: var(--text-color);
  margin-bottom: 8rpx;
}

.record-date {
  font-size: 24rpx;
  color: var(--text-color-light);
}

.record-right {
  text-align: right;
}

.record-after {
  font-size: 26rpx;
  color: var(--text-color-light);
}

.empty-tip {
  text-align: center;
  padding: 60rpx;
  font-size: 28rpx;
  color: var(--text-color-light);
}

.load-more {
  text-align: center;
  padding: 30rpx;
  font-size: 28rpx;
  color: var(--primary-color);
}

/* 操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  background: var(--white);
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.action-btn {
  flex: 1;
  min-width: 0;
  padding: 30rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
}

.action-btn.primary {
  background: var(--primary-color);
  color: var(--white);
}

.action-btn.secondary {
  background: var(--background-color);
  color: var(--text-color);
}
