.ds-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.ds-empty__icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
  position: relative;
}

.ds-empty__text {
  font-size: 28rpx;
  color: var(--text-color-light, #999999);
  text-align: center;
  line-height: 1.5;
}

.ds-empty__svg {
  width: 100%;
  height: 100%;
  position: relative;
}

.ds-empty__svg--empty .ds-empty__box {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 100rpx;
  height: 70rpx;
  border: 6rpx solid var(--text-color-light, #d9d9d9);
  border-top: none;
  border-radius: 0 0 8rpx 8rpx;
}

.ds-empty__svg--empty .ds-empty__box-open {
  position: absolute;
  bottom: 80rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 110rpx;
  height: 16rpx;
  border: 6rpx solid var(--text-color-light, #d9d9d9);
  border-bottom: none;
  border-radius: 8rpx 8rpx 0 0;
}

.ds-empty__svg--search .ds-empty__circle {
  position: absolute;
  top: 40rpx;
  left: 40rpx;
  width: 80rpx;
  height: 80rpx;
  border: 8rpx solid var(--text-color-light, #d9d9d9);
  border-radius: 50%;
}

.ds-empty__svg--search .ds-empty__handle {
  position: absolute;
  top: 120rpx;
  left: 128rpx;
  width: 8rpx;
  height: 40rpx;
  background: var(--text-color-light, #d9d9d9);
  border-radius: 4rpx;
  transform: rotate(-45deg);
}

.ds-empty__svg--error .ds-empty__circle-x {
  position: absolute;
  top: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 100rpx;
  height: 100rpx;
  border: 8rpx solid var(--danger-color, #ff4d4f);
  border-radius: 50%;
}

.ds-empty__svg--error .ds-empty__x-line {
  position: absolute;
  top: 62rpx;
  left: 50%;
  width: 50rpx;
  height: 6rpx;
  background: var(--danger-color, #ff4d4f);
  border-radius: 3rpx;
}

.ds-empty__svg--error .ds-empty__x-line--1 {
  transform: translateX(-50%) rotate(45deg);
}

.ds-empty__svg--error .ds-empty__x-line--2 {
  transform: translateX(-50%) rotate(-45deg);
}

.ds-empty__svg--network .ds-empty__wifi-1 {
  position: absolute;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 40rpx;
  border: 6rpx solid var(--text-color-light, #d9d9d9);
  border-bottom: none;
  border-left: none;
  border-radius: 0 60rpx 0 0;
}

.ds-empty__svg--network .ds-empty__wifi-2 {
  position: absolute;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 70rpx;
  height: 70rpx;
  border: 6rpx solid var(--text-color-light, #d9d9d9);
  border-bottom: none;
  border-left: none;
  border-radius: 0 80rpx 0 0;
}

.ds-empty__svg--network .ds-empty__wifi-3 {
  position: absolute;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 100rpx;
  height: 100rpx;
  border: 6rpx solid var(--text-color-light, #d9d9d9);
  border-bottom: none;
  border-left: none;
  border-radius: 0 100rpx 0 0;
}

.ds-empty__svg--network .ds-empty__wifi-dot {
  position: absolute;
  bottom: 50rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 12rpx;
  height: 12rpx;
  background: var(--danger-color, #ff4d4f);
  border-radius: 50%;
}
